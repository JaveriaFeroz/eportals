@model ProcureToPay.Areas.Master.ViewModels.ShipperCreateEditViewModel
@{
    ViewData["Title"] = "Create Shipper";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-plus me-2"></i> Create New Shipper
            </h5>
        </div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post" action="@Url.Action("Create", "Shipper", new { area = "Master" })">
                @Html.AntiForgeryToken()

                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h6 class="m-0 font-weight-bold" style="color: #092963;">
                                <i class="fas fa-info-circle me-2"></i> Shipper Information
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Shipper.ShipperName" class="form-label">Shipper Name <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-user-tie"></i></span>
                                        <input asp-for="Shipper.ShipperName" class="form-control" placeholder="Enter Shipper name" />
                                    </div>
                                    <span asp-validation-for="Shipper.ShipperName" class="text-danger"></span>
                                </div>
                                <div class="col-md-8 mb-3">
                                    <label asp-for="Shipper.Address" class="form-label">Address</label>
                                    <div class="input-group">
                                        <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-map-marker-alt"></i></span>
                                        <input asp-for="Shipper.Address" class="form-control" placeholder="Enter Address" />
                                    </div>
                                    <span asp-validation-for="Shipper.Address" class="text-danger"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Shipper.ContactNo" class="form-label">Contact Number</label>
                                    <div class="input-group">
                                        <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-phone"></i></span>
                                        <input asp-for="Shipper.ContactNo" class="form-control" placeholder="Enter phone number" />
                                    </div>
                                    <span asp-validation-for="Shipper.ContactNo" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ==== Card 2: Contact & Location ==== *@
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-address-book me-2"></i> Contact & Location</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Shipper.ClientId" class="form-label">Client</label>
                                    <div class="input-group">
                                        <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                                        <select asp-for="Shipper.ClientId" asp-items="@Model.Clients" class="form-select">
                                            <option value="">-- Select ClientId --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="Shipper.ClientId" class="text-danger"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Shipper.CityId" class="form-label">City</label>
                                    <div class="input-group">
                                        <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                                        <select asp-for="Shipper.CityId" asp-items="@Model.Cities" class="form-select">
                                            <option value="">-- Select City --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="Shipper.CityId" class="text-danger"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Shipper.CompanyId" class="form-label">Company</label>
                                    <div class="input-group">
                                        <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                                        <select asp-for="Shipper.CompanyId" asp-items="@Model.Companies" class="form-select">
                                            <option value="">-- Select Company --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="Shipper.CompanyId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="@Url.Action("Index", "Shipper", new { area = "Master" })" class="btn btn-light text-primary">
                        <i class="fas fa-arrow-left me-1"></i> Back to List
                    </a>
                    <button type="submit" class="btn" style="background-color: #092963; color: white;" id="submitBtn">
                        <i class="fas fa-save me-1"></i> Create Shipper
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}