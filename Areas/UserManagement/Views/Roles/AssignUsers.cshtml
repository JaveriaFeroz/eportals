@model ProcureToPay.Areas.UserManagement.ViewModels.AssignUsersViewModel

<div class="modal-body">
    <form method="post" asp-action="AssignUsers" asp-controller="Roles" asp-area="UserManagement" asp-route-id="@Model.Role.Id">
        <input type="hidden" asp-for="Role.Id" />

        <h5 class="fw-bold mb-3 text-primary">
            <i class="fas fa-user-tag me-2"></i>Assign Users to <span class="text-dark">@Model.Role.Name</span>
        </h5>
        <p class="text-muted mb-4">Select users to assign to this role.</p>

        <div class="row">
            <div class="col-md-6">
                <label class="form-label"><i class="fas fa-user-plus me-2"></i>Available Users</label>

                <div class="input-group mb-2">
                    <span class="input-group-text" style="background-color: #092963; color: white;">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="availableSearch" class="form-control" placeholder="Search available users...">
                </div>

                <div class="list-group border rounded-3" id="availableUsers" style="max-height: 300px; overflow-y: auto;">
                    @foreach (var user in Model.AvailableUsers)
                    {
                        <div class="list-group-item">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="selectedUsers" value="@user.Id" id="user_@user.Id"
                                @(Model.UsersInRole.Any(u => u.Id == user.Id) ? "checked" : "")>
                                <label class="form-check-label" for="user_@user.Id">@user.UserName</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label"><i class="fas fa-users-cog me-2"></i>Users in Role</label>

                <div class="input-group mb-2">
                    <span class="input-group-text" style="background-color: #092963; color: white;">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="assignedSearch" class="form-control" placeholder="Search assigned users...">
                </div>

                <div class="list-group border rounded-3" id="assignedUsers" style="max-height: 300px; overflow-y: auto;">
                    @foreach (var user in Model.UsersInRole)
                    {
                        <div class="list-group-item">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="selectedUsers" value="@user.Id" id="user_@user.Id" checked>
                                <label class="form-check-label" for="user_@user.Id">@user.UserName</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1"></i> Save Assignments
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(function () {
            function applySearch(inputId, listId) {
                const searchTerm = $(`#${inputId}`).val().toLowerCase();
                $(`#${listId} .list-group-item`).each(function () {
                    const text = $(this).find("label").text().toLowerCase();
                    $(this).toggle(text.includes(searchTerm));
                });
            }

            // Apply search on keyup for immediate filtering
            $('#availableSearch').on('keyup', function () {
                applySearch('availableSearch', 'availableUsers');
            });

            $('#assignedSearch').on('keyup', function () {
                applySearch('assignedSearch', 'assignedUsers');
            });

        });
    </script>
}