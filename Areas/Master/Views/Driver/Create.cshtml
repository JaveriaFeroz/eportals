@model ProcureToPay.Areas.Master.Models.DriverCreateEditViewModel
@{
    ViewData["Title"] = "Create Driver";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" asp-area="">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Drivers</a></li>
        <li class="breadcrumb-item active">Create</li>
    </ol>

    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-plus me-2"></i> Create New Driver
            </h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @* ==== Card 1: Basic & Employment Information ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-info-circle me-2"></i> Basic & Employment Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.DriverName" class="form-label">Driver Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user-tie"></i></span>
                                    <input asp-for="Driver.DriverName" class="form-control" placeholder="Enter driver's full name" />
                                </div>
                                <span asp-validation-for="Driver.DriverName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.FatherName" class="form-label">Father Name</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    <input asp-for="Driver.FatherName" class="form-control" placeholder="Enter father's name" />
                                </div>
                                <span asp-validation-for="Driver.FatherName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.EmployeeNo" class="form-label">Employee Number</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-id-badge"></i></span>
                                    <input asp-for="Driver.EmployeeNo" class="form-control" placeholder="Enter employee number" />
                                </div>
                                <span asp-validation-for="Driver.EmployeeNo" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.CompanyId" class="form-label">Company <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-building"></i></span>
                                    <select asp-for="Driver.CompanyId" asp-items="@Model.Companies" class="form-select">
                                        <option value="">-- Select Company --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Driver.CompanyId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.BranchId" class="form-label">Branch <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-code-branch"></i></span>
                                    <select asp-for="Driver.BranchId" asp-items="@Model.Branches" class="form-select">
                                        <option value="">-- Select Branch --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Driver.BranchId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.Designation" class="form-label">Designation</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user-tag"></i></span>
                                    <input asp-for="Driver.Designation" class="form-control" placeholder="e.g., Senior Driver" />
                                </div>
                                <span asp-validation-for="Driver.Designation" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.JoiningDate" class="form-label">Joining Date <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                    <input asp-for="Driver.JoiningDate" type="date" class="form-control" />
                                </div>
                                <span asp-validation-for="Driver.JoiningDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.ContractorId" class="form-label">Contractor</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-hard-hat"></i></span>
                                    <select asp-for="Driver.ContractorId" asp-items="@Model.Contractors" class="form-select">
                                        <option value="">-- Select Contractor (if any) --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Driver.ContractorId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.MonthlySalary" class="form-label">Monthly Salary <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-dollar-sign"></i></span>
                                    <input asp-for="Driver.MonthlySalary" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Driver.MonthlySalary" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* ==== Card 2: Personal & Contact Details ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-address-book me-2"></i> Personal & Contact Details</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.BirthDate" class="form-label">Date of Birth <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-birthday-cake"></i></span>
                                    <input asp-for="Driver.BirthDate" type="date" class="form-control" />
                                </div>
                                <span asp-validation-for="Driver.BirthDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.CellNo" class="form-label">Cell Number <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-mobile-alt"></i></span>
                                    <input asp-for="Driver.CellNo" class="form-control" placeholder="Enter mobile number" />
                                </div>
                                <span asp-validation-for="Driver.CellNo" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.Address" class="form-label">Address <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                    <input asp-for="Driver.Address" class="form-control" placeholder="Enter full residential address" />
                                </div>
                                <span asp-validation-for="Driver.Address" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* ==== Card 3: Experience & Qualification ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-briefcase me-2"></i> Experience & Qualification</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.Experience" class="form-label">Experience (Years) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-medal"></i></span>
                                    <input asp-for="Driver.Experience" type="number" step="0.1" class="form-control" placeholder="e.g., 5.5" />
                                </div>
                                <span asp-validation-for="Driver.Experience" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.QualificationId" class="form-label">Qualification</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user-graduate"></i></span>
                                    <select asp-for="Driver.QualificationId" asp-items="@Model.Qualifications" class="form-select">
                                        <option value="">-- Select Qualification --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Driver.QualificationId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.PreviousEmployer" class="form-label">Previous Employer</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-building"></i></span>
                                    <input asp-for="Driver.PreviousEmployer" class="form-control" placeholder="Name of previous company" />
                                </div>
                                <span asp-validation-for="Driver.PreviousEmployer" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* ==== Card 4: Licenses & Identification ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-id-card me-2"></i> Licenses & Identification (CNIC)</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Driver.LicenseNo" class="form-label">License Number <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-id-card-alt"></i></span>
                                    <input asp-for="Driver.LicenseNo" class="form-control" placeholder="Enter license number" />
                                </div>
                                <span asp-validation-for="Driver.LicenseNo" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Driver.LicenseExpiry" class="form-label">License Expiry Date <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-calendar-times"></i></span>
                                    <input asp-for="Driver.LicenseExpiry" type="date" class="form-control" />
                                </div>
                                <span asp-validation-for="Driver.LicenseExpiry" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Driver.CNIC" class="form-label">CNIC <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                                    <input asp-for="Driver.CNIC" class="form-control" placeholder="13 digits without dashes" />
                                </div>
                                <span asp-validation-for="Driver.CNIC" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Driver.CNICExpiry" class="form-label">CNIC Expiry Date <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-calendar-check"></i></span>
                                    <input asp-for="Driver.CNICExpiry" type="date" class="form-control" />
                                </div>
                                <span asp-validation-for="Driver.CNICExpiry" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* ==== Card 5: Next of Kin ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-users me-2"></i> Next of Kin</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Driver.NoKName" class="form-label">Next of Kin Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user-shield"></i></span>
                                    <input asp-for="Driver.NoKName" class="form-control" placeholder="Enter full name" />
                                </div>
                                <span asp-validation-for="Driver.NoKName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Driver.NoKRelationId" class="form-label">Relations <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-code-branch"></i></span>
                                    <select asp-for="Driver.NoKRelationId" asp-items="@Model.NOKRelations" class="form-select">
                                        <option value="">-- Select Relation --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Driver.NoKRelationId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* ==== Card 6: Status & Separation (Optional) ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-user-slash me-2"></i> Status & Separation (Optional)</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.SeparationTypeId" class="form-label">Separation Type</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-sign-out-alt"></i></span>
                                    <select asp-for="Driver.SeparationTypeId" asp-items="@Model.SeparationTypes" class="form-select">
                                        <option value="">-- Select if applicable --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Driver.SeparationTypeId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Driver.SeparationDate" class="form-label">Separation Date</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-calendar-minus"></i></span>
                                    <input asp-for="Driver.SeparationDate" type="date" class="form-control" />
                                </div>
                                <span asp-validation-for="Driver.SeparationDate" class="text-danger"></span>
                            </div>
                            
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Driver.SeparationReason" class="form-label">Separation Reason</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-comment-alt"></i></span>
                                    <textarea asp-for="Driver.SeparationReason" class="form-control" rows="2" placeholder="Reason for separation"></textarea>
                                </div>
                                <span asp-validation-for="Driver.SeparationReason" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                    <button type="submit" class="btn" style="background-color: #092963; color: white;"><i class="fas fa-save me-1"></i> Create Driver</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}