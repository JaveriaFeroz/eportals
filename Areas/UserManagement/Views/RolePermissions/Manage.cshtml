@model ProcureToPay.Areas.UserManagement.ViewModels.ManageRolePermissionsViewModel
@{
    ViewData["Title"] = $"Manage Permissions - {Model.Role.Name}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963; display: flex; justify-content: space-between; align-items: center;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-cog me-2"></i> Manage Permissions for @Model.Role.Name
            </h5>
        </div>
        <div class="card-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Manage" method="post" id="permissionsForm">
                <input type="hidden" asp-for="@Model.Role.Id" name="id" />

                <ul class="nav nav-tabs" id="permissionTabs" role="tablist">
                    @foreach (var module in Model.Modules)
                    {
                        var moduleId = module.Replace(" ", "").ToLower();
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(module == Model.Modules.First() ? "active" : "")"
                                    id="@moduleId-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#@moduleId"
                                    type="button"
                                    role="tab"
                                    aria-controls="@moduleId"
                                    aria-selected="@(module == Model.Modules.First())">
                                @module
                            </button>
                        </li>
                    }
                </ul>

                @if (Model.Permissions.Any())
                {
                    <div class="tab-content mt-3" id="permissionTabContent">
                        @foreach (var module in Model.Modules)
                        {
                            var moduleId = module.Replace(" ", "").ToLower();
                            <div class="tab-pane fade @(module == Model.Modules.First() ? "show active" : "")"
                                 id="@moduleId"
                                 role="tabpanel"
                                 aria-labelledby="@moduleId-tab">

                                <div class="d-flex justify-content-between mb-2">
                                    <h5 class="fw-bold text-secondary">@module Permissions</h5>
                                    <div>
                                        <button type="button" class="btn btn-sm btn-outline-primary select-module" data-module="@module">
                                            Select All
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary deselect-module ms-2" data-module="@module">
                                            Deselect All
                                        </button>
                                    </div>
                                </div>

                                <div class="row fw-bold bg-light border-bottom py-2 px-2 text-secondary">
                                    <div class="col-1 d-flex align-items-center justify-content-center">
                                        <i class="far fa-square me-1"></i>
                                    </div>
                                    <div class="col-5 d-flex align-items-center">
                                        <i class="fas fa-list-alt me-1 text-dark"></i> PERMISSION
                                    </div>
                                    <div class="col-6 d-flex align-items-center">
                                        <i class="fas fa-align-left me-1 text-dark"></i> DESCRIPTION
                                    </div>
                                </div>

                                @foreach (var permission in Model.Permissions.Where(p => p.Module != null && p.Module.DisplayName == module))
                                {
                                    <div class="row align-items-center border-bottom py-2 px-2">
                                        <div class="col-1 d-flex align-items-center justify-content-center">
                                            <div class="form-check">
                                                <input type="checkbox"
                                                       class="form-check-input permission-checkbox"
                                                       id="permission_@permission.Id"
                                                       name="selectedPermissions"
                                                       value="@permission.Id"
                                                       data-module="@permission.Module.DisplayName"
                                                       @(Model.AssignedPermissionIds.Contains(permission.Id) ? "checked" : "") />
                                            </div>
                                        </div>
                                        <div class="col-5">
                                            <label class="form-check-label" for="permission_@permission.Id">
                                                @permission.Name
                                            </label>
                                        </div>
                                        <div class="col-6">@permission.Description</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-12 text-center text-muted py-4">
                            <i class="fas fa-inbox fa-2x mb-2"></i>
                            <br>No Permssions in Module.
                        </div>
                    </div>
                }
            </form>
        </div>
        <div class="card-footer d-flex justify-content-end align-items-center">
            <button type="submit" form="permissionsForm" class="btn btn-primary" style="transition: background-color 0.3s ease;">
                <i class="fas fa-save me-1"></i> Save Changes
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Select all permissions in a module
            $('.select-module').click(function() {
                var module = $(this).data('module');
                $('.permission-checkbox[data-module="' + module + '"]').prop('checked', true);
            });

            // Deselect all permissions in a module
            $('.deselect-module').click(function() {
                var module = $(this).data('module');
                $('.permission-checkbox[data-module="' + module + '"]').prop('checked', false);
            });
        });
    </script>
}