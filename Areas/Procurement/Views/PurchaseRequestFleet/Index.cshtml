@model IEnumerable<ProcureToPay.Areas.Procurement.ViewModels.PurchaseRequestFleetListViewModel>
@{
    ViewData["Title"] = "Purchase Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var filter = ViewBag.Filter as ProcureToPay.Areas.Procurement.ViewModels.PurchaseRequestFleetFilterViewModel;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Purchase Requests</h2>
            <small class="text-muted">Manage fleet purchase requests</small>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create New Request
            </a>
            <a asp-action="Summary" class="btn btn-outline-info">
                <i class="fas fa-chart-bar"></i> Summary
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Panel -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                <button class="btn btn-link p-0" type="button" data-bs-toggle="collapse" data-bs-target="#filterPanel">
                    <i class="fas fa-filter"></i> Filter Options
                </button>
            </h5>
        </div>
        <div class="collapse" id="filterPanel">
            <div class="card-body">
                <form method="get" asp-action="Index">
                    <div class="row">
                        <div class="col-md-2">
                            <label asp-for="@filter.PRNo" class="form-label"></label>
                            <input asp-for="@filter.PRNo" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="@filter.CompanyCode" class="form-label"></label>
                            <select asp-for="@filter.CompanyCode" class="form-select">
                                <option value="">All Companies</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="@filter.BranchCode" class="form-label"></label>
                            <select asp-for="@filter.BranchCode" class="form-select">
                                <option value="">All Branches</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="@filter.DepartmentCode" class="form-label"></label>
                            <select asp-for="@filter.DepartmentCode" class="form-select">
                                <option value="">All Departments</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="@filter.StateId" class="form-label"></label>
                            <select asp-for="@filter.StateId" class="form-select">
                                <option value="">All States</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="@filter.Owner" class="form-label"></label>
                            <input asp-for="@filter.Owner" class="form-control" />
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-2">
                            <label asp-for="@filter.RequiredFromDate" class="form-label"></label>
                            <input asp-for="@filter.RequiredFromDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="@filter.RequiredToDate" class="form-label"></label>
                            <input asp-for="@filter.RequiredToDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="@filter.CreatedFromDate" class="form-label"></label>
                            <input asp-for="@filter.CreatedFromDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="@filter.CreatedToDate" class="form-label"></label>
                            <input asp-for="@filter.CreatedToDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="fas fa-search"></i> Filter
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Clear
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Purchase Requests (@totalCount items)</h5>
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-cog"></i> Actions
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#"><i class="fas fa-download"></i> Export to Excel</a></li>
                    <li><a class="dropdown-item" href="#"><i class="fas fa-file-pdf"></i> Export to PDF</a></li>
                </ul>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>PR No.</th>
                                <th>Company</th>
                                <th>Branch</th>
                                <th>Department</th>
                                <th>Owner</th>
                                <th>Required By</th>
                                <th>State</th>
                                <th>Budget Amount</th>
                                <th>Created Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@(item.PRNo?.ToString() ?? "N/A")</strong>
                                    </td>
                                    <td>@item.CompanyName</td>
                                    <td>@item.BranchName</td>
                                    <td>@item.DepartmentName</td>
                                    <td>@item.Owner</td>
                                    <td>@item.RequiredBy?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge bg-@item.StatusClass">
                                            <i class="@item.StatusIcon"></i> @item.StateName
                                        </span>
                                    </td>
                                    <td>@item.BudgetAmount?.ToString("C")</td>
                                    <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (item.CanEdit)
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            }
                                            @if (item.CanApprove)
                                            {
                                                <a asp-action="Approve" asp-route-id="@item.Id" class="btn btn-outline-success" title="Approve">
                                                    <i class="fas fa-check"></i>
                                                </a>
                                            }
                                            @if (item.CanReject)
                                            {
                                                <a asp-action="Reject" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Reject">
                                                    <i class="fas fa-times"></i>
                                                </a>
                                            }
                                            @if (item.CanDelete)
                                            {
                                                <button type="button" class="btn btn-outline-danger" title="Delete" onclick="confirmDelete(@item.Id)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="card-footer">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mb-0">
                            @{
                                var currentPage = filter?.Page ?? 1;
                                var pageSize = filter?.PageSize ?? 10;
                                var totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
                            }

                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, pageSize = pageSize })">Previous</a>
                                </li>
                            }

                            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = pageSize })">@i</a>
                                </li>
                            }

                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, pageSize = pageSize })">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No purchase requests found</h5>
                    <p class="text-muted">Try adjusting your filter criteria or create a new purchase request.</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Create New Request
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this purchase request? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmDelete(id) {
        document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        deleteModal.show();
    }
</script>