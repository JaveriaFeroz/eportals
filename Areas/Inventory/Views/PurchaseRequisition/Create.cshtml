@using ProcureToPay.Enums
@model ProcureToPay.Areas.Inventory.Models.PurchaseRequisitionCreateEditViewModel

@{
    ViewData["Title"] = "Create Purchase Requisition";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" asp-area="">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="PurchaseRequisition" asp-area="Inventory">Purchase Requisitions</a></li>
        <li class="breadcrumb-item active">Create</li>
    </ol>

    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-plus me-2"></i> Create New Purchase Requisition
            </h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Create" asp-controller="PurchaseRequisition" asp-area="Inventory">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @* ==== Card 1: PR Details ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-info-circle me-2"></i> Purchase Requisition Details</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="PurchaseRequisition.CompanyCode" class="form-label">Company Code <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-building"></i></span>
                                    <input asp-for="PurchaseRequisition.CompanyCode" class="form-control" placeholder="Enter company code" />
                                </div>
                                <span asp-validation-for="PurchaseRequisition.CompanyCode" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="PurchaseRequisition.BranchId" class="form-label">Branch <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-code-branch"></i></span>
                                    <select asp-for="PurchaseRequisition.BranchId" asp-items="@Model.Branches" class="form-select">
                                        <option value="">-- Select Branch --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="PurchaseRequisition.BranchId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="PurchaseRequisition.DepartmentId" class="form-label">Department <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-users"></i></span>
                                    <select asp-for="PurchaseRequisition.DepartmentId" asp-items="@Model.Departments" class="form-select">
                                        <option value="">-- Select Department --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="PurchaseRequisition.DepartmentId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="PurchaseRequisition.RequiredBy" class="form-label">Required By <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-calendar-alt"></i></span>
                                    <input asp-for="PurchaseRequisition.RequiredBy" type="date" class="form-control" />
                                </div>
                                <span asp-validation-for="PurchaseRequisition.RequiredBy" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="PurchaseRequisition.StateName" class="form-label">Current State</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-clipboard-list"></i></span>
                                    <input asp-for="PurchaseRequisition.StateName" class="form-control" readonly="readonly" value="Saved" />
                                    <input type="hidden" asp-for="PurchaseRequisition.StateId" value="1" />
                                </div>
                                <span asp-validation-for="PurchaseRequisition.StateName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="PurchaseRequisition.Owner" class="form-label">Current Owner <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-user"></i></span>
                                    <input asp-for="PurchaseRequisition.Owner" class="form-control" readonly="readonly" value="@User.Identity?.Name" />
                                </div>
                                <span asp-validation-for="PurchaseRequisition.Owner" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* ==== Card 2: Request Details ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-file-invoice-dollar me-2"></i> Request Details</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @* Purchase Nature Type (Opex/Capex Radio Buttons) *@
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Purchase Nature Type <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-hand-holding-usd"></i></span>
                                    <div class="d-flex align-items-center ms-3" style="border: none;">
                                        @* Added ms-3 for left margin *@
                                        @foreach (var option in Model.PurchaseNatureOptions)
                                        {
                                            <div class="form-check form-check-inline me-3">
                                                <input class="form-check-input purchase-nature-type-radio" type="radio"
                                                       name="PurchaseRequisition.PurchaseNatureType"
                                                       id="purchaseNatureType_@(option.Value)"
                                                       value="@option.Value"
                                                       @( ( (int)Model.PurchaseRequisition.PurchaseNatureType ).ToString() == option.Value ? "checked" : "" ) />
                                                <label class="form-check-label" for="purchaseNatureType_@(option.Value)">@option.Text</label>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <span asp-validation-for="PurchaseRequisition.PurchaseNatureType" class="text-danger"></span>
                            </div>

                            @* Purchase Item Type (Goods/Service Radio Buttons) *@
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Purchase Item Type <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-shopping-cart"></i></span>
                                    <div class="d-flex align-items-center ms-3" style="border: none;">
                                        @* Added ms-3 for left margin *@
                                        @foreach (var option in Model.PurchaseTypeOptions)
                                        {
                                            <div class="form-check form-check-inline me-3">
                                                <input class="form-check-input purchase-item-type-radio" type="radio"
                                                       name="PurchaseRequisition.PurchaseItemType"
                                                       id="purchaseItemType_@(option.Value)"
                                                       value="@option.Value"
                                                       @( ( (int)Model.PurchaseRequisition.PurchaseItemType ).ToString() == option.Value ? "checked" : "" ) />
                                                <label class="form-check-label" for="purchaseItemType_@(option.Value)">@option.Text</label>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <span asp-validation-for="PurchaseRequisition.PurchaseItemType" class="text-danger"></span>
                            </div>

                            @* Product Nature Dropdown (initially hidden) *@
                            <div class="col-md-4 mb-3" id="productNatureGroup" style="display: none;">
                                <label asp-for="PurchaseRequisition.ProductNatureId" class="form-label">Product Nature <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-box-open"></i></span>
                                    <select asp-for="PurchaseRequisition.ProductNatureId" asp-items="@Model.ProductNatures" class="form-select" id="productNatureDropdown">
                                        <option value="">-- Select Product Nature --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="PurchaseRequisition.ProductNatureId" class="text-danger"></span>
                            </div>

                            @* Service Nature Dropdown (initially hidden) *@
                            <div class="col-md-4 mb-3" id="serviceNatureGroup" style="display: none;">
                                <label asp-for="PurchaseRequisition.ServiceNatureId" class="form-label">Service Nature <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-concierge-bell"></i></span>
                                    <select asp-for="PurchaseRequisition.ServiceNatureId" asp-items="@Model.ServiceNatures" class="form-select" id="serviceNatureDropdown">
                                        <option value="">-- Select Service Nature --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="PurchaseRequisition.ServiceNatureId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="PurchaseRequisition.Justification" class="form-label">Justification <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-align-left"></i></span>
                                    <textarea asp-for="PurchaseRequisition.Justification" class="form-control" rows="3" placeholder="Provide detailed justification for the request"></textarea>
                                </div>
                                <span asp-validation-for="PurchaseRequisition.Justification" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-light text-primary" asp-controller="PurchaseRequisition" asp-area="Inventory"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                    <button type="submit" class="btn" style="background-color: #092963; color: white;"><i class="fas fa-save me-1"></i> Create Purchase Requisition</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="text/javascript">
        $(document).ready(function () {

            // Cache selectors for performance
            var $productNatureGroup = $('#productNatureGroup');
            var $serviceNatureGroup = $('#serviceNatureGroup');
            var $productNatureDropdown = $('#productNatureDropdown');
            var $serviceNatureDropdown = $('#serviceNatureDropdown');
            var $purchaseNatureTypeRadios = $('.purchase-nature-type-radio');
            var $purchaseItemTypeRadios = $('.purchase-item-type-radio');

            // Function to handle the visibility and loading of Nature dropdowns
            function updateNatureDropdowns() {
                var selectedPurchaseNatureType = $purchaseNatureTypeRadios.filter(':checked').val();
                var selectedPurchaseItemType = $purchaseItemTypeRadios.filter(':checked').val();

                // Reset dropdowns and hide groups
                $productNatureDropdown.empty().append($('<option></option>').val('').text('-- Select Product Nature --'));
                $serviceNatureDropdown.empty().append($('<option></option>').val('').text('-- Select Service Nature --'));
                $productNatureGroup.hide();
                $serviceNatureGroup.hide();

                if (!selectedPurchaseNatureType || !selectedPurchaseItemType) {
                    return; // Do nothing if either type is not selected
                }

                // Determine which nature dropdown to show and populate
                if (selectedPurchaseItemType === '@((int)PurchaseItemType.Goods)') { // Check if 'Goods' is selected
                    $productNatureGroup.show();
                    loadProductNatures(selectedPurchaseNatureType);
                } else if (selectedPurchaseItemType === '@((int)PurchaseItemType.Service)') { // Check if 'Service' is selected
                    $serviceNatureGroup.show();
                    loadServiceNatures(selectedPurchaseNatureType);
                }
            }

            function loadProductNatures(purchaseNatureType) {
                if (purchaseNatureType) {
                    $.ajax({
                        url: '@Url.Action("GetProductNaturesByPurchaseNatureType", "PurchaseRequisition", new { area = "Inventory" })',
                        type: 'GET',
                        data: { purchaseNatureType: purchaseNatureType },
                        success: function (data) {
                            $.each(data, function (index, item) {
                                $productNatureDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                            // If there's a pre-selected value (e.g., on Edit or validation error), set it
                            var preSelectedProductNatureId = '@Model.PurchaseRequisition.ProductNatureId';
                            if (preSelectedProductNatureId && preSelectedProductNatureId !== "0") {
                                $productNatureDropdown.val(preSelectedProductNatureId);
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Failed to load Product Natures:", error);
                        }
                    });
                }
            }

            function loadServiceNatures(purchaseNatureType) {
                if (purchaseNatureType) {
                    $.ajax({
                        url: '@Url.Action("GetServiceNaturesByPurchaseNatureType", "PurchaseRequisition", new { area = "Inventory" })',
                        type: 'GET',
                        data: { purchaseNatureType: purchaseNatureType },
                        success: function (data) {
                            $.each(data, function (index, item) {
                                $serviceNatureDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                            // If there's a pre-selected value (e.g., on Edit or validation error), set it
                            var preSelectedServiceNatureId = '@Model.PurchaseRequisition.ServiceNatureId';
                            if (preSelectedServiceNatureId && preSelectedServiceNatureId !== "0") {
                                $serviceNatureDropdown.val(preSelectedServiceNatureId);
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Failed to load Service Natures:", error);
                        }
                    });
                }
            }

            // Event listeners for radio button changes
            $purchaseNatureTypeRadios.on('change', updateNatureDropdowns);
            $purchaseItemTypeRadios.on('change', updateNatureDropdowns);


            // Initial call to set up the dropdowns on page load (important for Edit/validation errors)
            // This will ensure the correct dropdown is shown and populated if values exist in the model.
            updateNatureDropdowns();

        });
    </script>
}