@model ProcureToPay.Areas.Master.ViewModels.ActivityViewModel
@{
    ViewData["Title"] = "Create Activity";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-plus me-2"></i> Create New Activity
            </h5>
        </div>
        <div class="card-body">
            @* Displaying model state errors at the top if any exist *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post" action="@Url.Action("Create", "Activity", new { area = "Master" })" id="createActivityForm">
                @Html.AntiForgeryToken()

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-info-circle me-2"></i> Activity Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="ActivityName" class="form-label">Activity Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;">
                                        <i class="fas fa-tasks"></i>
                                    </span>
                                    <input type="text"
                                           id="activityNameInput"
                                           name="ActivityName"
                                           class="form-control"
                                           placeholder="Enter activity name"
                                           value="@Model?.ActivityName"
                                           required />
                                </div>
                                @if (ViewData.ModelState["ActivityName"]?.Errors.Any() == true)
                                {
                                    <span class="text-danger">@ViewData.ModelState["ActivityName"].Errors.First().ErrorMessage</span>
                                }
                                @* This div is for client-side AJAX validation feedback *@
                                <div id="activityNameError" class="text-danger" style="display: none;"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="EstHrsReq" class="form-label">Estimated Hours Required <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;">
                                        <i class="fas fa-hourglass-half"></i>
                                    </span>
                                    <input type="number"
                                           id="estHrsReqInput"
                                           name="EstHrsReq"
                                           class="form-control"
                                           placeholder="e.g., 8.5"
                                           step="0.1"
                                           min="0.1"
                                           value="@(Model?.EstHrsReq.ToString("0.0"))" @* Format for display *@
                                           required />
                                </div>
                                @if (ViewData.ModelState["EstHrsReq"]?.Errors.Any() == true)
                                {
                                    <span class="text-danger">@ViewData.ModelState["EstHrsReq"].Errors.First().ErrorMessage</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>


                <div class="d-flex justify-content-between mt-4">
                    <a href="@Url.Action("Index", "Activity", new { area = "Master" })" class="btn btn-light text-primary">
                        <i class="fas fa-arrow-left me-1"></i> Back to List
                    </a>
                    <button type="submit" class="btn" style="background-color: #092963; color: white;" id="submitBtn">
                        <i class="fas fa-save me-1"></i> Create Activity
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}