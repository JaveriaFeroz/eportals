@using ProcureToPay.Areas.Procurement.Models
@using ProcureToPay.Areas.Common.Enums
@model PurchaseOrder

@{
    ViewData["Title"] = "Reorder Purchase Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var originalPONumber = ViewBag.OriginalPONumber ?? "N/A";
}

<style>
    .input-group-text.custom-blue {
        background-color: #092963;
        color: white;
    }
</style>

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-redo me-2"></i> Reorder Purchase Order
            </h5>
        </div>
        <div class="card-body">
            @* Reorder Info Banner *@
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="fas fa-redo me-2"></i>
                <strong>Reordering from:</strong> @originalPONumber
                <p class="mb-0 mt-2">
                    All details have been pre-filled from the original order.
                    You can adjust quantities, prices, and items as needed before creating the new order.
                </p>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>

            <form asp-action="CreateReorder" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="originalPOId" value="@ViewBag.OriginalPOId" />
                <input type="hidden" name="CreatedByUserId" value="@Model.CreatedByUserId" />
                <input type="hidden" name="PurchaseNature" value="@((int)Model.PurchaseNature)" />
                <input type="hidden" name="PurchaseType" value="@((int)Model.PurchaseType)" />
                <input type="hidden" name="departmentId" value="@Model.DepartmentId" />
                <input type="hidden" name="branchId" value="@Model.BranchId" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-info-circle me-2"></i> Purchase Order Details
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">PO Title <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-heading"></i>
                                    </span>
                                    <input name="Title"
                                           value="@Model.Title"
                                           class="form-control"
                                           placeholder="Enter PO title"
                                           required />
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Supplier <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-truck"></i>
                                    </span>
                                    <select name="VendorId" class="form-control"
                                            asp-items="@(new SelectList(ViewBag.Suppliers, "Value", "Text", Model.SupplierId))"
                                            required
                                            id="vendorSelect"
                                            data-url="@Url.Action("GetSupplierDetails", "PurchaseOrder", new { area = "Procurement" })">
                                        <option value="">-- Select Supplier --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Expected Delivery Date <span class="text-danger">*</span></label>
                                <div class="input-group" id="expectedDeliveryDateContainer">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-calendar-alt"></i>
                                    </span>
                                    <input name="ExpectedDeliveryDate"
                                           type="date"
                                           id="expectedDeliveryDateInput"
                                           value="@Model.ExpectedDeliveryDate?.ToString("yyyy-MM-dd")"
                                           class="form-control"
                                           required
                                           min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3" style="display: none;">
                            <label class="form-label">Description</label>
                            <div class="input-group">
                                <span class="input-group-text custom-blue">
                                    <i class="fas fa-comment-alt"></i>
                                </span>
                                <textarea name="description"
                                          class="form-control"
                                          rows="1"
                                          placeholder="Enter purchase order description"
                                          readonly>@Model.Description</textarea>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Supplier Address</label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </span>
                                    <textarea name="supplierAddress" class="form-control" rows="1" placeholder="Enter vendor address" id="vendorAddressTextarea">@Model.SupplierAddress</textarea>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Supplier Contact</label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-phone"></i>
                                    </span>
                                    <input name="SupplierContact"
                                           value="@Model.SupplierContact"
                                           class="form-control"
                                           id="vendorContactInput"
                                           placeholder="e.g., 0333-1234567"
                                           type="tel"
                                           pattern="[0-9]{4}-[0-9]{7}"
                                           maxlength="12"
                                           title="A Pakistani phone number format (e.g., 0333-1234567)" />
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Payment Days</label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-calendar-alt"></i>
                                    </span>
                                    <input type="number" name="PaymentDays" class="form-control" placeholder="Enter payment days" value="@Model.PaymentDays" />
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Terms & Condition</label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-file-contract"></i>
                                    </span>
                                    <textarea name="Terms" class="form-control" rows="1" placeholder="Enter terms">@Model.Terms</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />
                <div class="card mb-4">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-boxes me-2"></i> Purchase Order Items
                        </h6>
                    </div>
                    <div class="card-body">
                        <div id="poItemsContainer" class="mb-3">
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    <div class="card card-body mb-2 po-item-row">
                                        <input type="hidden" name="Items[@i].ItemName" value="@Model.Items[i].ItemName" />
                                        <input type="hidden" name="Items[@i].UoMId" value="@Model.Items[i].UoMId" />
                                        <div class="row">
                                            <div class="col-md-3 mb-3">
                                                <div class="form-group">
                                                    <label class="form-label">Item Name <span class="text-danger">*</span></label>
                                                    <div class="input-group">
                                                        <span class="input-group-text custom-blue"><i class="fas fa-box"></i></span>
                                                        <input type="text" value="@Model.Items[i].ItemName" class="form-control" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-2 mb-3">
                                                <div class="form-group">
                                                    <label class="form-label">Quantity <span class="text-danger">*</span></label>
                                                    <div class="input-group">
                                                        <span class="input-group-text custom-blue"><i class="fas fa-sort-numeric-up"></i></span>
                                                        <input type="number" name="Items[@i].Quantity" value="@Model.Items[i].Quantity" class="form-control quantity-input" step="1" min="0" required />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-2 mb-3">
                                                <div class="form-group">
                                                    <label class="form-label">Unit of Measure</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text custom-blue"><i class="fas fa-box"></i></span>
                                                        <input type="text" value="@Model.Items[i].Unit" class="form-control" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-2 mb-3">
                                                <div class="form-group">
                                                    <label class="form-label">Unit Price <span class="text-danger">*</span></label>
                                                    <div class="input-group">
                                                        <span class="input-group-text custom-blue"><i class="fas fa-dollar-sign"></i></span>
                                                        <input type="number" name="Items[@i].UnitPrice"
                                                               value="@Model.Items[i].UnitPrice"
                                                               class="form-control unit-price-input"
                                                               step="0.01"
                                                               required
                                                               data-original-price="@Model.Items[i].UnitPrice" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <div class="form-group">
                                                    <label class="form-label">Amount (Ex Tax)</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text custom-blue"><i class="fas fa-calculator"></i></span>
                                                        <input type="text" value="@(Model.Items[i].Quantity * Model.Items[i].UnitPrice)" class="form-control amount-ex-tax-display" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-md-3 mb-3">
                                                <div class="form-group">
                                                    <label class="form-label d-flex align-items-center">
                                                        <div class="form-check form-check-inline me-2 ms-2">
                                                            <input class="form-check-input disc-radio" type="radio"
                                                                   name="discountType[@i]" id="discPercentRadio_@i" value="percent" @(Model.Items[i].DiscRate.HasValue && Model.Items[i].DiscRate.Value > 0 ? "checked" : "checked")>
                                                            <label class="form-check-label" for="discPercentRadio_@i"></label>
                                                        </div>
                                                        Disc %
                                                    </label>
                                                    <div class="input-group">
                                                        <span class="input-group-text custom-blue"><i class="fas fa-percent"></i></span>
                                                        <input type="number" name="Items[@i].DiscRate"
                                                               value="@(Model.Items[i].DiscRate ?? 0)"
                                                               class="form-control disc-rate-input"
                                                               step="0.01" min="0" max="100" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <div class="form-group">
                                                    <label class="form-label d-flex align-items-center">
                                                        <div class="form-check form-check-inline me-2 ms-2">
                                                            <input class="form-check-input disc-radio" type="radio"
                                                                   name="discountType[@i]" id="discAmountRadio_@i" value="amount" @(Model.Items[i].DiscAmount.HasValue && Model.Items[i].DiscAmount.Value > 0 && (!Model.Items[i].DiscRate.HasValue || Model.Items[i].DiscRate.Value == 0) ? "checked" : "")>
                                                            <label class="form-check-label" for="discAmountRadio_@i"></label>
                                                        </div>
                                                        Disc Amount
                                                    </label>
                                                    <div class="input-group">
                                                        <span class="input-group-text custom-blue"><i class="fas fa-hand-holding-usd"></i></span>
                                                        <input type="number" name="Items[@i].DiscAmount"
                                                               value="@(Model.Items[i].DiscAmount ?? 0)"
                                                               class="form-control item-disc-amount-display"
                                                               step="0.01" min="0" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <div class="form-group">
                                                    <label class="form-label">GST %</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text custom-blue"><i class="fas fa-percent"></i></span>
                                                        <input type="number" name="Items[@i].GSTRate" value="@(Model.Items[i].GSTRate ?? 0)" class="form-control gst-rate-input" step="0.01" min="0" max="100" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <div class="form-group">
                                                    <label class="form-label">GST Amount</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text custom-blue"><i class="fas fa-receipt"></i></span>
                                                        <input type="number" name="Items[@i].GSTAmount" value="@(Model.Items[i].GSTAmount ?? 0)" class="form-control item-gst-amount-display" step="0.01" min="0" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="form-label">Total Price</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text custom-blue"><i class="fas fa-funnel-dollar"></i></span>
                                                        <input type="number" name="Items[@i].TotalPrice" value="@Model.Items[i].TotalPrice" class="form-control total-price-display" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="alert alert-warning">No items available for reorder.</p>
                            }
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-money-check-alt me-2"></i> Order Totals
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label class="form-label">Total Discount Amount</label>
                                    <div class="input-group">
                                        <span class="input-group-text custom-blue"><i class="fas fa-tags"></i></span>
                                        <input type="text" value="0" class="form-control" id="totalDiscountAmountDisplay" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label class="form-label">Total GST Amount</label>
                                    <div class="input-group">
                                        <span class="input-group-text custom-blue"><i class="fas fa-receipt"></i></span>
                                        <input type="text" name="TaxAmount" value="0" class="form-control" id="totalGstAmountDisplay" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label class="form-label">Grand Total</label>
                                    <div class="input-group">
                                        <span class="input-group-text custom-blue"><i class="fas fa-funnel-dollar"></i></span>
                                        <input type="text" value="@Model.GrandTotal" class="form-control" id="grandTotalDisplay" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn" style="background-color: #092963; color: white;" id="submitBtn">
                        <i class="fas fa-save me-1"></i> Create Purchase Order
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // --- DOM Elements ---
            const poItemsContainer = document.getElementById('poItemsContainer');
            const totalDiscountAmountDisplay = document.getElementById('totalDiscountAmountDisplay');
            const totalGstAmountDisplay = document.getElementById('totalGstAmountDisplay');
            const grandTotalDisplay = document.getElementById('grandTotalDisplay');
            // The ReOrder view does not have mappedAmountHidden, so skip it.

            const vendorSelect = document.getElementById('vendorSelect');
            const vendorAddressTextarea = document.getElementById('vendorAddressTextarea');
            const vendorContactInput = document.getElementById('vendorContactInput');

            const dateInput = document.getElementById('expectedDeliveryDateInput');
            const dateContainer = dateInput?.closest('.input-group');

            // --- Helper Functions ---

            function handleSupplierChange() {
                const supplierId = vendorSelect.value;
                const url = vendorSelect.dataset.url;

                if (supplierId) {
                    fetch(`${url}?supplierId=${supplierId}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                // 1. Set values
                                vendorAddressTextarea.value = data.address || '';
                                vendorContactInput.value = data.contact || '';

                                // 2. LOCK FIELDS (Reorder/Create-like logic)
                                vendorAddressTextarea.setAttribute('readonly', 'readonly');
                                vendorContactInput.setAttribute('readonly', 'readonly');
                            } else {
                                console.error('Failed to fetch supplier details:', data.message);
                                vendorAddressTextarea.value = '';
                                vendorContactInput.value = '';

                                // Unlock fields on failure
                                vendorAddressTextarea.removeAttribute('readonly');
                                vendorContactInput.removeAttribute('readonly');
                            }
                        })
                        .catch(error => {
                            console.error('Error during fetch:', error);
                            vendorAddressTextarea.value = '';
                            vendorContactInput.value = '';
                            vendorAddressTextarea.removeAttribute('readonly');
                            vendorContactInput.removeAttribute('readonly');
                        });
                } else {
                    // Clear and unlock if no supplier is selected
                    vendorAddressTextarea.value = '';
                    vendorContactInput.value = '';
                    vendorAddressTextarea.removeAttribute('readonly');
                    vendorContactInput.removeAttribute('readonly');
                }
            }

            // --- PRICE VALIDATION & CALCULATION FUNCTIONS (Copied from Create/Edit Script) ---

            function validateUnitPrice(itemRow) {
                const unitPriceInput = itemRow.querySelector('.unit-price-input');
                const newPrice = parseFloat(unitPriceInput.value) || 0;
                // Read the original price from the data attribute set in the Razor view
                const originalPrice = parseFloat(unitPriceInput.dataset.originalPrice) || 0;

                // Enforce price cannot be raised
                if (newPrice > originalPrice) {
                    alert('The unit price cannot be increased above the original price: ' + originalPrice.toFixed(2));
                    // Revert the value to the original price
                    unitPriceInput.value = originalPrice.toFixed(2);
                } else if (newPrice < 0) {
                    // Prevent negative prices
                    unitPriceInput.value = '0.00';
                }

                // Proceed with calculating totals using the (potentially corrected) price
                calculateItemTotalPrice(itemRow);
            }

            function updateDiscountFields(itemRow) {
                const discRateInput = itemRow.querySelector('.disc-rate-input');
                const discAmountInput = itemRow.querySelector('.item-disc-amount-display');
                const selectedRadio = itemRow.querySelector('input[name^="discountType"]:checked');
                // Use optional chaining for safety, though radio should be checked by default
                const isPercentSelected = selectedRadio?.value === 'percent';

                // Locking logic
                if (isPercentSelected) {
                    discRateInput.removeAttribute('readonly');
                    discAmountInput.setAttribute('readonly', 'readonly');
                } else {
                    discAmountInput.removeAttribute('readonly');
                    discRateInput.setAttribute('readonly', 'readonly');
                }

                calculateDiscountValues(itemRow);
            }

            function calculateDiscountValues(itemRow) {
                const discRateInput = itemRow.querySelector('.disc-rate-input');
                const discAmountInput = itemRow.querySelector('.item-disc-amount-display');
                const amountExclTax = parseFloat(itemRow.querySelector('.amount-ex-tax-display').value) || 0;
                const selectedRadio = itemRow.querySelector('input[name^="discountType"]:checked');
                const isPercentSelected = selectedRadio?.value === 'percent';

                let calculatedDiscAmount = 0;

                if (isPercentSelected) {
                    const discRate = parseFloat(discRateInput.value) || 0;
                    calculatedDiscAmount = amountExclTax * (discRate / 100);
                } else {
                    calculatedDiscAmount = parseFloat(discAmountInput.value) || 0;
                }

                // Prevent discount from exceeding total amount ex-tax
                if (calculatedDiscAmount > amountExclTax) {
                    calculatedDiscAmount = amountExclTax;
                    alert('Discount amount cannot exceed the amount excluding tax.');
                }

                discAmountInput.value = calculatedDiscAmount.toFixed(2);

                // Recalculate and display the reciprocal field (Rate based on Amount, or vice versa)
                const newDiscRate = (amountExclTax > 0) ? (calculatedDiscAmount / amountExclTax) * 100 : 0;
                discRateInput.value = isFinite(newDiscRate) ? newDiscRate.toFixed(2) : 0; // Always calculate rate, just don't allow input if locked

                calculateItemTotalPrice(itemRow);
            }

            function calculateItemTotalPrice(itemRow) {
                const quantityInput = itemRow.querySelector('.quantity-input');
                const unitPriceInput = itemRow.querySelector('.unit-price-input');
                const discAmountInput = itemRow.querySelector('.item-disc-amount-display');
                const gstRateInput = itemRow.querySelector('.gst-rate-input');

                const amountExclTaxDisplay = itemRow.querySelector('.amount-ex-tax-display');
                const itemGstAmountDisplay = itemRow.querySelector('.item-gst-amount-display');
                const totalPriceDisplay = itemRow.querySelector('.total-price-display');

                const quantity = parseFloat(quantityInput.value) || 0;
                // Use the value from the input which has already been validated by validateUnitPrice
                const unitPrice = parseFloat(unitPriceInput.value) || 0;
                const discAmount = parseFloat(discAmountInput.value) || 0;

                // GST Rate Validation
                let gstRate = parseFloat(gstRateInput.value) || 0;
                if (gstRate < 0 || gstRate > 100) {
                    alert('GST Rate must be between 0 and 100.');
                    gstRate = Math.min(Math.max(gstRate, 0), 100);
                    gstRateInput.value = gstRate;
                }

                const amountExclTax = quantity * unitPrice;
                const subtotalAfterDiscount = amountExclTax - discAmount;
                const gstAmount = subtotalAfterDiscount * (gstRate / 100.00);
                const totalAmount = subtotalAfterDiscount + gstAmount;

                amountExclTaxDisplay.value = amountExclTax.toFixed(2);
                itemGstAmountDisplay.value = gstAmount.toFixed(2);
                totalPriceDisplay.value = totalAmount.toFixed(2);

                updateOverallTotals();
            }

            function updateOverallTotals() {
                let totalDiscount = 0;
                let totalGst = 0;
                let grandTotal = 0;

                document.querySelectorAll('.po-item-row').forEach(row => {
                    totalDiscount += parseFloat(row.querySelector('.item-disc-amount-display').value) || 0;
                    totalGst += parseFloat(row.querySelector('.item-gst-amount-display').value) || 0;
                    grandTotal += parseFloat(row.querySelector('.total-price-display').value) || 0;
                });

                if (totalDiscountAmountDisplay) totalDiscountAmountDisplay.value = totalDiscount.toFixed(2);
                if (totalGstAmountDisplay) totalGstAmountDisplay.value = totalGst.toFixed(2);
                if (grandTotalDisplay) grandTotalDisplay.value = grandTotal.toFixed(2);
                // Mapped amount is not present in ReOrder view, so no need to update mappedAmountHidden
            }

            function setupItemRowEvents(itemRow) {
                const quantityInput = itemRow.querySelector('.quantity-input');
                const unitPriceInput = itemRow.querySelector('.unit-price-input');
                const gstRateInput = itemRow.querySelector('.gst-rate-input');
                const discRadios = itemRow.querySelectorAll('.disc-radio');
                const discRateInput = itemRow.querySelector('.disc-rate-input');
                const discAmountInput = itemRow.querySelector('.item-disc-amount-display');

                // Quantity and GST events
                if (quantityInput) quantityInput.addEventListener('input', () => calculateItemTotalPrice(itemRow));
                if (gstRateInput) gstRateInput.addEventListener('input', () => calculateItemTotalPrice(itemRow));
                if (gstRateInput) gstRateInput.addEventListener('blur', () => calculateItemTotalPrice(itemRow));

                // Unit Price events, including validation
                if (unitPriceInput) {
                    unitPriceInput.addEventListener('input', () => validateUnitPrice(itemRow));
                    unitPriceInput.addEventListener('blur', () => validateUnitPrice(itemRow));
                }

                // Discount logic setup
                discRadios.forEach(radio => {
                    radio.addEventListener('change', () => updateDiscountFields(itemRow));
                });
                discRateInput.addEventListener('input', () => calculateDiscountValues(itemRow));
                discAmountInput.addEventListener('input', () => calculateDiscountValues(itemRow));
                discRateInput.addEventListener('blur', () => calculateDiscountValues(itemRow));
                discAmountInput.addEventListener('blur', () => calculateDiscountValues(itemRow));

                // Initial discount setup for pre-filled data
                updateDiscountFields(itemRow);
                calculateItemTotalPrice(itemRow); // Initial calculation
            }

            // --- Initialization ---

            if (vendorSelect) {
                vendorSelect.addEventListener('change', handleSupplierChange);
                if (@Model.SupplierId.ToString().ToLower() !== '0' && @Model.SupplierId.ToString().ToLower() !== '') {
                    // This checks if a SupplierId is pre-selected (which it should be for ReOrder)
                    handleSupplierChange();
                }
            }

            if (dateContainer && dateInput) {
                dateContainer.addEventListener('click', function () {
                    dateInput.showPicker();
                });
            }

            document.querySelectorAll('.po-item-row').forEach(setupItemRowEvents);
            updateOverallTotals();
        });
    </script>
}