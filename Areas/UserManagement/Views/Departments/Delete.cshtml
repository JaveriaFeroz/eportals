@model ProcureToPay.Areas.UserManagement.Models.Department

@{
    ViewData["Title"] = "Delete Department";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h1>Delete Department</h1>

    <h3>Are you sure you want to delete this?</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DepartmentName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.DepartmentName)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DepartmentCode)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.DepartmentCode)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.IsActive)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.IsActive)
            </dd>
        </dl>

        <form asp-area="UserManagement" asp-controller="Departments" asp-action="DeleteConfirmed" asp-route-id="@Model?.DepartmentId" method="post">
            <input type="hidden" asp-for="DepartmentId" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-area="UserManagement" asp-controller="Departments" asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>