@* This partial defines the modal structures and JavaScript logic for Services. *@

<div class="modal fade" id="serviceEditModal" tabindex="-1" aria-labelledby="serviceEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="serviceEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Service
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="serviceEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="serviceDetailsModal" tabindex="-1" aria-labelledby="serviceDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="serviceDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Service Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="serviceDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="serviceDeleteModal" tabindex="-1" aria-labelledby="serviceDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="serviceDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Service: <span id="deleteModalServiceName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete service <strong id="deleteModalServiceNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="serviceDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Service Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachServiceEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('serviceEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleServiceEditFormSubmit);
                editForm.addEventListener('submit', handleServiceEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #serviceEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for service form.");
                }
            } else {
                console.warn("#serviceEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Service Edit form submission (AJAX) ---
        async function handleServiceEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for service form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const serviceEditModalBodyElement = document.getElementById('serviceEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const serviceEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('serviceEditModal'));
                        if (serviceEditModalInstance) {
                            serviceEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Service updated successfully!");
                        } else {
                            console.log("Service update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Service update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const serviceEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('serviceEditModal'));
                        if (serviceEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                serviceEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    serviceEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Service validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachServiceEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during service form submission:', error);
                const serviceEditModalBodyElement = document.getElementById('serviceEditModalBody');
                if (serviceEditModalBodyElement) {
                     serviceEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Service Delete form submission (AJAX) ---
        async function handleServiceDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete service with an error.");
                    } else {
                        console.error("Service delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Service deleted successfully!");
                    } else {
                        console.log("Service deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete service.");
                    } else {
                        console.error("Service delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during service delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during service deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during service deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Service Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Service"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Service', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('serviceEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('serviceEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachServiceEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Service Modal Opener
        document.querySelectorAll('.details-btn[data-page="Service"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Service', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('serviceDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('serviceDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Service Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Service"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const serviceName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Service', 'Delete', id);

                document.getElementById('deleteModalServiceName').textContent = serviceName;
                document.getElementById('deleteModalServiceNameConfirm').textContent = serviceName;

                const deleteForm = document.getElementById('serviceDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleServiceDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleServiceDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('serviceDeleteModal')).show();
            });
        });
    });
</script>