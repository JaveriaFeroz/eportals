@* This partial defines the modal structures and JavaScript logic for PaymentModes. *@

<div class="modal fade" id="paymentModeEditModal" tabindex="-1" aria-labelledby="paymentModeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="paymentModeEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit PaymentMode
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="paymentModeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModeDetailsModal" tabindex="-1" aria-labelledby="paymentModeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="paymentModeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> PaymentMode Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="paymentModeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModeDeleteModal" tabindex="-1" aria-labelledby="paymentModeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="paymentModeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete PaymentMode: <span id="deleteModalPaymentModeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete paymentMode <strong id="deleteModalPaymentModeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="paymentModeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the PaymentMode Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachPaymentModeEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('paymentModeEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handlePaymentModeEditFormSubmit);
                editForm.addEventListener('submit', handlePaymentModeEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #paymentModeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for paymentMode form.");
                }
            } else {
                console.warn("#paymentModeEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the PaymentMode Edit form submission (AJAX) ---
        async function handlePaymentModeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for paymentMode form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const paymentModeEditModalBodyElement = document.getElementById('paymentModeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const paymentModeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('paymentModeEditModal'));
                        if (paymentModeEditModalInstance) {
                            paymentModeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "PaymentMode updated successfully!");
                        } else {
                            console.log("PaymentMode update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("PaymentMode update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const paymentModeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('paymentModeEditModal'));
                        if (paymentModeEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                paymentModeEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    paymentModeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("PaymentMode validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachPaymentModeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during paymentMode form submission:', error);
                const paymentModeEditModalBodyElement = document.getElementById('paymentModeEditModalBody');
                if (paymentModeEditModalBodyElement) {
                     paymentModeEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for PaymentMode Delete form submission (AJAX) ---
        async function handlePaymentModeDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete paymentMode with an error.");
                    } else {
                        console.error("PaymentMode delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "PaymentMode deleted successfully!");
                    } else {
                        console.log("PaymentMode deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete paymentMode.");
                    } else {
                        console.error("PaymentMode delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during paymentMode delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during paymentMode deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during paymentMode deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit PaymentMode Modal Opener
        document.querySelectorAll('.edit-btn[data-page="PaymentMode"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'PaymentMode', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('paymentModeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('paymentModeEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachPaymentModeEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details PaymentMode Modal Opener
        document.querySelectorAll('.details-btn[data-page="PaymentMode"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'PaymentMode', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('paymentModeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('paymentModeDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete PaymentMode Modal Opener
        document.querySelectorAll('.delete-btn[data-page="PaymentMode"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const paymentModeName = this.getAttribute('data-name');
                const url = getUrl('Master', 'PaymentMode', 'Delete', id);

                document.getElementById('deleteModalPaymentModeName').textContent = paymentModeName;
                document.getElementById('deleteModalPaymentModeNameConfirm').textContent = paymentModeName;

                const deleteForm = document.getElementById('paymentModeDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handlePaymentModeDeleteFormSubmit);
                deleteForm.addEventListener('submit', handlePaymentModeDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('paymentModeDeleteModal')).show();
            });
        });
    });
</script>