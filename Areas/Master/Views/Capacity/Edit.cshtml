@model ProcureToPay.Areas.Master.ViewModels.CapacityViewModel

<div class="modal-body">
    <form id="regionEditForm" method="post" asp-action="Edit" asp-controller="Capacity" asp-area="Master"
          data-area="Master" data-controller="Region">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CapacityId" /> @* Hidden field for the ID *@

        <div class="mb-3">
            <label asp-for="CapacityName" class="form-label">Capacity Name <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-globe-americas"></i></span>
                <input asp-for="CapacityName" class="form-control" /> 
            </div>
            <span asp-validation-for="CapacityName" class="text-danger"></span>
        </div>



        <div class="mb-3">
            <label class="form-label"><i class="fas fa-power-off me-2"></i> Status</label>
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label class="form-check-label" asp-for="IsActive">Active</label>
                <input type="hidden" asp-for="IsActive" value="false" />
            </div>
            <span asp-validation-for="IsActive" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1" style="color: white;"></i> Save Capacity
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}