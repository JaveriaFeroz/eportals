@model ProcureToPay.Areas.Master.ViewModels.SupplierViewModel

<div class="modal-body">
    <div class="row mb-3">
        <div class="col-md-4 text-muted">Supplier Name:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-truck"></i></span>
                <input type="text" class="form-control" value="@Model.SupplierName" readonly />
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">Supplier Type:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-tag"></i></span>
                <input type="text" class="form-control" value="@Model.SupplierTypeName" readonly />
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">Address:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-map-marker-alt"></i></span>
                <textarea class="form-control" rows="2" readonly>@(Model.Address ?? "-")</textarea>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">City:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                <input type="text" class="form-control" value="@(Model.CityName ?? "-")" readonly />
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">NTN:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-id-card"></i></span>
                <input type="text" class="form-control" value="@(Model.NTN ?? "-")" readonly />
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">SC Rate:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-percent"></i></span>
                <input type="text" class="form-control" value="@Model.SCRate" readonly />
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">Contact Person:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-user"></i></span>
                <input type="text" class="form-control" value="@(Model.ContactName ?? "-")" readonly />
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">Email:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-envelope"></i></span>
                <input type="text" class="form-control" value="@(Model.Email ?? "-")" readonly />
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">Phone No:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-phone"></i></span>
                <input type="text" class="form-control" value="@(Model.PhoneNo ?? "-")" readonly />
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">Mobile No:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-mobile-alt"></i></span>
                <input type="text" class="form-control" value="@(Model.MobileNo ?? "-")" readonly />
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">Fax No:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-fax"></i></span>
                <input type="text" class="form-control" value="@(Model.FaxNo ?? "-")" readonly />
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">Website URL:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-globe"></i></span>
                <input type="text" class="form-control" value="@(Model.URL ?? "-")" readonly />
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">Control Supplier ID:</div>
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-key"></i></span>
                <input type="text" class="form-control" value="@(Model.ControlSupplierId ?? "-")" readonly />
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 text-muted">Status:</div>
        <div class="col-md-8">
            <div class="form-check form-switch mt-2">
                <input type="checkbox" class="form-check-input" @(Model.IsActive ? "checked" : "") disabled />
                <label class="form-check-label">@(Model.IsActive ? "Active" : "Inactive")</label>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <h6 class="mb-3" style="color: #092963;"><i class="fas fa-history me-2"></i> Audit Information</h6>

    <div class="row mb-2">
        <div class="col-md-4 text-muted">Created By:</div>
        <div class="col-md-8">@Model.CreatedBy</div>
    </div>
    <div class="row mb-2">
        <div class="col-md-4 text-muted">Created On:</div>
        <div class="col-md-8">@(Model.CreatedOn?.ToString("dd MMM,yyyy hh:mm tt") ?? "N/A")</div>
    </div>

    <div class="row mb-2">
        <div class="col-md-4 text-muted">Updated By:</div>
        <div class="col-md-8">@(Model.UpdatedBy ?? "N/A")</div>
    </div>
    <div class="row mb-2">
        <div class="col-md-4 text-muted">Updated On:</div>
        <div class="col-md-8">@(Model.UpdatedOn?.ToString("dd MMM,yyyy hh:mm tt") ?? "N/A")</div>
    </div>

    <div class="d-flex justify-content-end mt-4">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Close</button>
    </div>
</div>