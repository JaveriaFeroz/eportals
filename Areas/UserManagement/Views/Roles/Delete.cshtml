@model ProcureToPay.Areas.UserManagement.Models.Role

@{
    ViewData["Title"] = "Delete Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h1>Delete Role</h1>

    <div class="alert alert-danger">
        <h3>Are you sure you want to delete this role?</h3>
        <p>Deleting a role may affect users assigned to this role.</p>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Role Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Hierarchy Level</dt>
                <dd class="col-sm-9">@Model.HierarchyLevel</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                            <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                            <span class="badge bg-danger">Inactive</span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>