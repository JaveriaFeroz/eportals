@model ProcureToPay.Areas.Master.ViewModels.AssetCreateEditViewModel

<div class="modal-body">
    <form id="assetEditForm" method="post" asp-action="Edit" asp-controller="Asset" asp-area="Master">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        @* Hidden input for the AssetId is crucial for the update *@
        <input type="hidden" asp-for="Asset.AssetId" />

        @* ==== Card 1: Basic Information ==== *@
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-info-circle me-2"></i> Basic Information</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Asset.AssetNo" class="form-label">Asset Number <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-hashtag"></i></span>
                            <input asp-for="Asset.AssetNo" class="form-control" />
                        </div>
                        <span asp-validation-for="Asset.AssetNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Asset.AssetTypeId" class="form-label">Asset Type <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-tags"></i></span>
                            <select asp-for="Asset.AssetTypeId" class="form-select" asp-items="@Model.AssetTypes">
                                <option value="">-- Select Asset Type --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.AssetTypeId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Asset.Model" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-cube"></i></span>
                            <input asp-for="Asset.Model" class="form-control" />
                        </div>
                        <span asp-validation-for="Asset.Model" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Asset.FACode" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-barcode"></i></span>
                            <input asp-for="Asset.FACode" class="form-control" />
                        </div>
                        <span asp-validation-for="Asset.FACode" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        @* ==== Card 2: Additional Details ==== *@
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-cogs me-2"></i> Additional Details</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.PurchaseDate" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-calendar-alt"></i></span>
                            <input asp-for="Asset.PurchaseDate" class="form-control" type="date" />
                        </div>
                        <span asp-validation-for="Asset.PurchaseDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.CityId" class="form-label">City <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                            <select asp-for="Asset.CityId" class="form-select" asp-items="@Model.Cities">
                                <option value="">-- Select City --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.CityId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.CompanyId" class="form-label">Company <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                            <select asp-for="Asset.CompanyId" class="form-select" asp-items="@Model.Companies">
                                <option value="">-- Select Company --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.CompanyId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.SupplierId" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-truck"></i></span>
                            <select asp-for="Asset.SupplierId" class="form-select" asp-items="@Model.Suppliers">
                                <option value="">-- Select Supplier --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.SupplierId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.ClientId" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-user-tie"></i></span>
                            <select asp-for="Asset.ClientId" class="form-select" asp-items="@Model.Clients">
                                <option value="">-- Select Client --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.ClientId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.StartKMs" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-tachometer-alt"></i></span>
                            <input asp-for="Asset.StartKMs" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Asset.StartKMs" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.KMs" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-road"></i></span>
                            <input asp-for="Asset.KMs" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Asset.KMs" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.CapacityId" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-gas-pump"></i></span>
                            <select asp-for="Asset.CapacityId" class="form-select" asp-items="@Model.Capacities">
                                <option value="">-- Select Capacity --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.CapacityId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.MakeId" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-industry"></i></span>
                            <select asp-for="Asset.MakeId" class="form-select" asp-items="@Model.Makes">
                                <option value="">-- Select Make --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.MakeId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.LeaseTypeId" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-file-signature"></i></span>
                            <select asp-for="Asset.LeaseTypeId" class="form-select" asp-items="@Model.LeaseTypes">
                                <option value="">-- Select Lease Type --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.LeaseTypeId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.DriverId1" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-user"></i></span>
                            <select asp-for="Asset.DriverId1" class="form-select" asp-items="@Model.Drivers">
                                <option value="">-- Select Driver 1 --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.DriverId1" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.DriverId2" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-user"></i></span>
                            <select asp-for="Asset.DriverId2" class="form-select" asp-items="@Model.Drivers">
                                <option value="">-- Select Driver 2 --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.DriverId2" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.TrailerId" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-trailer"></i></span>
                            <select asp-for="Asset.TrailerId" class="form-select" asp-items="@Model.Trailers">
                                <option value="">-- Select Trailer --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.TrailerId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.StatusId" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-check-circle"></i></span>
                            <select asp-for="Asset.StatusId" class="form-select" asp-items="@Model.AssetStatuses">
                                <option value="">-- Select Status --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.StatusId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Asset.BaseId" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-flag"></i></span>
                            <select asp-for="Asset.BaseId" class="form-select" asp-items="@Model.Bases">
                                <option value="">-- Select Base --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Asset.BaseId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 d-flex align-items-center pt-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Asset.IsActive">
                            <label class="form-check-label" asp-for="Asset.IsActive">Is Active</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1"></i> Save Changes
            </button>
        </div>
    </form>
</div>