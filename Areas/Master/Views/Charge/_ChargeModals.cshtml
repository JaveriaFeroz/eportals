@* This partial defines the modal structures and JavaScript logic for Charges. *@

<div class="modal fade" id="chargeEditModal" tabindex="-1" aria-labelledby="chargeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="chargeEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Charge
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="chargeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="chargeDetailsModal" tabindex="-1" aria-labelledby="chargeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="chargeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Charge Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="chargeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="chargeDeleteModal" tabindex="-1" aria-labelledby="chargeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="chargeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Charge: <span id="deleteModalChargeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete charge <strong id="deleteModalChargeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="chargeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Charge Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachChargeEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('chargeEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleChargeEditFormSubmit);
                editForm.addEventListener('submit', handleChargeEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #chargeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for charge form.");
                }
            } else {
                console.warn("#chargeEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Charge Edit form submission (AJAX) ---
        async function handleChargeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for charge form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const chargeEditModalBodyElement = document.getElementById('chargeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const chargeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('chargeEditModal'));
                        if (chargeEditModalInstance) {
                            chargeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Charge updated successfully!");
                        } else {
                            console.log("Charge update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Charge update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const chargeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('chargeEditModal'));
                        if (chargeEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                chargeEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    chargeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Charge validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachChargeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during charge form submission:', error);
                const chargeEditModalBodyElement = document.getElementById('chargeEditModalBody');
                if (chargeEditModalBodyElement) {
                     chargeEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Charge Delete form submission (AJAX) ---
        async function handleChargeDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete charge with an error.");
                    } else {
                        console.error("Charge delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Charge deleted successfully!");
                    } else {
                        console.log("Charge deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete charge.");
                    } else {
                        console.error("Charge delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during charge delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during charge deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during charge deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Charge Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Charge"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Charge', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('chargeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('chargeEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachChargeEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Charge Modal Opener
        document.querySelectorAll('.details-btn[data-page="Charge"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Charge', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('chargeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('chargeDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Charge Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Charge"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const chargeName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Charge', 'Delete', id);

                document.getElementById('deleteModalChargeName').textContent = chargeName;
                document.getElementById('deleteModalChargeNameConfirm').textContent = chargeName;

                const deleteForm = document.getElementById('chargeDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleChargeDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleChargeDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('chargeDeleteModal')).show();
            });
        });
    });
</script>