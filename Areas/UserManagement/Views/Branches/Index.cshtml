@model IEnumerable<ProcureToPay.Areas.UserManagement.Models.Branch>
@{
    ViewData["Title"] = "Branches";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/scripts.js" asp-append-version="true"></script>

<div class="container-fluid px-4 py-4">
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Branches</a></li>
        <li class="breadcrumb-item active">Index</li>
    </ol>
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963; display: flex; justify-content: space-between; align-items: center;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-code-branch me-2"></i> Branches
            </h5>
        </div>
        <div class="card-body">
            <div class="search-container mb-3">
                <div class="row g-3 align-items-center">
                    <div class="col-2">
                        <div class="input-group">
                            <span class="input-group-text" id="codeSearchIcon">
                                <i class="fas fa-filter" style="font-size: 1rem;"></i>
                            </span>
                            <input type="text" class="form-control form-control-sm underline-input" id="codeSearch" placeholder="Branch Code">
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="input-group">
                            <span class="input-group-text" id="nameSearchIcon">
                                <i class="fas fa-filter" style="font-size: 1rem;"></i>
                            </span>
                            <input type="text" class="form-control form-control-sm underline-input" id="nameSearch" placeholder="Branch Name">
                        </div>
                    </div>
                    <div class="col-2">
                        <select class="form-select form-select-sm underline-input" id="statusSearch">
                            <option value="">All</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <div class="col-1">
                        <button class="btn btn-outline-secondary clear-button d-flex justify-content-between align-items-center"
                                style="padding: 0.5rem 1rem; font-size: 1rem; width: 100%; min-width: 120px;">
                            <span>Clear</span>
                            <i class="fas fa-times" style="font-size: 1rem;"></i>
                        </button>
                    </div>

                    <div class="col-auto ms-auto">
                        <div class="create-user-container">
                            <button class="action-button create-user-text"
                                    data-url="@Url.Action("Create", "Branches", new { area = "UserManagement" })"
                                    style="background-color: #092963; transition: background-color 0.3s ease;">
                                <i class="fas fa-plus"></i>
                                <span class="button-text"> Create Branch</span>
                            </button>
                            <a href="#" class="btn btn-sm create-user-icon">
                                <i class="fas fa-plus"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row fw-bold bg-light border-bottom py-3 px-2 text-secondary">
                <div class="col-2 d-flex align-items-center">
                    <i class="fas fa-barcode me-1 text-dark"></i> BRANCH CODE
                </div>
                <div class="col-3 d-flex align-items-center">
                    <i class="fas fa-code-branch me-1 text-dark"></i> BRANCH NAME
                </div>
                <div class="col-1 text-center d-flex align-items-center justify-content-center">
                    <i class="fas fa-toggle-on me-1 text-dark"></i> STATUS
                </div>
                <div class="col-6 text-center d-flex align-items-center justify-content-center">
                    <i class="fas fa-cogs me-1 text-dark"></i> ACTIONS
                </div>
            </div>
            @foreach (var branch in Model)
            {
                <div class="row align-items-center border-bottom py-3 px-2" tabindex="0">
                    <div class="col-2 fw-bold">
                        @branch.BranchCode
                    </div>
                    <div class="col-3 text-start">
                        @branch.BranchName
                    </div>
                    <div class="col-1 text-center">
                        @if (branch.IsActive)
                        {
                            <span class="badge status-badge">Active</span>
                        }
                        else
                        {
                            <span class="badge status-badge bg-danger">Inactive</span>
                        }
                    </div>

                    <div class="col-6 d-flex justify-content-center gap-1">
                        <!-- Edit Button with Modal Trigger -->
                        <button type="button" class="btn btn-sm text-warning branch-edit-btn action-btn" title="Edit"
                                data-id="@branch.BranchId" data-area="UserManagement" data-page="Branches">
                            <i class="fas fa-edit icon-warning"></i>
                        </button>

                        <!-- Details Button with Modal Trigger -->
                        <button type="button" class="btn btn-sm text-info branch-details-btn action-btn" title="Details"
                                data-id="@branch.BranchId" data-area="UserManagement" data-page="Branches">
                            <i class="fas fa-info-circle icon-info"></i>
                        </button>


                        <!-- Delete Button with Modal Trigger -->
                        <button type="button" class="btn btn-sm text-danger branch-delete-btn action-btn" title="Delete"
                                data-id="@branch.BranchId" data-area="UserManagement" data-page="Branches"
                                data-branch-name="@branch.BranchName">
                            <i class="fas fa-trash-alt icon-danger"></i>
                        </button>
                    </div>


                </div>
            }
            <div class="d-flex justify-content-end mt-3">
                <a class="btn btn-light text-primary" href="/Home/Index">
                    <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                </a>
            </div>
        </div>
        @await Html.PartialAsync("BranchModals")
    </div>
</div>
