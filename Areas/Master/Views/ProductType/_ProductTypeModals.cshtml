@* This partial defines the modal structures and contains the JavaScript logic for them. *@

<div class="modal fade" id="productTypeEditModal" tabindex="-1" aria-labelledby="productTypeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="productTypeEditModalLabel">
                    <i class="fas fa-edit me-2"></i> Edit ProductType
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="productTypeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="productTypeDetailsModal" tabindex="-1" aria-labelledby="productTypeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="productTypeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> ProductType Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="productTypeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="productTypeDeleteModal" tabindex="-1" aria-labelledby="productTypeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="productTypeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete ProductType: <span id="deleteModalProductTypeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete productType <strong id="deleteModalProductTypeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="productTypeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- Function to attach/re-attach form submission handler for the ProductType Edit modal ---
        function attachProductTypeEditFormSubmissionHandler() {
            const editForm = document.getElementById('productTypeEditForm'); // Target the productType edit form
            if (editForm) {
                // Ensure no duplicate listeners by removing any existing ones
                editForm.removeEventListener('submit', handleProductTypeEditFormSubmit);
                editForm.addEventListener('submit', handleProductTypeEditFormSubmit);

                // Re-parse client-side validation for dynamically loaded content
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #productTypeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for productType form.");
                }
            } else {
                console.warn("#productTypeEditForm not found when trying to attach handler.");
            }
        }

        // --- Handler for the ProductType Edit form submission (AJAX) ---
        async function handleProductTypeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for productType form. Not sending AJAX request.");
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type"); // Get content type to distinguish JSON/HTML
                const productTypeEditModalBodyElement = document.getElementById('productTypeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    // This is a JSON response (success or specific error)
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        // Success: close modal, show message, reload page
                        const productTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('productTypeEditModal'));
                        if (productTypeEditModalInstance) {
                            productTypeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') { // Check if Toastr is available
                            toastr.success(jsonResponse.message || "ProductType updated successfully!");
                        } else {
                            console.log("ProductType update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload(); // Reload to reflect changes
                    } else {
                        // JSON error: show message, keep modal open or close based on error type
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("ProductType update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        // For critical errors (e.g., productType not found), you might want to close the modal
                        const productTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('productTypeEditModal'));
                        if (productTypeEditModalInstance) {
                            productTypeEditModalInstance.hide(); // Hide for critical errors
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    productTypeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("ProductType validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    setTimeout(attachProductTypeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during productType form submission:', error);
                productTypeEditModalBodyElement.innerHTML = `
                    <div class="alert alert-danger" role="alert">
                        A network or unexpected error occurred. Please check your connection and try again.
                    </div>
                `;
            }
        }

        // --- Handler for ProductType Delete form submission (AJAX) ---
        async function handleProductTypeDeleteFormSubmit(event) {
            event.preventDefault(); // Stop default form submission
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                // Assuming delete always returns JSON from the controller
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    // Success: close modal, show message, reload page
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "ProductType deleted successfully!");
                    } else {
                        console.log("ProductType deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload(); // Reload page to reflect deletion
                } else {
                    // Error: show message
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete productType.");
                    } else {
                        console.error("ProductType delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during productType delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during productType deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during productType deletion. Please try again.");
                }
            }
        }


        // --- ProductType Modal Openers ---

        // Edit ProductType Modal Opener
        document.querySelectorAll('.edit-btn[data-page="ProductType"]').forEach(function (button) {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'ProductType', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('productTypeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('productTypeEditModal')).show();
                    setTimeout(attachProductTypeEditFormSubmissionHandler, 50);
                } catch (error) {
                    console.error('Error loading productType edit modal:', error);
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details ProductType Modal Opener
        document.querySelectorAll('.details-btn[data-page="ProductType"]').forEach(function (button) {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'ProductType', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('productTypeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('productTypeDetailsModal')).show();
                } catch (error) {
                    console.error('Error loading productType details modal:', error);
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete ProductType Modal Opener
        document.querySelectorAll('.delete-btn').forEach(function (button) {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const area = this.getAttribute('data-area');
                const page = this.getAttribute('data-page');
                const productTypeName = this.getAttribute('data-name'); // Corrected data attribute name, matches Razor now

                const url = getUrl(area, page, 'Delete', id);

                // If you want to display the productType name in the delete confirmation modal
                const deleteModalTypeNameSpan = document.getElementById('deleteModalTypeName');
                if (deleteModalTypeNameSpan) {
                    deleteModalTypeNameSpan.textContent = productTypeName;
                }
                const deleteModalTypeNameConfirmSpan = document.getElementById('deleteModalTypeNameConfirm');
                if (deleteModalTypeNameConfirmSpan) {
                    deleteModalTypeNameConfirmSpan.textContent = productTypeName;
                }

                document.getElementById('productTypeDeleteForm').setAttribute('action', url);
                new bootstrap.Modal(document.getElementById('productTypeDeleteModal')).show();
            });
        });
    }); // End DOMContentLoaded
</script>