@model List<ProcureToPay.Areas.UserManagement.ViewModels.RolePermissionSummaryViewModel>
@{
    ViewData["Title"] = "Role Permissions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary"><i class="fas fa-lock me-2"></i>Role Permissions</h2>
    </div>

    <div class="mb-4">
        <div class="btn-toolbar">
            <div class="btn-group me-2">
                <a href="@Url.Action("Compare", "RolePermissions", new { area = "UserManagement" })" class="btn btn-info">
                    <i class="fas fa-balance-scale me-1"></i> Compare Roles
                </a>
            </div>
            <div class="btn-group me-2">
                <a href="@Url.Action("CopyPermissions", "RolePermissions", new { area = "UserManagement" })" class="btn btn-primary">
                    <i class="fas fa-plus-circle me-1"></i> Create New Role Permissions
                </a>
            </div>
            <div class="btn-group">
                <a href="@Url.Action("CopyPermissions", "RolePermissions", new { area = "UserManagement" })" class="btn btn-secondary">
                    <i class="fas fa-copy me-1"></i> Copy Permissions
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-shield-alt me-2"></i> Available Roles
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="rolesTable">
                    <thead class="table-light">
                        <tr>
                            <th>Role Name</th>
                            <th>Description</th>
                            <th>Permission Count</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Role.Name</td>
                                <td>@item.Role.Description</td>
                                <td>
                                    <span class="badge bg-info">@item.PermissionCount permissions</span>
                                </td>
                                <td>
                                    <a href="@Url.Action("Manage", "RolePermissions", new { area = "UserManagement", id = item.Role.Id })" class="btn btn-sm btn-primary">
                                        <i class="fas fa-cog me-1"></i> Manage Permissions
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
  
    
    
    <script>

$(document).ready(function() {
    
    if ($.fn.DataTable) {
        $('#rolesTable').DataTable({
            "order": [[0, "asc"]],
            "pageLength": 10,
            "responsive": true,
            "language": {
                "search": "Search roles:",
                "zeroRecords": "No matching roles found"
            }
            
        });
    } else {
        console.error("DataTables library is not loaded");
    }

    // Auto-dismiss alerts after 5 seconds
    setTimeout(function() {
        $('.alert').alert('close');
    }, 5000);
});

    </script>
}


