@* This partial defines the modal structures and JavaScript logic for PurchaseNatures. *@

<div class="modal fade" id="purchaseNatureEditModal" tabindex="-1" aria-labelledby="purchaseNatureEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="purchaseNatureEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Purchase Nature
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="purchaseNatureEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="purchaseNatureDetailsModal" tabindex="-1" aria-labelledby="purchaseNatureDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="purchaseNatureDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Purchase Nature Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="purchaseNatureDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="purchaseNatureDeleteModal" tabindex="-1" aria-labelledby="purchaseNatureDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="purchaseNatureDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Purchase Nature: <span id="deleteModalPurchaseNatureName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete purchaseNature <strong id="deleteModalPurchaseNatureNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="purchaseNatureDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the PurchaseNature Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachPurchaseNatureEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('purchaseNatureEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handlePurchaseNatureEditFormSubmit);
                editForm.addEventListener('submit', handlePurchaseNatureEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #purchaseNatureEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for purchaseNature form.");
                }
            } else {
                console.warn("#purchaseNatureEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the PurchaseNature Edit form submission (AJAX) ---
        async function handlePurchaseNatureEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for purchaseNature form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const purchaseNatureEditModalBodyElement = document.getElementById('purchaseNatureEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const purchaseNatureEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('purchaseNatureEditModal'));
                        if (purchaseNatureEditModalInstance) {
                            purchaseNatureEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "PurchaseNature updated successfully!");
                        } else {
                            console.log("PurchaseNature update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("PurchaseNature update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const purchaseNatureEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('purchaseNatureEditModal'));
                        if (purchaseNatureEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                purchaseNatureEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    purchaseNatureEditModalBodyElement.innerHTML = responseHtml;
                    console.log("PurchaseNature validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachPurchaseNatureEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during purchaseNature form submission:', error);
                const purchaseNatureEditModalBodyElement = document.getElementById('purchaseNatureEditModalBody');
                if (purchaseNatureEditModalBodyElement) {
                     purchaseNatureEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for PurchaseNature Delete form submission (AJAX) ---
        async function handlePurchaseNatureDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete purchaseNature with an error.");
                    } else {
                        console.error("PurchaseNature delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "PurchaseNature deleted successfully!");
                    } else {
                        console.log("PurchaseNature deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete purchaseNature.");
                    } else {
                        console.error("PurchaseNature delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during purchaseNature delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during purchaseNature deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during purchaseNature deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit PurchaseNature Modal Opener
        document.querySelectorAll('.edit-btn[data-page="PurchaseNature"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'PurchaseNature', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('purchaseNatureEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('purchaseNatureEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachPurchaseNatureEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details PurchaseNature Modal Opener
        document.querySelectorAll('.details-btn[data-page="PurchaseNature"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'PurchaseNature', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('purchaseNatureDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('purchaseNatureDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete PurchaseNature Modal Opener
        document.querySelectorAll('.delete-btn[data-page="PurchaseNature"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const purchaseNatureName = this.getAttribute('data-name');
                const url = getUrl('Master', 'PurchaseNature', 'Delete', id);

                document.getElementById('deleteModalPurchaseNatureName').textContent = purchaseNatureName;
                document.getElementById('deleteModalPurchaseNatureNameConfirm').textContent = purchaseNatureName;

                const deleteForm = document.getElementById('purchaseNatureDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handlePurchaseNatureDeleteFormSubmit);
                deleteForm.addEventListener('submit', handlePurchaseNatureDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('purchaseNatureDeleteModal')).show();
            });
        });
    });
</script>