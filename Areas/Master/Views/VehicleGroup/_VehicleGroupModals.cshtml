@* This partial defines the modal structures and JavaScript logic for VehicleGroups. *@

<div class="modal fade" id="vehicleGroupEditModal" tabindex="-1" aria-labelledby="vehicleGroupEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="vehicleGroupEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Vehicle Group
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="vehicleGroupEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="vehicleGroupDetailsModal" tabindex="-1" aria-labelledby="vehicleGroupDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="vehicleGroupDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Vehicle Group Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="vehicleGroupDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="vehicleGroupDeleteModal" tabindex="-1" aria-labelledby="vehicleGroupDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="vehicleGroupDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Vehicle Group: <span id="deleteModalVehicleGroupName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete vehicleGroup <strong id="deleteModalVehicleGroupNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="vehicleGroupDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the VehicleGroup Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachVehicleGroupEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('vehicleGroupEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleVehicleGroupEditFormSubmit);
                editForm.addEventListener('submit', handleVehicleGroupEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #vehicleGroupEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for vehicleGroup form.");
                }
            } else {
                console.warn("#vehicleGroupEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the VehicleGroup Edit form submission (AJAX) ---
        async function handleVehicleGroupEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for vehicleGroup form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const vehicleGroupEditModalBodyElement = document.getElementById('vehicleGroupEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const vehicleGroupEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('vehicleGroupEditModal'));
                        if (vehicleGroupEditModalInstance) {
                            vehicleGroupEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "VehicleGroup updated successfully!");
                        } else {
                            console.log("VehicleGroup update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("VehicleGroup update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const vehicleGroupEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('vehicleGroupEditModal'));
                        if (vehicleGroupEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                vehicleGroupEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    vehicleGroupEditModalBodyElement.innerHTML = responseHtml;
                    console.log("VehicleGroup validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachVehicleGroupEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during vehicleGroup form submission:', error);
                const vehicleGroupEditModalBodyElement = document.getElementById('vehicleGroupEditModalBody');
                if (vehicleGroupEditModalBodyElement) {
                     vehicleGroupEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for VehicleGroup Delete form submission (AJAX) ---
        async function handleVehicleGroupDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete vehicleGroup with an error.");
                    } else {
                        console.error("VehicleGroup delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "VehicleGroup deleted successfully!");
                    } else {
                        console.log("VehicleGroup deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete vehicleGroup.");
                    } else {
                        console.error("VehicleGroup delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during vehicleGroup delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during vehicleGroup deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during vehicleGroup deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit VehicleGroup Modal Opener
        document.querySelectorAll('.edit-btn[data-page="VehicleGroup"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'VehicleGroup', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('vehicleGroupEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('vehicleGroupEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachVehicleGroupEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details VehicleGroup Modal Opener
        document.querySelectorAll('.details-btn[data-page="VehicleGroup"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'VehicleGroup', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('vehicleGroupDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('vehicleGroupDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete VehicleGroup Modal Opener
        document.querySelectorAll('.delete-btn[data-page="VehicleGroup"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const vehicleGroupName = this.getAttribute('data-name');
                const url = getUrl('Master', 'VehicleGroup', 'Delete', id);

                document.getElementById('deleteModalVehicleGroupName').textContent = vehicleGroupName;
                document.getElementById('deleteModalVehicleGroupNameConfirm').textContent = vehicleGroupName;

                const deleteForm = document.getElementById('vehicleGroupDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleVehicleGroupDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleVehicleGroupDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('vehicleGroupDeleteModal')).show();
            });
        });
    });
</script>