@* This partial defines the modal structures and JavaScript logic for WarningTypes. *@

<div class="modal fade" id="warningTypeEditModal" tabindex="-1" aria-labelledby="warningTypeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="warningTypeEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit WarningType
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="warningTypeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="warningTypeDetailsModal" tabindex="-1" aria-labelledby="warningTypeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="warningTypeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> WarningType Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="warningTypeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="warningTypeDeleteModal" tabindex="-1" aria-labelledby="warningTypeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="warningTypeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete WarningType: <span id="deleteModalWarningTypeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete warningType <strong id="deleteModalWarningTypeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="warningTypeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the WarningType Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachWarningTypeEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('warningTypeEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleWarningTypeEditFormSubmit);
                editForm.addEventListener('submit', handleWarningTypeEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #warningTypeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for warningType form.");
                }
            } else {
                console.warn("#warningTypeEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the WarningType Edit form submission (AJAX) ---
        async function handleWarningTypeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for warningType form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const warningTypeEditModalBodyElement = document.getElementById('warningTypeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const warningTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('warningTypeEditModal'));
                        if (warningTypeEditModalInstance) {
                            warningTypeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "WarningType updated successfully!");
                        } else {
                            console.log("WarningType update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("WarningType update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const warningTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('warningTypeEditModal'));
                        if (warningTypeEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                warningTypeEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    warningTypeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("WarningType validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachWarningTypeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during warningType form submission:', error);
                const warningTypeEditModalBodyElement = document.getElementById('warningTypeEditModalBody');
                if (warningTypeEditModalBodyElement) {
                     warningTypeEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for WarningType Delete form submission (AJAX) ---
        async function handleWarningTypeDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete warningType with an error.");
                    } else {
                        console.error("WarningType delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "WarningType deleted successfully!");
                    } else {
                        console.log("WarningType deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete warningType.");
                    } else {
                        console.error("WarningType delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during warningType delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during warningType deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during warningType deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit WarningType Modal Opener
        document.querySelectorAll('.edit-btn[data-page="WarningType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'WarningType', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('warningTypeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('warningTypeEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachWarningTypeEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details WarningType Modal Opener
        document.querySelectorAll('.details-btn[data-page="WarningType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'WarningType', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('warningTypeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('warningTypeDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete WarningType Modal Opener
        document.querySelectorAll('.delete-btn[data-page="WarningType"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const warningTypeName = this.getAttribute('data-name');
                const url = getUrl('Master', 'WarningType', 'Delete', id);

                document.getElementById('deleteModalWarningTypeName').textContent = warningTypeName;
                document.getElementById('deleteModalWarningTypeNameConfirm').textContent = warningTypeName;

                const deleteForm = document.getElementById('warningTypeDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleWarningTypeDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleWarningTypeDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('warningTypeDeleteModal')).show();
            });
        });
    });
</script>