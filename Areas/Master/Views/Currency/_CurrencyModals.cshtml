@* This partial defines the modal structures and JavaScript logic for Currencies. *@

<div class="modal fade" id="currencyEditModal" tabindex="-1" aria-labelledby="currencyEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="currencyEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Currency
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="currencyEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="currencyDetailsModal" tabindex="-1" aria-labelledby="currencyDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="currencyDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Currency Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="currencyDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="currencyDeleteModal" tabindex="-1" aria-labelledby="currencyDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="currencyDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Currency: <span id="deleteModalCurrencyName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete currency <strong id="deleteModalCurrencyNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="currencyDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Currency Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachCurrencyEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('currencyEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleCurrencyEditFormSubmit);
                editForm.addEventListener('submit', handleCurrencyEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #currencyEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for currency form.");
                }
            } else {
                console.warn("#currencyEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Currency Edit form submission (AJAX) ---
        async function handleCurrencyEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for currency form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const currencyEditModalBodyElement = document.getElementById('currencyEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const currencyEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('currencyEditModal'));
                        if (currencyEditModalInstance) {
                            currencyEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Currency updated successfully!");
                        } else {
                            console.log("Currency update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Currency update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const currencyEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('currencyEditModal'));
                        if (currencyEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                currencyEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    currencyEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Currency validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachCurrencyEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during currency form submission:', error);
                const currencyEditModalBodyElement = document.getElementById('currencyEditModalBody');
                if (currencyEditModalBodyElement) {
                     currencyEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Currency Delete form submission (AJAX) ---
        async function handleCurrencyDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete currency with an error.");
                    } else {
                        console.error("Currency delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Currency deleted successfully!");
                    } else {
                        console.log("Currency deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete currency.");
                    } else {
                        console.error("Currency delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during currency delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during currency deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during currency deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Currency Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Currency"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Currency', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('currencyEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('currencyEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachCurrencyEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Currency Modal Opener
        document.querySelectorAll('.details-btn[data-page="Currency"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Currency', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('currencyDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('currencyDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Currency Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Currency"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const currencyName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Currency', 'Delete', id);

                document.getElementById('deleteModalCurrencyName').textContent = currencyName;
                document.getElementById('deleteModalCurrencyNameConfirm').textContent = currencyName;

                const deleteForm = document.getElementById('currencyDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleCurrencyDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleCurrencyDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('currencyDeleteModal')).show();
            });
        });
    });
</script>