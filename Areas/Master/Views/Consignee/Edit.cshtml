@model ProcureToPay.Areas.Master.ViewModels.ConsigneeCreateEditViewModel

<div class="modal-body">
    <form id="consigneeEditForm" method="post" asp-action="Edit" asp-controller="Consignee" asp-area="Master">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        @* Hidden input for the ConsigneeId is crucial for the update *@
        <input type="hidden" asp-for="Consignee.ConsigneeId" />

        @* ==== Card 1: Basic Information ==== *@
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-info-circle me-2"></i>Basic Information</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Consignee.ConsigneeName" class="form-label">Consignee Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-user-tie"></i></span>
                            <input asp-for="Consignee.ConsigneeName" class="form-control" placeholder="Enter Consignee Name" />
                        </div>
                        <span asp-validation-for="Consignee.ConsigneeName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Consignee.ClientId" class="form-label">Client</label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-handshake"></i></span>
                            <select asp-for="Consignee.ClientId" asp-items="@Model.Clients" class="form-select">
                                <option value="">-- Select Client --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Consignee.ClientId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Consignee.CompanyId" class="form-label">Company</label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-building"></i></span>
                            <select asp-for="Consignee.CompanyId" asp-items="@Model.Companies" class="form-select">
                                <option value="">-- Select Company --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Consignee.CompanyId" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        @* ==== Card 2: Contact & Location ==== *@
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-address-book me-2"></i>Contact & Location</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Consignee.ContactNo" class="form-label">Contact Number</label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-phone-alt"></i></span>
                            <input asp-for="Consignee.ContactNo" class="form-control" placeholder="e.g., 0300-1234567" />
                        </div>
                        <span asp-validation-for="Consignee.ContactNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Consignee.CityId" class="form-label">City</label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                            <select asp-for="Consignee.CityId" asp-items="@Model.Cities" class="form-select">
                                <option value="">-- Select City --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Consignee.CityId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Consignee.Address" class="form-label">Address</label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-map-marker-alt"></i></span>
                            <input asp-for="Consignee.Address" class="form-control" placeholder="Enter Full Address" />
                        </div>
                        <span asp-validation-for="Consignee.Address" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        @* ==== Card 3: Delivery Details ==== *@
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-truck-loading me-2"></i>Delivery Details</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Consignee.StandardKMs" class="form-label">Standard KMs</label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-road"></i></span>
                            <input asp-for="Consignee.StandardKMs" class="form-control" type="number" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Consignee.StandardKMs" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Consignee.LastDeliveryKMs" class="form-label">Last Delivery KMs</label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-route"></i></span>
                            <input asp-for="Consignee.LastDeliveryKMs" class="form-control" type="number" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Consignee.LastDeliveryKMs" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Consignee.LastDepartureDate" class="form-label">Last Departure Date</label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-calendar-day"></i></span>
                            <input asp-for="Consignee.LastDepartureDate" class="form-control" type="date" />
                        </div>
                        <span asp-validation-for="Consignee.LastDepartureDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Consignee.LastDepartureDateTime" class="form-label">Last Departure Time</label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-clock"></i></span>
                            <input asp-for="Consignee.LastDepartureDateTime" class="form-control" type="time" />
                        </div>
                        <span asp-validation-for="Consignee.LastDepartureDateTime" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        @* ==== Card 4: Status ==== *@
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-toggle-on me-2"></i>Status</h6>
            </div>
            <div class="card-body">
                <div class="form-check form-switch fs-5">
                    <input class="form-check-input" type="checkbox" asp-for="Consignee.IsActive">
                    <label class="form-check-label" asp-for="Consignee.IsActive">Is Active</label>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="fas fa-times me-1"></i>Cancel
            </button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1"></i>Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}