@model ProcureToPay.Areas.Master.ViewModels.ServiceViewModel

@{
    ViewData["Title"] = "Create New Service";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-plus me-2"></i> @ViewData["Title"]
            </h5>
        </div>
        <div class="card-body">
            <form method="post" action="@Url.Action("Create", "Service", new { area = "Master" })">
                @Html.AntiForgeryToken()

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;"><i class="fas fa-info-circle me-2"></i> Service Details</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServiceName" class="form-label">Service Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-box-open"></i></span>
                                    <input asp-for="ServiceName" class="form-control" placeholder="Enter service name" />
                                </div>
                                <span asp-validation-for="ServiceName" class="text-danger"></span>
                            </div>
                            <input type="hidden" asp-for="UnitPrice" value="@(0.00)" />
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServiceNatureId" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;">    <i class="fas fa-leaf"></i></span>
                                    <select asp-for="ServiceNatureId" asp-items="@Model.ServiceNatures" class="form-select">
                                        <option value="">-- Select Nature --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="ServiceNatureId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="UoMId" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-balance-scale"></i></span>
                                    <select asp-for="UoMId" asp-items="@Model.UoMs" class="form-select">
                                        <option value="">-- Select UOM --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="UoMId" class="text-danger"></span>
                            </div>
                            
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn" style="background-color: #092963; color: white;">
                        <i class="fas fa-save me-1"></i> Create Service
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
