@* This partial defines the modal structures and contains the JavaScript logic for them. *@

<div class="modal fade" id="productNatureEditModal" tabindex="-1" aria-labelledby="productNatureEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="productNatureEditModalLabel">
                    <i class="fas fa-edit me-2"></i> Edit Product Nature
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="productNatureEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="productNatureDetailsModal" tabindex="-1" aria-labelledby="productNatureDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="productNatureDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Product Nature Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="productNatureDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="productNatureDeleteModal" tabindex="-1" aria-labelledby="productNatureDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="productNatureDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Product Nature: <span id="deleteModalProductNatureName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete productNature <strong id="deleteModalProductNatureNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="productNatureDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- Function to attach/re-attach form submission handler for the ProductNature Edit modal ---
        function attachProductNatureEditFormSubmissionHandler() {
            const editForm = document.getElementById('productNatureEditForm'); // Target the productNature edit form
            if (editForm) {
                // Ensure no duplicate listeners by removing any existing ones
                editForm.removeEventListener('submit', handleProductNatureEditFormSubmit);
                editForm.addEventListener('submit', handleProductNatureEditFormSubmit);

                // Re-parse client-side validation for dynamically loaded content
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #productNatureEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for productNature form.");
                }
            } else {
                console.warn("#productNatureEditForm not found when trying to attach handler.");
            }
        }

        // --- Handler for the ProductNature Edit form submission (AJAX) ---
        async function handleProductNatureEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for productNature form. Not sending AJAX request.");
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type"); // Get content type to distinguish JSON/HTML
                const productNatureEditModalBodyElement = document.getElementById('productNatureEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    // This is a JSON response (success or specific error)
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        // Success: close modal, show message, reload page
                        const productNatureEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('productNatureEditModal'));
                        if (productNatureEditModalInstance) {
                            productNatureEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') { // Check if Toastr is available
                            toastr.success(jsonResponse.message || "ProductNature updated successfully!");
                        } else {
                            console.log("ProductNature update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload(); // Reload to reflect changes
                    } else {
                        // JSON error: show message, keep modal open or close based on error type
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("ProductNature update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        // For critical errors (e.g., productNature not found), you might want to close the modal
                        const productNatureEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('productNatureEditModal'));
                        if (productNatureEditModalInstance) {
                            productNatureEditModalInstance.hide(); // Hide for critical errors
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    productNatureEditModalBodyElement.innerHTML = responseHtml;
                    console.log("ProductNature validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    setTimeout(attachProductNatureEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during productNature form submission:', error);
                productNatureEditModalBodyElement.innerHTML = `
                    <div class="alert alert-danger" role="alert">
                        A network or unexpected error occurred. Please check your connection and try again.
                    </div>
                `;
            }
        }

        // --- Handler for ProductNature Delete form submission (AJAX) ---
        async function handleProductNatureDeleteFormSubmit(event) {
            event.preventDefault(); // Stop default form submission
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                // Assuming delete always returns JSON from the controller
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    // Success: close modal, show message, reload page
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "ProductNature deleted successfully!");
                    } else {
                        console.log("ProductNature deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload(); // Reload page to reflect deletion
                } else {
                    // Error: show message
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete productNature.");
                    } else {
                        console.error("ProductNature delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during productNature delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during productNature deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during productNature deletion. Please try again.");
                }
            }
        }


        // --- ProductNature Modal Openers ---

        // Edit ProductNature Modal Opener
        document.querySelectorAll('.edit-btn[data-page="ProductNature"]').forEach(function (button) {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'ProductNature', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('productNatureEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('productNatureEditModal')).show();
                    setTimeout(attachProductNatureEditFormSubmissionHandler, 50);
                } catch (error) {
                    console.error('Error loading productNature edit modal:', error);
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details ProductNature Modal Opener
        document.querySelectorAll('.details-btn[data-page="ProductNature"]').forEach(function (button) {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'ProductNature', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('productNatureDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('productNatureDetailsModal')).show();
                } catch (error) {
                    console.error('Error loading productNature details modal:', error);
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete ProductNature Modal Opener
        document.querySelectorAll('.delete-btn').forEach(function (button) {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const area = this.getAttribute('data-area');
                const page = this.getAttribute('data-page');
                const productNatureName = this.getAttribute('data-name'); // Corrected data attribute name, matches Razor now

                const url = getUrl(area, page, 'Delete', id);

                // If you want to display the productNature name in the delete confirmation modal
                const deleteModalProductNatureNameSpan = document.getElementById('deleteModalProductNatureName');
                if (deleteModalProductNatureNameSpan) {
                    deleteModalProductNatureNameSpan.textContent = productNatureName;
                }
                const deleteModalProductNatureNameConfirmSpan = document.getElementById('deleteModalProductNatureNameConfirm');
                if (deleteModalProductNatureNameConfirmSpan) {
                    deleteModalProductNatureNameConfirmSpan.textContent = productNatureName;
                }

                document.getElementById('productNatureDeleteForm').setAttribute('action', url);
                new bootstrap.Modal(document.getElementById('productNatureDeleteModal')).show();
            });
        });
    }); // End DOMContentLoaded
</script>