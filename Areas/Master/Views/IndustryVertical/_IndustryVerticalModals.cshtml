@* This partial defines the modal structures and JavaScript logic for IndustryVerticals. *@

<div class="modal fade" id="industryVerticalEditModal" tabindex="-1" aria-labelledby="industryVerticalEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="industryVerticalEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit IndustryVertical
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="industryVerticalEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="industryVerticalDetailsModal" tabindex="-1" aria-labelledby="industryVerticalDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="industryVerticalDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> IndustryVertical Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="industryVerticalDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="industryVerticalDeleteModal" tabindex="-1" aria-labelledby="industryVerticalDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="industryVerticalDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete IndustryVertical: <span id="deleteModalIndustryVerticalName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete industryVertical <strong id="deleteModalIndustryVerticalNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="industryVerticalDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the IndustryVertical Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachIndustryVerticalEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('industryVerticalEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleIndustryVerticalEditFormSubmit);
                editForm.addEventListener('submit', handleIndustryVerticalEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #industryVerticalEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for industryVertical form.");
                }
            } else {
                console.warn("#industryVerticalEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the IndustryVertical Edit form submission (AJAX) ---
        async function handleIndustryVerticalEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for industryVertical form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const industryVerticalEditModalBodyElement = document.getElementById('industryVerticalEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const industryVerticalEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('industryVerticalEditModal'));
                        if (industryVerticalEditModalInstance) {
                            industryVerticalEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "IndustryVertical updated successfully!");
                        } else {
                            console.log("IndustryVertical update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("IndustryVertical update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const industryVerticalEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('industryVerticalEditModal'));
                        if (industryVerticalEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                industryVerticalEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    industryVerticalEditModalBodyElement.innerHTML = responseHtml;
                    console.log("IndustryVertical validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachIndustryVerticalEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during industryVertical form submission:', error);
                const industryVerticalEditModalBodyElement = document.getElementById('industryVerticalEditModalBody');
                if (industryVerticalEditModalBodyElement) {
                     industryVerticalEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for IndustryVertical Delete form submission (AJAX) ---
        async function handleIndustryVerticalDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete industryVertical with an error.");
                    } else {
                        console.error("IndustryVertical delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "IndustryVertical deleted successfully!");
                    } else {
                        console.log("IndustryVertical deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete industryVertical.");
                    } else {
                        console.error("IndustryVertical delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during industryVertical delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during industryVertical deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during industryVertical deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit IndustryVertical Modal Opener
        document.querySelectorAll('.edit-btn[data-page="IndustryVertical"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'IndustryVertical', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('industryVerticalEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('industryVerticalEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachIndustryVerticalEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details IndustryVertical Modal Opener
        document.querySelectorAll('.details-btn[data-page="IndustryVertical"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'IndustryVertical', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('industryVerticalDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('industryVerticalDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete IndustryVertical Modal Opener
        document.querySelectorAll('.delete-btn[data-page="IndustryVertical"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const industryVerticalName = this.getAttribute('data-name');
                const url = getUrl('Master', 'IndustryVertical', 'Delete', id);

                document.getElementById('deleteModalIndustryVerticalName').textContent = industryVerticalName;
                document.getElementById('deleteModalIndustryVerticalNameConfirm').textContent = industryVerticalName;

                const deleteForm = document.getElementById('industryVerticalDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleIndustryVerticalDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleIndustryVerticalDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('industryVerticalDeleteModal')).show();
            });
        });
    });
</script>