@model ProcureToPay.Areas.Master.Models.ClientCreateEditViewModel
@{
    ViewData["Title"] = "Create Client";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" asp-area="">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Clients</a></li>
        <li class="breadcrumb-item active">Create</li>
    </ol>

    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-plus me-2"></i> Create New Client
            </h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @* ==== Card 1: Basic Information ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-info-circle me-2"></i> Basic Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.ClientName" class="form-label">Client Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-user-tie"></i></span>
                                    <input asp-for="Client.ClientName" class="form-control" placeholder="Enter client's full name" />
                                </div>
                                <span asp-validation-for="Client.ClientName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.ShortName" class="form-label">Short Name</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-id-badge"></i></span>
                                    <input asp-for="Client.ShortName" class="form-control" placeholder="Enter short name or code" />
                                </div>
                                <span asp-validation-for="Client.ShortName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* ==== Card 2: Contact & Location ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-address-book me-2"></i> Contact & Location</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.ContactPerson" class="form-label">Contact Person</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-user"></i></span>
                                    <input asp-for="Client.ContactPerson" class="form-control" placeholder="e.g., John Doe" />
                                </div>
                                <span asp-validation-for="Client.ContactPerson" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.ContactNo" class="form-label">Contact Number</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-phone"></i></span>
                                    <input asp-for="Client.ContactNo" class="form-control" placeholder="Enter phone number" />
                                </div>
                                <span asp-validation-for="Client.ContactNo" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.Email" class="form-label">Email</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-envelope"></i></span>
                                    <input asp-for="Client.Email" type="email" class="form-control" placeholder="Enter email address" />
                                </div>
                                <span asp-validation-for="Client.Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="Client.Address" class="form-label">Address</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-map-marker-alt"></i></span>
                                    <input asp-for="Client.Address" class="form-control" placeholder="Enter full address" />
                                </div>
                                <span asp-validation-for="Client.Address" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.CityId" class="form-label">City</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                                    <select asp-for="Client.CityId" asp-items="@Model.Cities" class="form-select">
                                        <option value="">-- Select City --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Client.CityId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Client.URL" class="form-label">Website URL</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-globe"></i></span>
                                    <input asp-for="Client.URL" class="form-control" placeholder="e.g., https://www.example.com" />
                                </div>
                                <span asp-validation-for="Client.URL" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* ==== Card 3: Business Details ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-briefcase me-2"></i> Business Details</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.IndustryVerticalId" class="form-label">Industry Vertical</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                                    <select asp-for="Client.IndustryVerticalId" asp-items="@Model.IndustryVerticals" class="form-select">
                                        <option value="">-- Select Industry Vertical --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Client.IndustryVerticalId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.CompanyId" class="form-label">Company</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                                    <select asp-for="Client.CompanyId" asp-items="@Model.Companies" class="form-select">
                                        <option value="">-- Select Company --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Client.CompanyId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.ContractPeriod" class="form-label">Contract Period (Days)</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-calendar-alt"></i></span>
                                    <input asp-for="Client.ContractPeriod" type="number" class="form-control" placeholder="e.g., 365" />
                                </div>
                                <span asp-validation-for="Client.ContractPeriod" class="text-danger"></span>
                            </div>

                        </div>
                    </div>
                </div>

                @* ==== Card 4: Financials & Billing ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-dollar-sign me-2"></i> Financials & Billing</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.PaymentModeId" class="form-label">Payment Mode</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                                    <select asp-for="Client.PaymentModeId" asp-items="@Model.PaymentModes" class="form-select">
                                        <option value="">-- Select Payment Mode --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Client.PaymentModeId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.CreditLimit" class="form-label">Credit Limit</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-money-check-alt"></i></span>
                                    <input asp-for="Client.CreditLimit" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Client.CreditLimit" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.CreditDays" class="form-label">Credit Days</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-calendar-day"></i></span>
                                    <input asp-for="Client.CreditDays" type="number" class="form-control" placeholder="e.g., 30" />
                                </div>
                                <span asp-validation-for="Client.CreditDays" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.RateTypeId" class="form-label">Rate Type</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                                    <select asp-for="Client.RateTypeId" asp-items="@Model.RateTypes" class="form-select">
                                        <option value="">-- Select Rate Type --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Client.RateTypeId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.TaxRate" class="form-label">Tax Rate (%)</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-percentage"></i></span>
                                    <input asp-for="Client.TaxRate" type="number" step="0.01" class="form-control" placeholder="e.g., 17.5" />
                                </div>
                                <span asp-validation-for="Client.TaxRate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* ==== Card 5: Tax & Identifiers ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-id-card-alt me-2"></i> Tax & Identifiers</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.CWClientId" class="form-label">CW Client ID</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-barcode"></i></span>
                                    <input asp-for="Client.CWClientId" class="form-control" placeholder="Enter CW Client ID" />
                                </div>
                                <span asp-validation-for="Client.CWClientId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.NTN" class="form-label">NTN</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-file-alt"></i></span>
                                    <input asp-for="Client.NTN" class="form-control" placeholder="Enter National Tax Number" />
                                </div>
                                <span asp-validation-for="Client.NTN" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.STRN" class="form-label">STRN</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-file-signature"></i></span>
                                    <input asp-for="Client.STRN" class="form-control" placeholder="Enter Sales Tax Registration No." />
                                </div>
                                <span asp-validation-for="Client.STRN" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* ==== Card 6: Settings & Configuration ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-cogs me-2"></i> Settings & Configuration</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Client.DetGraceHRs" class="form-label">Detention Grace (Hours)</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-hourglass-half"></i></span>
                                    <input asp-for="Client.DetGraceHRs" type="number" class="form-control" placeholder="e.g., 2" />
                                </div>
                                <span asp-validation-for="Client.DetGraceHRs" class="text-danger"></span>
                            </div>
                            <div class="col-md-8 d-flex align-items-center">
                                <div class="row">
                                    <div class="col-auto">
                                        <div class="form-check form-switch mt-4">
                                            <input class="form-check-input" type="checkbox" asp-for="Client.IsActive">
                                            <label class="form-check-label" asp-for="Client.IsActive">Is Active</label>
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <div class="form-check form-switch mt-4">
                                            <input class="form-check-input" type="checkbox" asp-for="Client.CategoryMandatory">
                                            <label class="form-check-label" asp-for="Client.CategoryMandatory">Category Mandatory</label>
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <div class="form-check form-switch mt-4">
                                            <input class="form-check-input" type="checkbox" asp-for="Client.ProductMandatory">
                                            <label class="form-check-label" asp-for="Client.ProductMandatory">Product Mandatory</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* ==== Card 7: Invoice Formats ==== *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-file-invoice me-2"></i> Invoice Formats</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @for (var i = 0; i < Model.Client.InvoiceFormats.Count; i++)
                            {
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="hidden" asp-for="Client.InvoiceFormats[i].FormatId" />
                                        <input type="hidden" asp-for="Client.InvoiceFormats[i].FormatName" />
                                        <input asp-for="Client.InvoiceFormats[i].IsSelected" class="form-check-input" />
                                        <label asp-for="Client.InvoiceFormats[i].IsSelected" class="form-check-label">
                                            @Model.Client.InvoiceFormats[i].FormatName
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-light text-primary"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                    <button type="submit" class="btn" style="background-color: #092963; color: white;"><i class="fas fa-save me-1"></i> Create Client</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
