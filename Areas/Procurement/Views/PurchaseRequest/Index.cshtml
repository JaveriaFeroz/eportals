@using ProcureToPay.Areas.Procurement.Models
@model IEnumerable<PurchaseRequest>

@{
    ViewData["Title"] = "Purchase Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Purchase Requests</h2>
                <div>
                    <button type="button" class="btn btn-info me-2" onclick="addSampleData()">Add Sample Data</button>
                    <a asp-action="Create" class="btn btn-primary">Create New Request</a>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Request #</th>
                                    <th>Title</th>
                                    <th>Requester</th>
                                    <th>Department</th>
                                    <th>Request Date</th>
                                    <th>Total Amount</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.RequestNumber</td>
                                            <td>@item.Title</td>
                                            <td>@item.RequestedByUserId</td>
                                            <td>@item.Department</td>
                                            <td>@item.RequestDate.ToString("dd/MM/yyyy")</td>
                                            <td>$@item.TotalAmount.ToString("N2")</td>
                                            <td>
                                                <span class="badge bg-@GetStatusColor(item.Status)">
                                                    @item.Status.ToString()
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">
                                            No purchase requests found. <a asp-action="Create">Create your first request</a> or
                                            <button class="btn btn-link p-0" onclick="addSampleData()">add sample data</button>.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusColor(RequestStatus status)
    {
        return status switch
        {
            RequestStatus.Draft => "secondary",
            RequestStatus.Submitted => "primary",
            RequestStatus.UnderReview => "warning",
            RequestStatus.Approved => "success",
            RequestStatus.Rejected => "danger",
            RequestStatus.Cancelled => "dark",
            _ => "secondary"
        };
    }
}

<script>
    function addSampleData() {
        if (confirm('Add sample data to test the application?')) {
            // Get the anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            const tokenValue = token ? token.value : '';

            // Create form data
            const formData = new FormData();
            if (tokenValue) {
                formData.append('__RequestVerificationToken', tokenValue);
            }

            fetch('@Url.Action("AddSampleData")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Error: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error adding sample data: ' + error.message);
            });
        }
    }
</script>