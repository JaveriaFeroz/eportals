@model IEnumerable<ProcureToPay.Areas.Procurement.Models.PurchaseRequest>

@{
    ViewData["Title"] = "Purchase Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">Purchase Requests</h3>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Create New Request
                    </a>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Request Number</th>
                                    <th>Title</th>
                                    <th>Request Date</th>
                                    <th>Total Amount</th>
                                    <th>Status</th>
                                    <th>Current Owner</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.RequestNumber</td>
                                        <td>@item.Title</td>
                                        <td>@item.RequestDate.ToString("dd/MM/yyyy")</td>
                                        <td>@item.TotalAmount.ToString("C")</td>
                                        <td>
                                            @switch (item.StateId)
                                            {
                                                case 1:
                                                    <span class="badge bg-secondary">Saved</span>
                                                    break;
                                                case 2:
                                                    <span class="badge bg-warning">In Approval</span>
                                                    break;
                                                case 3:
                                                    <span class="badge bg-success">Approved</span>
                                                    break;
                                                case 4:
                                                    <span class="badge bg-danger">Rejected</span>
                                                    break;
                                                case 5:
                                                    <span class="badge bg-info">Returned</span>
                                                    break;
                                                case 10001:
                                                    <span class="badge bg-dark">Cancelled</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light text-dark">Unknown</span>
                                                    break;
                                            }
                                        </td>
                                        <td>@item.Owner</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i> View
                                                </a>
                                                @if (item.StateId == 1 || item.StateId == 5) // Saved or Returned
                                                {
                                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                                        <i class="fas fa-edit"></i> Edit
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="text-center py-4">
                            <p class="text-muted">No purchase requests found.</p>
                            <a asp-action="Create" class="btn btn-primary">Create Your First Request</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Quick Actions</h5>
            </div>
            <div class="card-body">
                <a asp-action="PendingApprovals" class="btn btn-warning">
                    <i class="fas fa-clock"></i> Pending Approvals
                </a>
            </div>
        </div>
    </div>
</div>