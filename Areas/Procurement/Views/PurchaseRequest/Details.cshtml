@model ProcureToPay.Areas.Procurement.Models.PurchaseRequest

@{
    ViewData["Title"] = "Purchase Request Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var workflowHistory = ViewBag.WorkflowHistory as List<ProcureToPay.Areas.Common.Models.FormHistory>;
    var currentStateName = ViewBag.CurrentStateName as string;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    @TempData["Info"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">Purchase Request Details</h3>
                    <div>
                        <span class="badge bg-info fs-6">@currentStateName</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <th width="40%">Request Number:</th>
                                    <td>@Model.RequestNumber</td>
                                </tr>
                                <tr>
                                    <th>Title:</th>
                                    <td>@Model.Title</td>
                                </tr>
                                <tr>
                                    <th>Request Date:</th>
                                    <td>@Model.RequestDate.ToString("dd/MM/yyyy")</td>
                                </tr>
                                <tr>
                                    <th>Required Date:</th>
                                    <td>@(Model.RequiredDate?.ToString("dd/MM/yyyy") ?? "Not specified")</td>
                                </tr>
                                <tr>
                                    <th>Requested By:</th>
                                    <td>@Model.RequestedByUser?.UserName</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <th width="40%">Department:</th>
                                    <td>@(Model.Department?.DepartmentName ?? "Not specified")</td>
                                </tr>
                                <tr>
                                    <th>Branch:</th>
                                    <td>@(Model.Branch?.BranchName ?? "Not specified")</td>
                                </tr>
                                <tr>
                                    <th>Total Amount:</th>
                                    <td><strong>@Model.TotalAmount.ToString("C")</strong></td>
                                </tr>
                                <tr>
                                    <th>Current Owner:</th>
                                    <td>@Model.Owner</td>
                                </tr>
                                <tr>
                                    <th>Approval Sequence:</th>
                                    <td>@Model.CurrentApprovalSequence</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Description</h5>
                                <p class="text-muted">@Model.Description</p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Purpose))
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Purpose</h5>
                                <p class="text-muted">@Model.Purpose</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Items Section -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="card-title">Request Items</h5>
                </div>
                <div class="card-body">
                    @if (Model.Items.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Item Name</th>
                                        <th>Description</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Unit Price</th>
                                        <th>Total Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@item.ItemName</td>
                                            <td>@item.Description</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.Unit</td>
                                            <td>@item.UnitPrice.ToString("C")</td>
                                            <td>@item.TotalPrice.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-info">
                                        <td colspan="5"><strong>Total Amount:</strong></td>
                                        <td><strong>@Model.TotalAmount.ToString("C")</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No items added to this request.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Workflow Actions -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Workflow Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (Model.StateId == 1 || Model.StateId == 5) // Saved or Returned
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                                <i class="fas fa-edit"></i> Edit Request
                            </a>
                            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#submitModal">
                                <i class="fas fa-paper-plane"></i> Submit for Approval
                            </button>
                        }

                        @if (Model.StateId == 2) // Submitted (In Approval)
                        {
                            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveModal">
                                <i class="fas fa-check"></i> Approve
                            </button>
                            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#returnModal">
                                <i class="fas fa-undo"></i> Return
                            </button>
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                <i class="fas fa-times"></i> Reject
                            </button>
                        }

                        @if (Model.StateId != 3 && Model.StateId != 4 && Model.StateId != 10001) // Not Approved, Rejected, or Cancelled
                        {
                            <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                <i class="fas fa-ban"></i> Cancel Request
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Workflow History -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="card-title">Workflow History</h5>
                </div>
                <div class="card-body">
                    @if (workflowHistory != null && workflowHistory.Any())
                    {
                        <div class="timeline">
                            @foreach (var history in workflowHistory.OrderByDescending(h => h.ActionDate))
                            {
                                <div class="timeline-item mb-3">
                                    <div class="timeline-marker">
                                        @switch (history.Action.ToLower())
                                        {
                                            case "created":
                                                <i class="fas fa-plus text-primary"></i>
                                                break;
                                            case "submit":
                                                <i class="fas fa-paper-plane text-info"></i>
                                                break;
                                            case "approve":
                                                <i class="fas fa-check text-success"></i>
                                                break;
                                            case "reject":
                                                <i class="fas fa-times text-danger"></i>
                                                break;
                                            case "return":
                                                <i class="fas fa-undo text-warning"></i>
                                                break;
                                            case "cancel":
                                                <i class="fas fa-ban text-dark"></i>
                                                break;
                                            default:
                                                <i class="fas fa-circle text-muted"></i>
                                                break;
                                        }
                                    </div>
                                    <div class="timeline-content">
                                        <h6 class="mb-1">@history.Action</h6>
                                        <p class="text-muted mb-1">
                                            @history.FromStateName → @history.ToStateName
                                        </p>
                                        <small class="text-muted">
                                            By @history.ActionByUserName on @history.ActionDate.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                        @if (!string.IsNullOrEmpty(history.Comments))
                                        {
                                            <p class="mt-2 text-muted"><em>"@history.Comments"</em></p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No workflow history available.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Workflow Action Modals -->
@await Html.PartialAsync("_WorkflowActionModals", Model)

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline-item {
        position: relative;
        border-left: 2px solid #e9ecef;
        padding-left: 20px;
    }

    .timeline-marker {
        position: absolute;
        left: -10px;
        top: 0;
        width: 20px;
        height: 20px;
        background: white;
        border: 2px solid #e9ecef;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
    }

    .timeline-content {
        padding-bottom: 20px;
    }
</style>