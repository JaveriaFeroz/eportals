@model ProcureToPay.Areas.Master.Models.DriverViewModel

<div class="modal-body">

    <div class="card mb-3">
        <div class="card-header bg-light py-2">
            <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-info-circle me-2"></i> Employment Details</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Driver Name:</div>
                        <div class="col-7 fw-bold">@Model.DriverName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Father's Name:</div>
                        <div class="col-7">@(Model.FatherName ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Company:</div>
                        <div class="col-7">@(Model.CompanyName ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Joining Date:</div>
                        <div class="col-7">@Model.JoiningDate.ToString("dd MMM, yyyy")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Contractor:</div>
                        <div class="col-7">@(Model.ContractorName ?? "N/A")</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Employee No:</div>
                        <div class="col-7">@(Model.EmployeeNo ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Designation:</div>
                        <div class="col-7">@(Model.Designation ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Branch:</div>
                        <div class="col-7">@(Model.BranchName ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Monthly Salary:</div>
                        <div class="col-7">@Model.MonthlySalary.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-light py-2">
            <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-address-book me-2"></i> Personal & Contact Details</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Date of Birth:</div>
                        <div class="col-7">@Model.BirthDate.ToString("dd MMM, yyyy")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Address:</div>
                        <div class="col-7">@(Model.Address ?? "N/A")</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Cell Number:</div>
                        <div class="col-7">@(Model.CellNo ?? "N/A")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-light py-2">
            <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-briefcase me-2"></i> Professional Information</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Experience:</div>
                        <div class="col-7">@Model.Experience Years</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Previous Employer:</div>
                        <div class="col-7">@(Model.PreviousEmployer ?? "N/A")</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Qualification:</div>
                        <div class="col-7">@(Model.QualificationName ?? "N/A")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-light py-2">
            <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-id-card me-2"></i> Licenses & Identification</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">License No:</div>
                        <div class="col-7">@(Model.LicenseNo ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">CNIC No:</div>
                        <div class="col-7">@(Model.CNIC ?? "N/A")</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">License Expiry:</div>
                        <div class="col-7">@Model.LicenseExpiry.ToString("dd MMM, yyyy")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">CNIC Expiry:</div>
                        <div class="col-7">@Model.CNICExpiry.ToString("dd MMM, yyyy")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-light py-2">
            <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-users me-2"></i> Next of Kin</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Kin's Name:</div>
                        <div class="col-7">@(Model.NoKName ?? "N/A")</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">NOK Relation:</div>
                        <div class="col-7">@(Model.NoKRelationName ?? "N/A")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-light py-2">
            <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-user-cog me-2"></i> Status & Separation</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" disabled />
                        <label class="form-check-label">Is Active</label>
                    </div>
                </div>
            </div>
            @if (!Model.IsActive)
            {
                <hr />
                <h6 class="mb-3 text-muted">Separation Details</h6>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row mb-2">
                            <div class="col-5 text-muted">Separation Type:</div>
                            <div class="col-7">@(Model.SeparationTypeName ?? "N/A")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 text-muted">Reason:</div>
                            <div class="col-7">@(Model.SeparationReason ?? "N/A")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row mb-2">
                            <div class="col-5 text-muted">Separation Date:</div>
                            <div class="col-7">@Model.SeparationDate?.ToString("dd MMM, yyyy")</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>