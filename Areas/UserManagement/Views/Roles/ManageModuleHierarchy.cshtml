@model ProcureToPay.Areas.UserManagement.ViewModels.ModuleHierarchyViewModel

@{
    ViewData["Title"] = $"Manage {Model.ModuleDisplayName} Role Hierarchy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/scripts.js" asp-append-version="true"></script>

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963; display: flex; justify-content: space-between; align-items: center;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-layer-group me-2"></i> Manage @Model.ModuleDisplayName Role Hierarchy
            </h5>
        </div>

        <div class="card-body">
            <p class="text-muted mb-4">Configure and reorder the hierarchy of roles specific to the <strong>@Model.ModuleDisplayName</strong> module.</p>

            <form asp-action="UpdateModuleHierarchy" asp-controller="Roles" asp-area="UserManagement" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="moduleName" value="@Model.ModuleName" />

                <div class="row fw-bold bg-light border-bottom py-3 px-2 text-secondary">
                    <div class="col-4 d-flex align-items-center">
                        <i class="fas fa-user-shield me-1 text-dark"></i> ROLE NAME
                    </div>
                    <div class="col-4 d-flex align-items-center">
                        <i class="fas fa-info-circle me-1 text-dark"></i> DESCRIPTION
                    </div>
                    <div class="col-4 text-center d-flex align-items-center justify-content-center">
                        <i class="fas fa-layer-group me-1 text-dark"></i> HIERARCHY LEVEL
                    </div>
                </div>

                <div id="sortable">
                    @foreach (var role in Model.RoleHierarchies.OrderBy(r => r.HierarchyLevel))
                    {
                        <div class="row align-items-center border-bottom py-3 px-2 sortable-item" tabindex="0" data-role-id="@role.RoleId">
                            <div class="col-4 d-flex align-items-center">
                                <i class="bi bi-grip-vertical handle me-2"></i>
                                <input type="hidden" name="roleIds" value="@role.RoleId" />
                                @role.Role.Name
                            </div>
                            <div class="col-4 text-start">
                                @role.Role.Description
                            </div>
                            <div class="col-4 d-flex justify-content-center">
                                <input type="number" class="form-control hierarchy-level" name="hierarchyLevels" value="@role.HierarchyLevel" min="1" readonly/>
                            </div>
                        </div>
                    }
                </div>

                <div class="form-group mt-4">
                    <h5 class="mb-3">Add Role to Hierarchy</h5>
                    <div class="row gx-2">
                        <div class="col-md-8">
                            <select id="availableRoles" class="form-control">
                                <option value="">-- Select Role --</option>
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <option value="@role.Id" data-description="@role.Description">@role.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-success w-100" id="addRoleBtn">Add Role</button>
                        </div>
                    </div>
                </div>

                <div class="form-group mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary" style="background-color: #092963">Save Hierarchy</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to Roles</a>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-3">
        <a class="btn btn-light text-primary" href="/Home/Index">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"
            integrity="sha256-VazP97ZCwtekAsvgPBSUwPFKdrwD3unUfSGVYrahUqU="
            crossorigin="anonymous"></script>
    <script>
        $(function () {
            $("#sortable").sortable({
                handle: ".handle",
                axis: "y",
                update: function () {
                    updateHierarchyLevels();
                }
            });

            function updateHierarchyLevels() {
                let level = 1;
                $("#sortable .sortable-item").each(function () {
                    $(this).find(".hierarchy-level").val(level++);
                });
            }

            $("#addRoleBtn").on("click", function () {
                const selectedOption = $("#availableRoles option:selected");
                const roleId = selectedOption.val();
                const roleName = selectedOption.text();
                const roleDescription = selectedOption.data("description");

                if (!roleId) return;

                const level = $("#sortable .sortable-item").length + 1;

                const newRow = `
                    <div class="row align-items-center border-bottom py-3 px-2 sortable-item" data-role-id="${roleId}">
                        <div class="col-4 d-flex align-items-center">
                            <i class="bi bi-grip-vertical handle me-2"></i>
                            <input type="hidden" name="roleIds" value="${roleId}" />
                            ${roleName}
                        </div>
                        <div class="col-4 text-start">${roleDescription}</div>
                        <div class="col-4 d-flex justify-content-center">
                            <input type="number" class="form-control hierarchy-level" name="hierarchyLevels" value="${level}" min="1" />
                        </div>
                    </div>
                `;

                $("#sortable").append(newRow);
                selectedOption.remove();
                updateHierarchyLevels();
            });
        });
    </script>
}
