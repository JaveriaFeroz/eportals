<div class="modal fade" id="whTaxExemptionCategoryEditModal" tabindex="-1" aria-labelledby="whTaxExemptionCategoryEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="whTaxExemptionCategoryEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit WHTaxExemption
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="whTaxExemptionCategoryEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="whTaxExemptionCategoryDetailsModal" tabindex="-1" aria-labelledby="whTaxExemptionCategoryDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="whTaxExemptionCategoryDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> WHTaxExemption Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="whTaxExemptionCategoryDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="whTaxExemptionCategoryDeleteModal" tabindex="-1" aria-labelledby="whTaxExemptionCategoryDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="whTaxExemptionCategoryDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete WHTaxExemption: <span id="deleteModalWHTaxExemptionName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete whTaxExemptionCategory <strong id="deleteModalWHTaxExemptionNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="whTaxExemptionCategoryDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the WHTaxExemption Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachWHTaxExemptionEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('whTaxExemptionsEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleWHTaxExemptionEditFormSubmit);
                editForm.addEventListener('submit', handleWHTaxExemptionEditFormSubmit);

                // Re-parse whTaxExemptionCategory-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("WHTaxExemption-side validation re-parsed for #whTaxExemptionsEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. WHTaxExemption-side validation may not work for whTaxExemptionCategory form.");
                }
            } else {
                console.warn("#whTaxExemptionsEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the WHTaxExemption Edit form submission (AJAX) ---
        async function handleWHTaxExemptionEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform whTaxExemptionCategory-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("WHTaxExemption-side validation failed for whTaxExemptionCategory form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const whTaxExemptionCategoryEditModalBodyElement = document.getElementById('whTaxExemptionCategoryEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const whTaxExemptionCategoryEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('whTaxExemptionCategoryEditModal'));
                        if (whTaxExemptionCategoryEditModalInstance) {
                            whTaxExemptionCategoryEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "WHTaxExemption updated successfully!");
                        } else {
                            console.log("WHTaxExemption update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("WHTaxExemption update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const whTaxExemptionCategoryEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('whTaxExemptionCategoryEditModal'));
                        if (whTaxExemptionCategoryEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                whTaxExemptionCategoryEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    whTaxExemptionCategoryEditModalBodyElement.innerHTML = responseHtml;
                    console.log("WHTaxExemption validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachWHTaxExemptionEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during whTaxExemptionCategory form submission:', error);
                const whTaxExemptionCategoryEditModalBodyElement = document.getElementById('whTaxExemptionCategoryEditModalBody');
                if (whTaxExemptionCategoryEditModalBodyElement) {
                     whTaxExemptionCategoryEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for WHTaxExemption Delete form submission (AJAX) ---
        async function handleWHTaxExemptionDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete whTaxExemptionCategory with an error.");
                    } else {
                        console.error("WHTaxExemption delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "WHTaxExemption deleted successfully!");
                    } else {
                        console.log("WHTaxExemption deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete whTaxExemptionCategory.");
                    } else {
                        console.error("WHTaxExemption delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during whTaxExemptionCategory delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during whTaxExemptionCategory deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during whTaxExemptionCategory deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit WHTaxExemption Modal Opener
        document.querySelectorAll('.edit-btn[data-page="WHTaxExemption"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'WHTaxExemption', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('whTaxExemptionCategoryEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('whTaxExemptionCategoryEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachWHTaxExemptionEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details WHTaxExemption Modal Opener
        document.querySelectorAll('.details-btn[data-page="WHTaxExemption"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'WHTaxExemption', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('whTaxExemptionCategoryDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('whTaxExemptionCategoryDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete WHTaxExemption Modal Opener
        document.querySelectorAll('.delete-btn[data-page="WHTaxExemption"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const whTaxExemptionCategoryName = this.getAttribute('data-name');
                const url = getUrl('Master', 'WHTaxExemption', 'Delete', id);

                document.getElementById('deleteModalWHTaxExemptionName').textContent = whTaxExemptionCategoryName;
                document.getElementById('deleteModalWHTaxExemptionNameConfirm').textContent = whTaxExemptionCategoryName;

                const deleteForm = document.getElementById('whTaxExemptionCategoryDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleWHTaxExemptionDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleWHTaxExemptionDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('whTaxExemptionCategoryDeleteModal')).show();
            });
        });
    });
</script>