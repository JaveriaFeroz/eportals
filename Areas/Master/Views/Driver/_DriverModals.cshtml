@* This partial defines the modal structures and JavaScript logic for Drivers. *@

<div class="modal fade" id="driverEditModal" tabindex="-1" aria-labelledby="driverEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="driverEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Driver
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="driverEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="driverDetailsModal" tabindex="-1" aria-labelledby="driverDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="driverDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Driver Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="driverDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="driverDeleteModal" tabindex="-1" aria-labelledby="driverDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="driverDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Driver: <span id="deleteModalDriverName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete driver <strong id="deleteModalDriverNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="driverDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Driver Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachDriverEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('driverEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleDriverEditFormSubmit);
                editForm.addEventListener('submit', handleDriverEditFormSubmit);

                // Re-parse driver-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Driver-side validation re-parsed for #driverEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Driver-side validation may not work for driver form.");
                }
            } else {
                console.warn("#driverEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Driver Edit form submission (AJAX) ---
        async function handleDriverEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform driver-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Driver-side validation failed for driver form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const driverEditModalBodyElement = document.getElementById('driverEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const driverEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('driverEditModal'));
                        if (driverEditModalInstance) {
                            driverEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Driver updated successfully!");
                        } else {
                            console.log("Driver update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Driver update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const driverEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('driverEditModal'));
                        if (driverEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                driverEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    driverEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Driver validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachDriverEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during driver form submission:', error);
                const driverEditModalBodyElement = document.getElementById('driverEditModalBody');
                if (driverEditModalBodyElement) {
                     driverEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Driver Delete form submission (AJAX) ---
        async function handleDriverDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete driver with an error.");
                    } else {
                        console.error("Driver delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Driver deleted successfully!");
                    } else {
                        console.log("Driver deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete driver.");
                    } else {
                        console.error("Driver delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during driver delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during driver deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during driver deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Driver Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Driver"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Driver', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('driverEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('driverEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachDriverEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Driver Modal Opener
        document.querySelectorAll('.details-btn[data-page="Driver"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Driver', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('driverDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('driverDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Driver Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Driver"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const driverName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Driver', 'Delete', id);

                document.getElementById('deleteModalDriverName').textContent = driverName;
                document.getElementById('deleteModalDriverNameConfirm').textContent = driverName;

                const deleteForm = document.getElementById('driverDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleDriverDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleDriverDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('driverDeleteModal')).show();
            });
        });
    });
</script>