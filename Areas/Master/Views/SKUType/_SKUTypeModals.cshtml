@* This partial defines the modal structures and JavaScript logic for SKUTypes. *@

<div class="modal fade" id="skuTypeEditModal" tabindex="-1" aria-labelledby="skuTypeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="skuTypeEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit SKUType
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="skuTypeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="skuTypeDetailsModal" tabindex="-1" aria-labelledby="skuTypeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="skuTypeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> SKUType Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="skuTypeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="skuTypeDeleteModal" tabindex="-1" aria-labelledby="skuTypeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="skuTypeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete SKUType: <span id="deleteModalSKUTypeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete skuType <strong id="deleteModalSKUTypeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="skuTypeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the SKUType Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachSKUTypeEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('skuTypeEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleSKUTypeEditFormSubmit);
                editForm.addEventListener('submit', handleSKUTypeEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #skuTypeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for skuType form.");
                }
            } else {
                console.warn("#skuTypeEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the SKUType Edit form submission (AJAX) ---
        async function handleSKUTypeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for skuType form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const skuTypeEditModalBodyElement = document.getElementById('skuTypeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const skuTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('skuTypeEditModal'));
                        if (skuTypeEditModalInstance) {
                            skuTypeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "SKUType updated successfully!");
                        } else {
                            console.log("SKUType update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("SKUType update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const skuTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('skuTypeEditModal'));
                        if (skuTypeEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                skuTypeEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    skuTypeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("SKUType validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachSKUTypeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during skuType form submission:', error);
                const skuTypeEditModalBodyElement = document.getElementById('skuTypeEditModalBody');
                if (skuTypeEditModalBodyElement) {
                     skuTypeEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for SKUType Delete form submission (AJAX) ---
        async function handleSKUTypeDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete skuType with an error.");
                    } else {
                        console.error("SKUType delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "SKUType deleted successfully!");
                    } else {
                        console.log("SKUType deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete skuType.");
                    } else {
                        console.error("SKUType delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during skuType delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during skuType deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during skuType deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit SKUType Modal Opener
        document.querySelectorAll('.edit-btn[data-page="SKUType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'SKUType', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('skuTypeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('skuTypeEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachSKUTypeEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details SKUType Modal Opener
        document.querySelectorAll('.details-btn[data-page="SKUType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'SKUType', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('skuTypeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('skuTypeDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete SKUType Modal Opener
        document.querySelectorAll('.delete-btn[data-page="SKUType"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const skuTypeName = this.getAttribute('data-name');
                const url = getUrl('Master', 'SKUType', 'Delete', id);

                document.getElementById('deleteModalSKUTypeName').textContent = skuTypeName;
                document.getElementById('deleteModalSKUTypeNameConfirm').textContent = skuTypeName;

                const deleteForm = document.getElementById('skuTypeDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleSKUTypeDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleSKUTypeDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('skuTypeDeleteModal')).show();
            });
        });
    });
</script>