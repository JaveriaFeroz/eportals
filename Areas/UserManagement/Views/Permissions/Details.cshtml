@model ProcureToPay.Areas.UserManagement.Models.Permission


<div class="modal-body">
    <form>
        @* No AntiForgeryToken needed as this form is not for submission *@
        @* No hidden input for Id needed if it's purely for display. If you send it back for some reason, re-add. *@

        <div class="mb-3">
            <label for="Name" class="form-label">Permission Name</label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;">
                    <i class="fas fa-file-signature"></i>
                </span>
                <input id="Name" name="Name" class="form-control" value="@Model.Name" readonly />
            </div>
        </div>

        <div class="mb-3">
            <label for="Description" class="form-label">Description</label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-align-left"></i></span>
                <textarea id="Description" name="Description" class="form-control" rows="3" readonly>@Model.Description</textarea>
            </div>
        </div>

        <div class="mb-3">
            <label for="ModuleId" class="form-label">Module</label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-cube"></i></span>
                @* Display the Module.DisplayName directly, as the select is complex to disable/readonly elegantly *@
                <input class="form-control" value="@Model.Module?.DisplayName" readonly />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label"><i class="fas fa-power-off me-2"></i> Status</label>
            <div class="form-check form-switch">
                <input id="IsActive" name="IsActive" type="checkbox" class="form-check-input" value="true" @(Model.IsActive ? "checked" : "") disabled />
                <label class="form-check-label" for="IsActive">Active</label>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Close</button>
        </div>

    </form>
</div>