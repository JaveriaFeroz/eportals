@* This partial defines the modal structures and JavaScript logic for Contractors. *@

<div class="modal fade" id="contractorEditModal" tabindex="-1" aria-labelledby="contractorEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="contractorEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Contractor
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="contractorEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="contractorDetailsModal" tabindex="-1" aria-labelledby="contractorDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="contractorDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Contractor Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="contractorDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="contractorDeleteModal" tabindex="-1" aria-labelledby="contractorDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="contractorDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Contractor: <span id="deleteModalContractorName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete contractor <strong id="deleteModalContractorNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="contractorDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Contractor Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachContractorEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('contractorEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleContractorEditFormSubmit);
                editForm.addEventListener('submit', handleContractorEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #contractorEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for contractor form.");
                }
            } else {
                console.warn("#contractorEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Contractor Edit form submission (AJAX) ---
        async function handleContractorEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for contractor form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const contractorEditModalBodyElement = document.getElementById('contractorEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const contractorEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('contractorEditModal'));
                        if (contractorEditModalInstance) {
                            contractorEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Contractor updated successfully!");
                        } else {
                            console.log("Contractor update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Contractor update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const contractorEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('contractorEditModal'));
                        if (contractorEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                contractorEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    contractorEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Contractor validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachContractorEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during contractor form submission:', error);
                const contractorEditModalBodyElement = document.getElementById('contractorEditModalBody');
                if (contractorEditModalBodyElement) {
                     contractorEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Contractor Delete form submission (AJAX) ---
        async function handleContractorDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete contractor with an error.");
                    } else {
                        console.error("Contractor delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Contractor deleted successfully!");
                    } else {
                        console.log("Contractor deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete contractor.");
                    } else {
                        console.error("Contractor delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during contractor delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during contractor deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during contractor deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Contractor Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Contractor"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Contractor', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('contractorEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('contractorEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachContractorEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Contractor Modal Opener
        document.querySelectorAll('.details-btn[data-page="Contractor"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Contractor', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('contractorDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('contractorDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Contractor Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Contractor"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const contractorName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Contractor', 'Delete', id);

                document.getElementById('deleteModalContractorName').textContent = contractorName;
                document.getElementById('deleteModalContractorNameConfirm').textContent = contractorName;

                const deleteForm = document.getElementById('contractorDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleContractorDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleContractorDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('contractorDeleteModal')).show();
            });
        });
    });
</script>