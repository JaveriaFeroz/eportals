@model ProcureToPay.Areas.Master.ViewModels.InsuranceDocumentTypeIndexViewModel

<div class="card mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead style="background-color: #092963; color: white;">
                    <tr>
                        <th>Select</th>
                        <th>Document Name</th>
                        <th>Mandatory</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.InsuranceDocumentTypes)
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox"
                                       class="form-check-input doc-select"
                                       value="@doc.TypeId"
                                       data-docname="@doc.TypeName"
                                       id="doc_@doc.TypeId" />
                            </td>
                            <td>
                                <label for="doc_@doc.TypeId">@doc.TypeName</label>
                            </td>
                            <td class="text-center">
                                <input type="checkbox"
                                       class="form-check-input mandatory-checkbox"
                                       data-docid="@doc.TypeId"
                                       title="Is this document mandatory?" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="d-flex justify-content-end mt-3">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn" id="saveSelectedDocumentsBtn" style="background-color: #092963; color: white;">
            <i class="fas fa-save me-1" style="color: white;"></i> Save Selection
        </button>
    </div>
</div>
