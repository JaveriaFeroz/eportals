@model ProcureToPay.Areas.Master.ViewModels.ServiceViewModel

<form id="serviceEditForm" method="post" asp-action="Edit" asp-controller="Service" asp-area="Master">
    <div class="modal-body">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ServiceId" />

        <div class="mb-3">
            <label asp-for="ServiceName" class="form-label">Service Name <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-box-open"></i></span>
                <input asp-for="ServiceName" class="form-control" />
            </div>
            <span asp-validation-for="ServiceName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="UnitPrice" class="form-label">Unit Price <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-dollar-sign"></i></span>
                <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" min="0.01" />
            </div>
            <span asp-validation-for="UnitPrice" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="UoMId" class="form-label"></label>
                <select asp-for="UoMId" asp-items="@Model.UoMs" class="form-select">
                    <option value="">-- Select UOM --</option>
                </select>
                <span asp-validation-for="UoMId" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="ServiceNatureId" class="form-label"></label>
                <select asp-for="ServiceNatureId" asp-items="@Model.ServiceNatures" class="form-select">
                    <option value="">-- Select Nature --</option>
                </select>
                <span asp-validation-for="ServiceNatureId" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Is Active</label>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn" style="background-color: #092963; color: white;">
            <i class="fas fa-save me-1"></i> Save Changes
        </button>
    </div>
</form>
