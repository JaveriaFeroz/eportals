@* This partial defines the modal structures and contains the JavaScript logic for them. *@

<div class="modal fade" id="serviceNatureEditModal" tabindex="-1" aria-labelledby="serviceNatureEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="serviceNatureEditModalLabel">
                    <i class="fas fa-edit me-2"></i> Edit Service Nature
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="serviceNatureEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="serviceNatureDetailsModal" tabindex="-1" aria-labelledby="serviceNatureDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="serviceNatureDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Service Nature Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="serviceNatureDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="serviceNatureDeleteModal" tabindex="-1" aria-labelledby="serviceNatureDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="serviceNatureDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Service Nature: <span id="deleteModalServiceNatureName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete serviceNature <strong id="deleteModalServiceNatureNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="serviceNatureDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- Function to attach/re-attach form submission handler for the ServiceNature Edit modal ---
        function attachServiceNatureEditFormSubmissionHandler() {
            const editForm = document.getElementById('serviceNatureEditForm'); // Target the serviceNature edit form
            if (editForm) {
                // Ensure no duplicate listeners by removing any existing ones
                editForm.removeEventListener('submit', handleServiceNatureEditFormSubmit);
                editForm.addEventListener('submit', handleServiceNatureEditFormSubmit);

                // Re-parse client-side validation for dynamically loaded content
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #serviceNatureEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for serviceNature form.");
                }
            } else {
                console.warn("#serviceNatureEditForm not found when trying to attach handler.");
            }
        }

        // --- Handler for the ServiceNature Edit form submission (AJAX) ---
        async function handleServiceNatureEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for serviceNature form. Not sending AJAX request.");
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type"); // Get content type to distinguish JSON/HTML
                const serviceNatureEditModalBodyElement = document.getElementById('serviceNatureEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    // This is a JSON response (success or specific error)
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        // Success: close modal, show message, reload page
                        const serviceNatureEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('serviceNatureEditModal'));
                        if (serviceNatureEditModalInstance) {
                            serviceNatureEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') { // Check if Toastr is available
                            toastr.success(jsonResponse.message || "ServiceNature updated successfully!");
                        } else {
                            console.log("ServiceNature update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload(); // Reload to reflect changes
                    } else {
                        // JSON error: show message, keep modal open or close based on error type
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("ServiceNature update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        // For critical errors (e.g., serviceNature not found), you might want to close the modal
                        const serviceNatureEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('serviceNatureEditModal'));
                        if (serviceNatureEditModalInstance) {
                            serviceNatureEditModalInstance.hide(); // Hide for critical errors
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    serviceNatureEditModalBodyElement.innerHTML = responseHtml;
                    console.log("ServiceNature validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    setTimeout(attachServiceNatureEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during serviceNature form submission:', error);
                serviceNatureEditModalBodyElement.innerHTML = `
                    <div class="alert alert-danger" role="alert">
                        A network or unexpected error occurred. Please check your connection and try again.
                    </div>
                `;
            }
        }

        // --- Handler for ServiceNature Delete form submission (AJAX) ---
        async function handleServiceNatureDeleteFormSubmit(event) {
            event.preventDefault(); // Stop default form submission
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                // Assuming delete always returns JSON from the controller
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    // Success: close modal, show message, reload page
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "ServiceNature deleted successfully!");
                    } else {
                        console.log("ServiceNature deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload(); // Reload page to reflect deletion
                } else {
                    // Error: show message
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete serviceNature.");
                    } else {
                        console.error("ServiceNature delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during serviceNature delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during serviceNature deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during serviceNature deletion. Please try again.");
                }
            }
        }


        // --- ServiceNature Modal Openers ---

        // Edit ServiceNature Modal Opener
        document.querySelectorAll('.edit-btn[data-page="ServiceNature"]').forEach(function (button) {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'ServiceNature', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('serviceNatureEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('serviceNatureEditModal')).show();
                    setTimeout(attachServiceNatureEditFormSubmissionHandler, 50);
                } catch (error) {
                    console.error('Error loading serviceNature edit modal:', error);
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details ServiceNature Modal Opener
        document.querySelectorAll('.details-btn[data-page="ServiceNature"]').forEach(function (button) {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'ServiceNature', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('serviceNatureDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('serviceNatureDetailsModal')).show();
                } catch (error) {
                    console.error('Error loading serviceNature details modal:', error);
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete ServiceNature Modal Opener
        document.querySelectorAll('.delete-btn').forEach(function (button) {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const area = this.getAttribute('data-area');
                const page = this.getAttribute('data-page');
                const serviceNatureName = this.getAttribute('data-name'); // Corrected data attribute name, matches Razor now

                const url = getUrl(area, page, 'Delete', id);

                // If you want to display the serviceNature name in the delete confirmation modal
                const deleteModalServiceNatureNameSpan = document.getElementById('deleteModalServiceNatureName');
                if (deleteModalServiceNatureNameSpan) {
                    deleteModalServiceNatureNameSpan.textContent = serviceNatureName;
                }
                const deleteModalServiceNatureNameConfirmSpan = document.getElementById('deleteModalServiceNatureNameConfirm');
                if (deleteModalServiceNatureNameConfirmSpan) {
                    deleteModalServiceNatureNameConfirmSpan.textContent = serviceNatureName;
                }

                document.getElementById('serviceNatureDeleteForm').setAttribute('action', url);
                new bootstrap.Modal(document.getElementById('serviceNatureDeleteModal')).show();
            });
        });
    }); // End DOMContentLoaded
</script>