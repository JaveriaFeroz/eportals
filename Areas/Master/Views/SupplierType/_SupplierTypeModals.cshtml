@* This partial defines the modal structures and JavaScript logic for SupplierTypes. *@

<div class="modal fade" id="supplierTypeEditModal" tabindex="-1" aria-labelledby="supplierTypeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="supplierTypeEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit SupplierType
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="supplierTypeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="supplierTypeDetailsModal" tabindex="-1" aria-labelledby="supplierTypeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="supplierTypeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> SupplierType Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="supplierTypeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="supplierTypeDeleteModal" tabindex="-1" aria-labelledby="supplierTypeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="supplierTypeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete SupplierType: <span id="deleteModalSupplierTypeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete supplierType <strong id="deleteModalSupplierTypeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="supplierTypeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the SupplierType Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachSupplierTypeEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('supplierTypeEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleSupplierTypeEditFormSubmit);
                editForm.addEventListener('submit', handleSupplierTypeEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #supplierTypeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for supplierType form.");
                }
            } else {
                console.warn("#supplierTypeEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the SupplierType Edit form submission (AJAX) ---
        async function handleSupplierTypeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for supplierType form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const supplierTypeEditModalBodyElement = document.getElementById('supplierTypeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const supplierTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('supplierTypeEditModal'));
                        if (supplierTypeEditModalInstance) {
                            supplierTypeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "SupplierType updated successfully!");
                        } else {
                            console.log("SupplierType update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("SupplierType update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const supplierTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('supplierTypeEditModal'));
                        if (supplierTypeEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                supplierTypeEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    supplierTypeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("SupplierType validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachSupplierTypeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during supplierType form submission:', error);
                const supplierTypeEditModalBodyElement = document.getElementById('supplierTypeEditModalBody');
                if (supplierTypeEditModalBodyElement) {
                     supplierTypeEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for SupplierType Delete form submission (AJAX) ---
        async function handleSupplierTypeDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete supplierType with an error.");
                    } else {
                        console.error("SupplierType delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "SupplierType deleted successfully!");
                    } else {
                        console.log("SupplierType deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete supplierType.");
                    } else {
                        console.error("SupplierType delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during supplierType delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during supplierType deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during supplierType deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit SupplierType Modal Opener
        document.querySelectorAll('.edit-btn[data-page="SupplierType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'SupplierType', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('supplierTypeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('supplierTypeEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachSupplierTypeEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details SupplierType Modal Opener
        document.querySelectorAll('.details-btn[data-page="SupplierType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'SupplierType', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('supplierTypeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('supplierTypeDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete SupplierType Modal Opener
        document.querySelectorAll('.delete-btn[data-page="SupplierType"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const supplierTypeName = this.getAttribute('data-name');
                const url = getUrl('Master', 'SupplierType', 'Delete', id);

                document.getElementById('deleteModalSupplierTypeName').textContent = supplierTypeName;
                document.getElementById('deleteModalSupplierTypeNameConfirm').textContent = supplierTypeName;

                const deleteForm = document.getElementById('supplierTypeDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleSupplierTypeDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleSupplierTypeDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('supplierTypeDeleteModal')).show();
            });
        });
    });
</script>