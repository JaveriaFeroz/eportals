@* This partial defines the modal structures and JavaScript logic for RateTypes. *@

<div class="modal fade" id="rateTypeEditModal" tabindex="-1" aria-labelledby="rateTypeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="rateTypeEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit RateType
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="rateTypeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rateTypeDetailsModal" tabindex="-1" aria-labelledby="rateTypeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="rateTypeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> RateType Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="rateTypeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rateTypeDeleteModal" tabindex="-1" aria-labelledby="rateTypeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="rateTypeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete RateType: <span id="deleteModalRateTypeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete rateType <strong id="deleteModalRateTypeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="rateTypeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the RateType Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachRateTypeEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('rateTypeEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleRateTypeEditFormSubmit);
                editForm.addEventListener('submit', handleRateTypeEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #rateTypeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for rateType form.");
                }
            } else {
                console.warn("#rateTypeEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the RateType Edit form submission (AJAX) ---
        async function handleRateTypeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for rateType form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const rateTypeEditModalBodyElement = document.getElementById('rateTypeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const rateTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('rateTypeEditModal'));
                        if (rateTypeEditModalInstance) {
                            rateTypeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "RateType updated successfully!");
                        } else {
                            console.log("RateType update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("RateType update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const rateTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('rateTypeEditModal'));
                        if (rateTypeEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                rateTypeEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    rateTypeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("RateType validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachRateTypeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during rateType form submission:', error);
                const rateTypeEditModalBodyElement = document.getElementById('rateTypeEditModalBody');
                if (rateTypeEditModalBodyElement) {
                     rateTypeEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for RateType Delete form submission (AJAX) ---
        async function handleRateTypeDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete rateType with an error.");
                    } else {
                        console.error("RateType delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "RateType deleted successfully!");
                    } else {
                        console.log("RateType deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete rateType.");
                    } else {
                        console.error("RateType delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during rateType delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during rateType deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during rateType deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit RateType Modal Opener
        document.querySelectorAll('.edit-btn[data-page="RateType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'RateType', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('rateTypeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('rateTypeEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachRateTypeEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details RateType Modal Opener
        document.querySelectorAll('.details-btn[data-page="RateType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'RateType', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('rateTypeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('rateTypeDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete RateType Modal Opener
        document.querySelectorAll('.delete-btn[data-page="RateType"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const rateTypeName = this.getAttribute('data-name');
                const url = getUrl('Master', 'RateType', 'Delete', id);

                document.getElementById('deleteModalRateTypeName').textContent = rateTypeName;
                document.getElementById('deleteModalRateTypeNameConfirm').textContent = rateTypeName;

                const deleteForm = document.getElementById('rateTypeDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleRateTypeDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleRateTypeDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('rateTypeDeleteModal')).show();
            });
        });
    });
</script>