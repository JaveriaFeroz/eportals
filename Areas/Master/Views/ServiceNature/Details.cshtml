@model ProcureToPay.Areas.Master.ViewModels.ServiceNatureViewModel

<div class="modal-body">

    @* ==== Card 1: Basic Information ==== *@
    <div class="card mb-3">
        <div class="card-header bg-light py-2">
            <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-info-circle me-2"></i>Basic Information</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Nature Name:</div> 
                        <div class="col-7">@Model.NatureName</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Status:</div>
                        <div class="col-7">@(Model.IsActive ? "Active" : "Inactive")</div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12"> 
                    <div class="row mb-2">
                        <div class="col-md-3 text-muted">Purchase Nature:</div>
                        <div class="col-md-9">
                            @{
                                var purchaseNatures = new List<string>();
                                if (Model.IsOpex)
                                {
                                    purchaseNatures.Add("Opex");
                                }
                                if (Model.IsCapex)
                                {
                                    purchaseNatures.Add("Capex");
                                }

                                if (purchaseNatures.Any())
                                {
                                    <span>@string.Join(" & ", purchaseNatures)</span>
                                }
                                else
                                {
                                    <span>None Specified</span>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ==== Card 5: Audit Information ==== *@
    <hr class="my-4" />
    <h6 class="mb-3" style="color: #092963;"><i class="fas fa-history me-2"></i> Audit Information</h6>
    <div class="row mb-2">
        <div class="col-md-3 text-muted">Created By:</div>
        <div class="col-md-3">@(Model.CreatedBy ?? "N/A")</div>
        <div class="col-md-3 text-muted">Created On:</div>
        <div class="col-md-3">@(Model.CreatedOn?.ToString("dd MMM, yyyy hh:mm tt") ?? "N/A")</div>
    </div>
    <div class="row mb-2">
        <div class="col-md-3 text-muted">Updated By:</div>
        <div class="col-md-3">@(Model.UpdatedBy ?? "N/A")</div>
        <div class="col-md-3 text-muted">Updated On:</div>
        <div class="col-md-3">@(Model.UpdatedOn?.ToString("dd MMM, yyyy hh:mm tt") ?? "N/A")</div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
