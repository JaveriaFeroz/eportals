@model ProcureToPay.Areas.Master.ViewModels.ServiceNatureCreateEditViewModel

<div class="modal-body">
    <form id="serviceNatureEditForm" method="post" asp-action="Edit" asp-controller="ServiceNature" asp-area="Master">
        @Html.AntiForgeryToken()
        @* Display validation summary at the top if there are model-level errors *@
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        @* Hidden input for the ServiceNatureId is crucial for the update *@
        <input type="hidden" asp-for="ServiceNature.NatureId" />

        @* ==== Card 1: Basic Information ==== *@
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-info-circle me-2"></i> Basic Information</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="ServiceNature.NatureName" class="form-label">NATURE Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-tag"></i></span>
                            <input asp-for="ServiceNature.NatureName" class="form-control" />
                        </div>
                        <span asp-validation-for="ServiceNature.NatureName" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Associated Purchase Natures <span class="text-danger">*</span></label>
                        <div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="ServiceNature.IsOpex">
                                <label class="form-check-label" for="@Html.IdFor(m => m.ServiceNature.IsOpex)">
                                    Opex
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="ServiceNature.IsCapex"> 
                                <label class="form-check-label" for="@Html.IdFor(m => m.ServiceNature.IsCapex)"> 
                                    Capex
                                </label>
                            </div>
                            <span asp-validation-for="ServiceNature.IsOpex" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ==== Card 2: Status ==== *@
        <div class="card mb-3">
            <div class="card-header bg-light">
                <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-user-cog me-2"></i> Status</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12 mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="ServiceNature.IsActive">
                            <label class="form-check-label" asp-for="ServiceNature.IsActive">Is Active</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1" style="color: white;"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}