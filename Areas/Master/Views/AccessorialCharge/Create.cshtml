@* Views/Master/AccessorialCharge/Create.cshtml *@
@model ProcureToPay.Areas.Master.Models.AccessorialChargeViewModel
@{
    ViewData["Title"] = "Create Accessorial Charge";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-plus me-2"></i> Create New Accessorial Charge
            </h5>
        </div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post" action="@Url.Action("Create", "AccessorialCharge", new { area = "Master" })">
                @Html.AntiForgeryToken()

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-info-circle me-2"></i> Charge Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="ChargeName" class="form-label">Charge Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;">
                                        <i class="fas fa-tag"></i>
                                    </span>
                                    <input type="text"
                                           id="chargeNameInput"
                                           name="ChargeName"
                                           class="form-control"
                                           placeholder="Enter charge name"
                                           value="@Model?.ChargeName"
                                           required />
                                </div>
                                @if (ViewData.ModelState["ChargeName"]?.Errors.Any() == true)
                                {
                                    <span class="text-danger">@ViewData.ModelState["ChargeName"].Errors.First().ErrorMessage</span>
                                }
                                <div id="chargeNameError" class="text-danger" style="display: none;"></div> @* Added for client-side error display *@
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="ChargeCode" class="form-label">Charge Code <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;">
                                        <i class="fas fa-barcode"></i>
                                    </span>
                                    <input type="text"
                                           id="chargeCodeInput"
                                           name="ChargeCode"
                                           class="form-control"
                                           placeholder="Enter charge code"
                                           value="@Model?.ChargeCode"
                                           required />
                                </div>
                                @if (ViewData.ModelState["ChargeCode"]?.Errors.Any() == true)
                                {
                                    <span class="text-danger">@ViewData.ModelState["ChargeCode"].Errors.First().ErrorMessage</span>
                                }
                                <div id="chargeCodeError" class="text-danger" style="display: none;"></div>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="d-flex justify-content-between mt-4">
                    <a href="@Url.Action("Index", "AccessorialCharge", new { area = "Master" })" class="btn btn-light text-primary">
                        <i class="fas fa-arrow-left me-1"></i> Back to List
                    </a>
                    <button type="submit" class="btn" style="background-color: #092963; color: white;" id="submitBtn">
                        <i class="fas fa-save me-1"></i> Create Charge
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            // Function to check if submit button should be disabled
            function checkSubmitButtonStatus() {
                const isChargeNameErrorVisible = $('#chargeNameError').is(':visible');
                const isChargeCodeErrorVisible = $('#chargeCodeError').is(':visible');
                $('#submitBtn').prop('disabled', isChargeNameErrorVisible || isChargeCodeErrorVisible);
            }

            // Client-side validation for Charge Name
            $('#chargeNameInput').on('blur', function() {
                var chargeName = $(this).val();
                if (chargeName) {
                    $.get('@Url.Action("CheckChargeNameExists", "AccessorialCharge", new { area = "Master" })', { chargeName: chargeName }, function(data) {
                        if (data.exists) {
                            $('#chargeNameError').text('A charge with this code already exists.').show(); // Using the requested error message
                        } else {
                            $('#chargeNameError').hide();
                        }
                        checkSubmitButtonStatus(); // Re-check button status after validation
                    });
                } else {
                    $('#chargeNameError').hide(); // Hide error if field is empty
                    checkSubmitButtonStatus();
                }
            });

            // Client-side validation for Charge Code
            $('#chargeCodeInput').on('blur', function() {
                var chargeCode = $(this).val();
                if (chargeCode) {
                    $.get('@Url.Action("CheckChargeCodeExists", "AccessorialCharge", new { area = "Master" })', { chargeCode: chargeCode }, function(data) {
                        if (data.exists) {
                            $('#chargeCodeError').text('A charge with this code already exists.').show();
                        } else {
                            $('#chargeCodeError').hide();
                        }
                        checkSubmitButtonStatus(); // Re-check button status after validation
                    });
                } else {
                    $('#chargeCodeError').hide(); // Hide error if field is empty
                    checkSubmitButtonStatus();
                }
            });

            // Initial check on page load in case of pre-filled values
            checkSubmitButtonStatus();
        });
    </script>
}
