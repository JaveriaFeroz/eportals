@model ProcureToPay.Areas.Master.Models.SubCategoryViewModel

<div class="modal-body">
    <form id="subCategoryEditForm" method="post" asp-action="Edit" asp-controller="SubCategory" asp-area="Master"
          data-area="Master" data-controller="SubCategory">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SubCategoryId" />
        <div class="mb-3">
            <label for="SubCategoryName" class="form-label">Type Name <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-dollar-sign"></i></span>
                <input id="SubCategoryName" name="SubCategoryName" class="form-control" value="@Model.SubCategoryName" required />
            </div>
            <span asp-validation-for="SubCategoryName" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label class="form-label"><i class="fas fa-power-off me-2"></i> Status</label>
            <div class="form-check form-switch">
                <input id="IsActive" name="IsActive" type="checkbox" class="form-check-input" value="true" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label" for="IsActive">Active</label>
                <input type="hidden" name="IsActive" value="false" />
            </div>
        </div>


        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1" style="color: white;"></i> Save Type
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}