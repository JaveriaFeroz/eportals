@model ProcureToPay.Areas.UserManagement.ViewModels.UsersIndexViewModel

@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/scripts.js" asp-append-version="true"></script>

<div class="container-fluid px-4 py-4">
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
        <li class="breadcrumb-item active">Index</li>
    </ol>

    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963; display: flex; justify-content: space-between; align-items: center;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-users me-2"></i> Users
            </h5>
        </div>
        <div class="card-body">

            <!-- Search Filters -->
            <div class="search-container mb-3">
                <div class="row g-3 align-items-center">
                    <div class="col-2">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-filter"></i></span>
                            <input type="text" class="form-control form-control-sm underline-input" id="usernameSearch" data-filter="username" placeholder="Username">
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-filter"></i></span>
                            <input type="text" class="form-control form-control-sm underline-input" id="emailSearch" data-filter="email" placeholder="Email">
                        </div>
                    </div>
                    <div class="col-2">
                        <select class="form-select form-select-sm underline-input" id="statusSearch" data-filter="status">
                            <option value="">All</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <div class="col-1">
                        <button class="btn btn-outline-secondary clear-button d-flex justify-content-between align-items-center"
                                style="padding: 0.5rem 1rem; font-size: 1rem; width: 100%; min-width: 120px;">
                            <span>Clear</span>
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    <div class="col-auto ms-auto">
                        <div class="create-user-container">
                            <button class="action-button create-user-text"
                                    data-url="@Url.Action("Create", "Users", new { area = "UserManagement" })"
                                    style="background-color: #092963;">
                                <i class="fas fa-plus"></i>
                                <span class="button-text"> Create User</span>
                            </button>
                            <a href="#" class="btn btn-sm create-user-icon">
                                <i class="fas fa-plus"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table Header -->
            <div class="row fw-bold bg-light border-bottom py-3 px-2 text-secondary">
                <div class="col-2 d-flex align-items-center">
                    <i class="fas fa-user me-1 text-dark"></i> USERNAME
                </div>
                <div class="col-2 d-flex align-items-center">
                    <i class="fas fa-id-card me-1 text-dark"></i> FULL NAME
                </div>
                <div class="col-2 d-flex align-items-center">
                    <i class="fas fa-envelope me-1 text-dark"></i> EMAIL
                </div>
                <div class="col-1 d-flex align-items-center justify-content-center">
                    <i class="fas fa-code-branch me-1 text-dark"></i> BRANCH
                </div>
                <div class="col-1 d-flex align-items-center justify-content-center">
                    <i class="fas fa-building me-1 text-dark"></i> DEPT
                </div>
                <div class="col-1 d-flex align-items-center justify-content-center">
                    <i class="fas fa-toggle-on me-1 text-dark"></i> STATUS
                </div>
                <div class="col-2 text-center d-flex align-items-center justify-content-center">
                    <i class="fas fa-cogs me-1 text-dark"></i> ACTIONS
                </div>
            </div>

            <!-- Table Body -->
            @foreach (var user in Model.Users)
            {
                <div class="row align-items-center border-bottom py-3 px-2 user-row" tabindex="0">
                    <div class="col-2 fw-bold">@user.UserName</div>
                    <div class="col-2">@user.FirstName @user.LastName</div>
                    <div class="col-2">@user.Email</div>
                    <div class="col-1 text-center">@(user.Branch?.BranchName ?? "N/A")</div>
                    <div class="col-1 text-center">@(user.Department?.DepartmentName ?? "N/A")</div>
                    <div class="col-1 text-center">
                        @if (user.IsActive)
                        {
                            <span class="badge status-badge">Active</span>
                        }
                        else
                        {
                            <span class="badge status-badge bg-danger">Inactive</span>
                        }
                    </div>
                    <div class="col-2 d-flex justify-content-center gap-1">
                        <button type="button" class="btn btn-sm text-warning edit-btn action-btn"
                                title="Edit" data-id="@user.Id" data-area="UserManagement" data-page="Users">
                            <i class="fas fa-edit icon-warning"></i>
                        </button>
                        <button type="button" class="btn btn-sm text-info details-btn action-btn"
                                title="Details" data-id="@user.Id" data-area="UserManagement" data-page="Users">
                            <i class="fas fa-info-circle icon-info"></i>
                        </button>
                        <button type="button" class="btn btn-sm text-danger delete-btn action-btn"
                                title="Delete" data-id="@user.Id" data-area="UserManagement" data-page="Users" data-user-username="@user.UserName">
                            <i class="fas fa-trash-alt icon-danger"></i>
                        </button>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-end mt-3">
                <a class="btn btn-light text-primary" href="/Home/Index">
                    <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                </a>
            </div>

        </div>
        @await Html.PartialAsync("UserModals")
    </div>
</div>
