@model ProcureToPay.Areas.Master.ViewModels.ProductNatureCreateEditViewModel
@{
    ViewData["Title"] = "Create Nature";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-plus me-2"></i> Create New Nature
            </h5>
        </div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post" action="@Url.Action("Create", "ProductNature", new { area = "Master" })" id="productNatureCreateForm">
                @Html.AntiForgeryToken()

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-info-circle me-2"></i> Product Nature Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="ProductNature.NatureName" class="form-label">Nature Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-tag"></i></span>
                                    <input asp-for="ProductNature.NatureName" class="form-control" placeholder="Enter product nature name" />
                                </div>
                                <span asp-validation-for="ProductNature.NatureName" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label">Associated Purchase Natures <span class="text-danger">*</span></label>
                                <div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" asp-for="ProductNature.IsOpex">
                                        <label class="form-check-label" for="@Html.IdFor(m => m.ProductNature.IsOpex)">Opex</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" asp-for="ProductNature.IsCapex">
                                        <label class="form-check-label" for="@Html.IdFor(m => m.ProductNature.IsCapex)">Capex</label>
                                    </div>
                                    <span id="opexCapexValidationError" class="text-danger"></span> 
                                </div>
                            </div>
                            
                            
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn" style="background-color: #092963; color: white;" id="submitBtn">
                        <i class="fas fa-save me-1"></i> Create Nature
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="text/javascript">
        $(document).ready(function () {
            // Get references to the checkboxes and the error span
            const opexCheckbox = $('#@Html.IdFor(m => m.ProductNature.IsOpex)');
            const capexCheckbox = $('#@Html.IdFor(m => m.ProductNature.IsCapex)');
            const errorSpan = $('#opexCapexValidationError');
            const form = $('#productNatureCreateForm');

            function validateOpexCapex() {
                if (!opexCheckbox.is(':checked') && !capexCheckbox.is(':checked')) {
                    errorSpan.text("At least one of 'Opex' or 'Capex' must be selected.");
                    return false; // Validation failed
                } else {
                    errorSpan.text(""); // Clear error message
                    return true; // Validation passed
                }
            }

            // Attach the validation function to the change event of both checkboxes
            opexCheckbox.on('change', validateOpexCapex);
            capexCheckbox.on('change', validateOpexCapex);

            form.on('submit', function(event) {
                // Run our custom validation. If it fails, prevent the default submit.
                if (!validateOpexCapex()) {
                    event.preventDefault(); // Stop the form from submitting
                }
                // If our custom validation passes, the form will submit and server-side validation will kick in.
            });

            // !!! REMOVED THE INITIAL CALL TO validateOpexCapex() HERE !!!
            // validateOpexCapex(); // <--- This line is commented out / removed
        });
    </script>
}