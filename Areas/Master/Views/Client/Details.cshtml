@model ProcureToPay.Areas.Master.Models.ClientViewModel

<div class="modal-body">

    @* ==== Card 1: Basic Information ==== *@
    <div class="card mb-3">
        <div class="card-header bg-light py-2">
            <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-info-circle me-2"></i> Basic Information</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Client Name:</div>
                        <div class="col-7">@Model.ClientName</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Short Name:</div>
                        <div class="col-7">@(Model.ShortName ?? "N/A")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ==== Card 2: Contact & Location ==== *@
    <div class="card mb-3">
        <div class="card-header bg-light py-2">
            <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-address-book me-2"></i> Contact & Location</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Contact Person:</div>
                        <div class="col-7">@(Model.ContactPerson ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Address:</div>
                        <div class="col-7">@(Model.Address ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Website URL:</div>
                        <div class="col-7">@(Model.URL ?? "N/A")</div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Contact Number:</div>
                        <div class="col-7">@(Model.ContactNo ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">Email:</div>
                        <div class="col-7">@(Model.Email ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted">City:</div>
                        <div class="col-7">@(Model.CityName ?? "N/A")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ==== Card 3: Business & Financial Details ==== *@
    <div class="card mb-3">
        <div class="card-header bg-light py-2">
            <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-briefcase me-2"></i> Business & Financials</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-6">
                    <div class="row mb-2"><div class="col-5 text-muted">Industry Vertical:</div><div class="col-7">@(Model.IndustryVerticalName ?? "N/A")</div></div>
                    <div class="row mb-2"><div class="col-5 text-muted">Contract Period:</div><div class="col-7">@(Model.ContractPeriod?.ToString() ?? "N/A") days</div></div>
                    <div class="row mb-2"><div class="col-5 text-muted">Credit Limit:</div><div class="col-7">@(Model.CreditLimit.ToString() ?? "N/A")</div></div>
                    <div class="row mb-2"><div class="col-5 text-muted">Rate Type:</div><div class="col-7">@(Model.RateTypeName ?? "N/A")</div></div>
                    <div class="row mb-2"><div class="col-5 text-muted">NTN:</div><div class="col-7">@(Model.NTN ?? "N/A")</div></div>
                    <div class="row mb-2"><div class="col-5 text-muted">Detention Grace:</div><div class="col-7">@(Model.DetGraceHRs?.ToString() ?? "N/A") hours</div></div>
                </div>
                <div class="col-lg-6">
                    <div class="row mb-2"><div class="col-5 text-muted">Company:</div><div class="col-7">@(Model.CompanyName ?? "N/A")</div></div>
                    <div class="row mb-2"><div class="col-5 text-muted">Payment Mode:</div><div class="col-7">@(Model.PaymentModeName ?? "N/A")</div></div>
                    <div class="row mb-2"><div class="col-5 text-muted">Credit Days:</div><div class="col-7">@(Model.CreditDays?.ToString() ?? "N/A")</div></div>
                    <div class="row mb-2"><div class="col-5 text-muted">Tax Rate:</div><div class="col-7">@Model.TaxRate?.ToString("N2")%</div></div>
                    <div class="row mb-2"><div class="col-5 text-muted">STRN:</div><div class="col-7">@(Model.STRN ?? "N/A")</div></div>
                    <div class="row mb-2"><div class="col-5 text-muted">CW Client ID:</div><div class="col-7">@(Model.CWClientId ?? "N/A")</div></div>
                </div>
            </div>
        </div>
    </div>

    @* ==== Card 4: Settings & Invoice Formats ==== *@
    <div class="card mb-3">
        <div class="card-header bg-light py-2">
            <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-cogs me-2"></i> Settings & Formats</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" asp-for="IsActive" disabled /><label class="form-check-label">Is Active</label></div></div>
                <div class="col-md-4"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" asp-for="CategoryMandatory" disabled /><label class="form-check-label">Category Mandatory</label></div></div>
                <div class="col-md-4"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" asp-for="ProductMandatory" disabled /><label class="form-check-label">Product Mandatory</label></div></div>
            </div>
            <hr />
            <p class="mb-2 fw-bold text-muted">Selected Invoice Formats:</p>
            <div>
                @foreach (var format in Model.InvoiceFormats.Where(f => f.IsSelected))
                {
                    <span class="badge bg-secondary me-1">@format.FormatName</span>
                }
                @if (!Model.InvoiceFormats.Any(f => f.IsSelected))
                {
                    <span>N/A</span>
                }
            </div>
        </div>
    </div>

    @* ==== Card 5: Audit Information ==== *@
    <hr class="my-4" />
    <h6 class="mb-3" style="color: #092963;"><i class="fas fa-history me-2"></i> Audit Information</h6>
    <div class="row mb-2">
        <div class="col-md-3 text-muted">Created By:</div>
        <div class="col-md-3">@Model.CreatedBy</div>
        <div class="col-md-3 text-muted">Created On:</div>
        <div class="col-md-3">@(Model.CreatedOn?.ToString("dd MMM, yyyy hh:mm tt") ?? "N/A")</div>
    </div>
    <div class="row mb-2">
        <div class="col-md-3 text-muted">Updated By:</div>
        <div class="col-md-3">@(Model.UpdatedBy ?? "N/A")</div>
        <div class="col-md-3 text-muted">Updated On:</div>
        <div class="col-md-3">@(Model.UpdatedOn?.ToString("dd MMM, yyyy hh:mm tt") ?? "N/A")</div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>

