@model ProcureToPay.Areas.Master.ViewModels.AssetStatusViewModel

<div class="modal-body">
    <form id="assetStatusEditForm" method="post" asp-action="Edit" asp-controller="AssetStatus" asp-area="Master"
          data-area="Master" data-controller="AssetStatus">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StatusId" />
        <div class="mb-3">
            <label for="StatusName" class="form-label">Status Name <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-dollar-sign"></i></span>
                <input id="StatusName" name="StatusName" class="form-control" value="@Model.StatusName" required />
            </div>
            <span asp-validation-for="StatusName" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label class="form-label"><i class="fas fa-power-off me-2"></i> Status</label>
            <div class="form-check form-switch">
                <input id="IsActive" name="IsActive" type="checkbox" class="form-check-input" value="true" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label" for="IsActive">Active</label>
                <input type="hidden" name="IsActive" value="false" />
            </div>
        </div>


        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1" style="color: white;"></i> Save Charge
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}