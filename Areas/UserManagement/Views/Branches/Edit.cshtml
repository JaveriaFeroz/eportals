@model ProcureToPay.Areas.UserManagement.Models.Branch

<div class="modal-body">
    <form id="branchEditForm" method="post" asp-action="Edit" asp-controller="Branches" asp-area="UserManagement"
          data-area="UserManagement" data-controller="Branches">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BranchId" />
        <div class="mb-3">
            <label for="BranchName" class="form-label">Branch Name <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-building"></i></span>
                <input id="BranchName" name="BranchName" class="form-control" value="@Model.BranchName" required />
            </div>
            <span asp-validation-for="BranchName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label for="BranchCode" class="form-label">Branch Code <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-code"></i></span>
                <input id="BranchCode" name="BranchCode" class="form-control" value="@Model.BranchCode" required />
            </div>
            <span asp-validation-for="BranchCode" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label"><i class="fas fa-power-off me-2"></i> Status</label>
            <div class="form-check form-switch">
                <input id="IsActive" name="IsActive" type="checkbox" class="form-check-input" value="true" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label" for="IsActive">Active</label>
                <input type="hidden" name="IsActive" value="false" />
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal" onclick="window.location.href='/UserManagement/Branches/Index';">Cancel</button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1" style="color: white;"></i> Save Branch
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
