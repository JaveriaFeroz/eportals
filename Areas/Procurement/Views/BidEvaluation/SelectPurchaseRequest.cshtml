@model IEnumerable<ProcureToPay.Areas.Procurement.Models.PurchaseRequest>

@{
    ViewData["Title"] = "Select Purchase Request for Bid Evaluation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
            <p class="text-muted">Select an approved Purchase Request to create a Bid Evaluation</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No approved Purchase Requests available for Bid Evaluation.
            <br />
            <small>Purchase Requests must be approved and not already have a Bid Evaluation.</small>
        </div>
        <a asp-controller="PurchaseRequest" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Purchase Requests
        </a>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-file-earmark-check"></i> Approved Purchase Requests
                    <span class="badge bg-primary ms-2">@Model.Count() Available</span>
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" id="purchaseRequestsTable">
                        <thead class="table-light">
                            <tr>
                                <th>PR Number</th>
                                <th>Title/Description</th>
                                <th>Request Date</th>
                                <th>Required Date</th>
                                <th>Department</th>
                                <th>Branch</th>
                                <th>Total Amount</th>
                                <th>Items</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pr in Model)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="PurchaseRequest" asp-action="Details" asp-route-id="@pr.Id"
                                           target="_blank" class="text-decoration-none">
                                            <strong>@pr.RequestNumber</strong>
                                            <i class="bi bi-box-arrow-up-right small"></i>
                                        </a>
                                        <br />
                                        <small class="text-muted">ID: @pr.Id</small>
                                    </td>
                                    <td>
                                        <strong>@pr.Title</strong>
                                        @if (!string.IsNullOrEmpty(pr.Description))
                                        {
                                            <br />
                                            <small class="text-muted">
                                                @(pr.Description.Length > 100
                                                                                    ? pr.Description.Substring(0, 100) + "..."
                                                                                    : pr.Description)
                                </small>
                                                                }
                                    </td>
                                    <td>
                                        <span class="badge bg-info">
                                            @pr.RequestDate.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        @if (pr.RequiredDate.HasValue)
                                        {
                                            var daysUntilRequired = (pr.RequiredDate.Value - DateTime.Now).Days;
                                            var urgencyClass = daysUntilRequired <= 7 ? "danger" : daysUntilRequired <= 14 ? "warning" : "success";
                                            <span class="badge bg-@urgencyClass">
                                                @pr.RequiredDate.Value.ToString("dd/MM/yyyy")
                                                <br />
                                                <small>(@daysUntilRequired days)</small>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not set</span>
                                        }
                                    </td>
                                    <td>
                                        @pr.Department?.DepartmentName
                                        @if (!string.IsNullOrEmpty(pr.DepartmentCode))
                                        {
                                            <br />
                                            <small class="text-muted">@pr.DepartmentCode</small>
                                        }
                                    </td>
                                    <td>
                                        @pr.Branch?.BranchName
                                        @if (!string.IsNullOrEmpty(pr.BranchCode))
                                        {
                                            <br />
                                            <small class="text-muted">@pr.BranchCode</small>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <strong>@pr.Items.Sum(i => i.TotalAmount).ToString("N2")</strong>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-list-ul"></i> @pr.Items.Count Item(s)
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="Create" asp-route-prNo="@pr.Id"
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-file-earmark-plus"></i> Create Bid Evaluation
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-info"
                                                onclick="showPRDetails(@pr.Id)">
                                            <i class="bi bi-eye"></i> Preview
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Bid Evaluations
            </a>
        </div>
    }
</div>

<!-- PR Details Preview Modal -->
<div class="modal fade" id="prDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Purchase Request Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="prDetailsContent">
                    <div class="text-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#purchaseRequestsTable').DataTable({
                order: [[1, 'desc']], // Order by Request Date descending
                pageLength: 10,
                responsive: true,
                language: {
                    search: "Search PRs:",
                    lengthMenu: "Show _MENU_ PRs per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ Purchase Requests"
                }
            });
        });

        function showPRDetails(prId) {
            var modal = new bootstrap.Modal(document.getElementById('prDetailsModal'));
            modal.show();

            // Load PR details via AJAX
            $.ajax({
                url: '@Url.Action("GetPRDetailsPartial", "PurchaseRequest")',
                type: 'GET',
                data: { id: prId },
                success: function(data) {
                    $('#prDetailsContent').html(data);
                },
                error: function() {
                    $('#prDetailsContent').html(
                        '<div class="alert alert-danger">' +
                        '<i class="bi bi-exclamation-triangle"></i> Error loading details. ' +
                        '<a href="@Url.Action("Details", "PurchaseRequest")/' + prId + '" target="_blank">Open in new tab</a>' +
                        '</div>'
                    );
                }
            });
        }
    </script>

    <style>
        .table td {
            vertical-align: middle;
        }

        .badge {
            font-weight: 500;
        }

        .btn-sm {
            white-space: nowrap;
        }
    </style>
}