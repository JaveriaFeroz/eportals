                    </div>
                }
            </div>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="d-none d-lg-flex align-items-center gap-3">
                    <div class="dropdown notification-dropdown">
                        <button class="btn btn-link text-dark" id="notificationsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-bell"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                            <div class="notification-header">
                                Notifications
                            </div>
                            <div class="notification-body">
                                <div class="notification-item">
                                    <div class="notification-icon bg-primary text-white">
                                        <i class="bi bi-receipt"></i>
                                    </div>
                                    <div class="notification-content">
                                        <div class="notification-title">New payment request</div>
                                        <div class="notification-text">John Smith submitted a payment request</div>
                                        <div class="notification-time">5 minutes ago</div>
                                    </div>
                                </div>
                                <div class="notification-item">
                                    <div class="notification-icon bg-success text-white">
                                        <i class="bi bi-check-circle"></i>
                                    </div>
                                    <div class="notification-content">
                                        <div class="notification-title">Request approved</div>
                                        <div class="notification-text">Your purchase order has been approved</div>
                                        <div class="notification-time">2 hours ago</div>
                                    </div>
                                </div>
                                <div class="notification-item">
                                    <div class="notification-icon bg-info text-white">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    <div class="notification-content">
                                        <div class="notification-title">New user registered</div>
                                        <div class="notification-text">Sarah Johnson joined the platform</div>
                                        <div class="notification-time">Yesterday</div>
                                    </div>
                                </div>
                            </div>
                            <div class="notification-footer">
                                <a href="#" class="text-decoration-none">View all notifications</a>
                            </div>
                        </div>
                    </div>

                    <!-- Create new button -->
                    <div class="dropdown">
                        <button class="btn btn-link text-dark" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-file-earmark-plus me-2"></i>New Document</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-person-plus me-2"></i>New User</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-receipt me-2"></i>New Request</a></li>
                        </ul>
                    </div>

                    <!-- Theme toggle button -->
                    <button class="btn btn-link text-dark" id="themeToggle">
                        <i class="bi bi-moon-fill"></i>
                    </button>

                    <!-- User Profile dropdown -->
                    <div class="dropdown profile-dropdown">
                        <div class="avatar-circle" data-bs-toggle="dropdown" aria-expanded="false" id="profileAvatar">
                            @(User.Identity.Name?.Substring(0, 2).ToUpper() ?? "US")
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="profileAvatar">
                            <li>
                                <div class="profile-header px-3 py-2">
                                    <p class="profile-header-name mb-1">@User.Identity.Name</p>
                                    <p class="profile-header-email">@(User.Claims.FirstOrDefault(c => c.Type == "email")?.Value ?? "user@example.com")</p>
                                </div>
                            </li>
                            <li>
                                <div class="color-picker-wrapper px-3">
                                    <span class="color-picker-label">Choose Avatar Color</span>
                                    <div class="color-options" id="colorOptions">
                                        <div class="color-option" style="background-color: #4f46e5;" data-color="#4f46e5"></div>
                                        <div class="color-option" style="background-color: #dc2626;" data-color="#dc2626"></div>
                                        <div class="color-option" style="background-color: #16a34a;" data-color="#16a34a"></div>
                                        <div class="color-option" style="background-color: #ca8a04;" data-color="#ca8a04"></div>
                                        <div class="color-option" style="background-color: #9333ea;" data-color="#9333ea"></div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>My Profile</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="Auth" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
