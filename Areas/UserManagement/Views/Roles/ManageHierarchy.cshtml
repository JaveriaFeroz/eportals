@model IEnumerable<ProcureToPay.Areas.UserManagement.Models.Role>

@{
    ViewData["Title"] = "Manage Role Hierarchy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/scripts.js" asp-append-version="true"></script>

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963; display: flex; justify-content: space-between; align-items: center;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-users-cog me-2"></i> Manage Role Hierarchy
            </h5>
        </div>
        <div class="card-body">
            <div class="row fw-bold bg-light border-bottom py-3 px-2 text-secondary">
                <div class="col-4 d-flex align-items-center">
                    <i class="fas fa-user-shield me-1 text-dark"></i> ROLE NAME
                </div>
                <div class="col-4 d-flex align-items-center">
                    <i class="fas fa-info-circle me-1 text-dark"></i> DESCRIPTION
                </div>
                <div class="col-4 text-center d-flex align-items-center justify-content-center">
                    <i class="fas fa-layer-group me-1 text-dark"></i> HIERARCHY LEVEL
                </div>
            </div>

            <form asp-action="UpdateHierarchy" method="post">
                <div id="sortable">
                    @foreach (var role in Model.OrderBy(r => r.HierarchyLevel))
                    {
                        <div class="row align-items-center border-bottom py-3 px-2 sortable-item" tabindex="0" data-role-id="@role.Id" data-hierarchy-level="@role.HierarchyLevel">
                            <div class="col-3 d-flex align-items-center">
                                <i class="bi bi-grip-vertical handle me-2"></i>
                                <input type="hidden" name="roleIds" value="@role.Id" />
                                @role.Name
                            </div>
                            <div class="col-3 text-start">
                                @role.Description
                            </div>
                            <div class="col-3 d-flex justify-content-center">
                                <input type="number" class="form-control hierarchy-level" name="hierarchyLevels" value="@role.HierarchyLevel" min="1" readonly />
                            </div>
                            <div class="col-3 d-flex justify-content-center">
                                <button type="button" class="btn btn-sm btn-danger delete-role" data-role-id="@role.Id">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-primary" style="background-color: #092963">Save Hierarchy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"
            integrity="sha256-VazP97ZCwtekAsvgPBSUwPFKdrwD3unUfSGVYrahUqU="
            crossorigin="anonymous"></script>
    <script>
        $(function() {
            $("#sortable").sortable({
                handle: '.handle',
                axis: 'y',
                update: function() {
                    // Update hierarchy levels after sorting
                    let level = 1;
                    $('#sortable .sortable-item').each(function() {
                        $(this).find('.hierarchy-level').val(level);
                        level++;
                    });
                }
            });

            // Add this new event listener
            $('.delete-role').on('click', function() {
                const roleIdToDelete = $(this).data('role-id');
                const roleItem = $(this).closest('.sortable-item');

                // Optional: Add a confirmation dialog
                if (confirm('Are you sure you want to delete this role from the hierarchy?')) {
                    // Remove the item from the list
                    roleItem.remove();

                    // Re-run the hierarchy level update function
                    let level = 1;
                    $('#sortable .sortable-item').each(function() {
                        $(this).find('.hierarchy-level').val(level);
                        level++;
                    });
                }
            });
        });
    </script>
}
