@model ProcureToPay.Areas.UserManagement.ViewModels.ManageRolePermissionsViewModel
@{
    ViewData["Title"] = $"Manage Permissions - {Model.Role.Name}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h2>@ViewData["Title"]</h2>

    <div class="mb-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Roles
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Manage" method="post">
        <input type="hidden" asp-for="@Model.Role.Id" name="id" />

        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span>Permissions for @Model.Role.Name</span>
                <div>
                    <button type="submit" class="btn btn-light">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <button type="button" id="selectAllBtn" class="btn btn-light ms-2">
                        <i class="fas fa-check-square"></i> Select All
                    </button>
                    <button type="button" id="deselectAllBtn" class="btn btn-light ms-2">
                        <i class="fas fa-square"></i> Deselect All
                    </button>
                </div>
            </div>
            <div class="card-body">
                <ul class="nav nav-tabs" id="permissionTabs" role="tablist">
                    @foreach (var module in Model.Modules)
                    {
                        var moduleId = module.Replace(" ", "").ToLower();
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(module == Model.Modules.First() ? "active" : "")"
                                    id="@moduleId-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#@moduleId"
                                    type="button"
                                    role="tab"
                                    aria-controls="@moduleId"
                                    aria-selected="@(module == Model.Modules.First())">
                                @module
                            </button>
                        </li>
                    }
                </ul>

                <div class="tab-content mt-3" id="permissionTabContent">
                    @foreach (var module in Model.Modules)
                    {
                        var moduleId = module.Replace(" ", "").ToLower();
                        <div class="tab-pane fade @(module == Model.Modules.First() ? "show active" : "")"
                             id="@moduleId"
                             role="tabpanel"
                             aria-labelledby="@moduleId-tab">

                            <div class="row">
                                <div class="col-12">
                                    <div class="d-flex justify-content-between mb-2">
                                        <h5>@module Permissions</h5>
                                        <div>
                                            <button type="button" class="btn btn-sm btn-outline-primary select-module"
                                                    data-module="@module">
                                                Select All in @module
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary deselect-module ms-2"
                                                    data-module="@module">
                                                Deselect All in @module
                                            </button>
                                        </div>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover">
                                            <thead>
                                                <tr>
                                                    <th style="width: 40px;"></th>
                                                    <th>Permission</th>
                                                    <th>Description</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var permission in Model.Permissions.Where(p => p.Module.Name == module))
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="form-check">
                                                                <input type="checkbox"
                                                                       class="form-check-input permission-checkbox"
                                                                       id="permission_@permission.Id"
                                                                       name="selectedPermissions"
                                                                       value="@permission.Id"
                                                                       data-module="@permission.Module"
                                                                @(Model.AssignedPermissionIds.Contains(permission.Id) ? "checked" : "") />
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <label class="form-check-label" for="permission_@permission.Id">
                                                                @permission.Name
                                                            </label>
                                                        </td>
                                                        <td>@permission.Description</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Select all permissions
            $('#selectAllBtn').click(function() {
                $('.permission-checkbox').prop('checked', true);
            });

            // Deselect all permissions
            $('#deselectAllBtn').click(function() {
                $('.permission-checkbox').prop('checked', false);
            });

            // Select all permissions in a module
            $('.select-module').click(function() {
                var module = $(this).data('module');
                $('.permission-checkbox[data-module="' + module + '"]').prop('checked', true);
            });

            // Deselect all permissions in a module
            $('.deselect-module').click(function() {
                var module = $(this).data('module');
                $('.permission-checkbox[data-module="' + module + '"]').prop('checked', false);
            });
        });
    </script>
}