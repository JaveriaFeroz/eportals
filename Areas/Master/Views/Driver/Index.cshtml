@model ProcureToPay.Areas.Master.Models.DriverIndexViewModel

@{
    ViewData["Title"] = "Drivers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/scripts.js" asp-append-version="true"></script>

<div class="container-fluid px-4 py-4">
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item">Master</li>
        <li class="breadcrumb-item active">Drivers</li>
    </ol>

    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963; display: flex; justify-content: space-between; align-items: center;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-users me-2"></i> Drivers Management
            </h5>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <div class="search-container mb-3">
                <div class="row g-3 align-items-center">
                    <div class="col-2">
                        <div class="input-group">
                            <span class="input-group-text" id="DriverSearchIcon">
                                <i class="fas fa-filter" style="font-size: 1rem;"></i>
                            </span>
                            <input type="text" class="form-control form-control-sm underline-input" id="driverSearch" placeholder="Driver Name">
                        </div>
                    </div>

                    <div class="col-2">
                        <div class="input-group">
                            <span class="input-group-text" id="contractorSearchIcon">
                                <i class="fas fa-filter" style="font-size: 1rem;"></i>
                            </span>
                            <input type="text" class="form-control form-control-sm underline-input" id="contractorSearch" placeholder="Contractor Name">
                        </div>
                    </div>

                    <div class="col-2">
                        <div class="input-group">
                            <span class="input-group-text" id="branchSearchIcon">
                                <i class="fas fa-filter" style="font-size: 1rem;"></i>
                            </span>
                            <input type="text" class="form-control form-control-sm underline-input" id="branchSearch" placeholder="Branch Name">
                        </div>
                    </div>


                    <div class="col-2">
                        <select class="form-select form-select-sm underline-input" id="statusSearch">
                            <option value="">All</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <div class="col-1">
                        <button class="btn btn-outline-secondary clear-button d-flex justify-content-between align-items-center"
                                style="padding: 0.5rem 1rem; font-size: 1rem; width: 100%; min-width: 120px;">
                            <span>Clear</span>
                            <i class="fas fa-times" style="font-size: 1rem;"></i>
                        </button>
                    </div>

                    <div class="col-auto ms-auto">
                        <div class="create-user-container">
                            <button class="action-button create-user-text"
                                    data-url="@Url.Action("Create", "Driver", new { area = "Master" })"
                                    style="background-color: #092963;">
                                <i class="fas fa-plus"></i>
                                <span class="button-text"> Add New Driver</span>
                            </button>
                            <a href="#" class="btn btn-sm create-user-icon">
                                <i class="fas fa-plus"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row fw-bold bg-light border-bottom py-3 px-2 text-secondary d-none d-md-flex">
                
                <div class="col-md-2 d-flex align-items-center">
                    <i class="fas fa-user-tie me-2 text-dark"></i>DRIVER NAME</div>
                    <div class="col-md-2 d-flex align-items-center"><i class="fas fa-id-badge me-2 text-dark"></i>DESIGNATION</div>
                    <div class="col-md-1 d-flex align-items-center"><i class="fas fa-hard-hat me-2 text-dark"></i>CONTRACTOR</div>
                    <div class="col-md-1 d-flex align-items-center"><i class="fas fa-code-branch me-2 text-dark"></i>BRANCH</div>
                    <div class="col-md-1 d-flex justify-content-center align-items-center"><i class="fas fa-toggle-on me-2 text-dark"></i>STATUS</div>
                    <div class="col-md-2 d-flex align-items-center"><i class="fas fa-user-clock text-dark me-2"></i>CREATED</div>
                    <div class="col-md-2 d-flex align-items-center"><i class="fas fa-history text-dark me-2"></i>UPDATED</div>
                    <div class="col-md-1 text-center d-flex align-items-center justify-content-center"><i class="fas fa-cogs me-2 text-dark"></i>ACTIONS</div>
                
                </div>
                
                @if (Model.Drivers.Any())
            {
                foreach (var item in Model.Drivers)
                {
                    <div class="row align-items-center border-bottom py-3 px-2 user-row" tabindex="0">
                        
                        <div class="col-12 col-md-2 fw-bold"><span class="d-md-none fw-bold"><i class="fas fa-user-tie me-2"></i>Name: </span>@item.DriverName</div>
                        <div class="col-12 col-md-2"><span class="d-md-none fw-bold"><i class="fas fa-id-badge me-2"></i>Designation: </span>@(item.Designation ?? "N/A")</div>
                        <div class="col-12 col-md-1"><span class="d-md-none fw-bold"><i class="fas fa-hard-hat me-2"></i>Contractor: </span>@(item.ContractorName ?? "N/A")</div>
                        <div class="col-12 col-md-1"><span class="d-md-none fw-bold"><i class="fas fa-code-branch me-2"></i>Branch: </span>@(item.BranchName ?? "N/A")</div>
                        <div class="col-12 col-md-1 text-md-center"><span class="d-md-none fw-bold"><i class="fas fa-toggle-on me-2"></i>Status: </span>@if (item.IsActive)
                            {
                                <span class="badge status-badge">Active</span>
                            }
                            else
                            {
                                <span class="badge status-badge bg-danger">Inactive</span>
                            }
                        </div>
                        
                        @* Created Audit Info *@
                        <div class="col-6 col-md-2 small">
                            <div title="Created by"><i class="fas fa-user-edit me-1 text-muted"></i> @item.CreatedBy</div>
                            <div title="Created on" class="text-muted"><i class="fas fa-calendar-alt me-1"></i> @item.CreatedOn.ToString("dd MMM yyyy")</div>
                        </div>

                        @* Updated Audit Info *@
                        <div class="col-6 col-md-2 small">
                            <div title="Updated by"><i class="fas fa-user-edit me-1 text-muted"></i> @(item.UpdatedBy ?? "N/A")</div>
                            <div title="Updated on" class="text-muted"><i class="fas fa-calendar-alt me-1"></i> @(item.UpdatedOn?.ToString("dd MMM yyyy") ?? "N/A")</div>
                        </div>

                        @* Action Buttons *@
                        <div class="col-12 col-md-1 d-flex justify-content-start justify-content-md-center gap-1 mt-2 mt-md-0">
                            <button type="button" class="btn btn-sm text-warning edit-btn action-btn"
                                    title="Edit" data-id="@item.DriverId" data-area="Master" data-page="Driver">
                                <i class="fas fa-edit icon-warning"></i>
                            </button>
                            <button type="button" class="btn btn-sm text-info details-btn action-btn"
                                    title="Details" data-id="@item.DriverId" data-area="Master" data-page="Driver">
                                <i class="fas fa-info-circle icon-info"></i>
                            </button>
                            <button type="button" class="btn btn-sm text-danger delete-btn action-btn"
                                    title="Delete" data-id="@item.DriverId" data-area="Master" data-page="Driver" data-name="@item.DriverName">
                                <i class="fas fa-trash-alt icon-danger"></i>
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="row"><div class="col-12 text-center text-muted py-4"><i class="fas fa-inbox fa-2x mb-2"></i><br />No drivers found.</div></div>
            }
        </div>
        @await Html.PartialAsync("_DriverModals")
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}