                        <a class="nav-link text-dark py-2" asp-area="Auth" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> LOGIN
                        </a>
                    </div>
                }
            </div>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="d-none d-lg-flex align-items-center gap-3">
                    <div class="dropdown profile-dropdown">
                        <div class="avatar-circle" data-bs-toggle="dropdown" aria-expanded="false" id="profileAvatar">
                            @(User.Identity.Name?.Substring(0, 2).ToUpper() ?? "US")
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="profileAvatar">
                            <li>
                                <div class="profile-header px-3 py-2">
                                    @{
                                        var user = await UserManager.GetUserAsync(User);
                                        if (user != null)
                                        {
                                            <p class="profile-header-name mb-1">@user.FirstName @user.LastName</p>
                                            <p class="profile-header-email">@user.Email</p>
                                        }
                                        else
                                        {
                                            <p class="profile-header-name mb-1">Guest User</p>
                                            <p class="profile-header-email">N/A</p>
                                        }
                                    }
                                </div>
                            </li>

                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="#"
                                                     data-bs-toggle="modal"
                                                     data-bs-target="#changePasswordModal"
                                                     id="changePasswordLink"
                                                     data-url="@Url.Action("ChangePassword", "Account", new { area = "Auth" })">
                                    <i class="bi bi-key-fill me-2"></i> Change Password
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="Auth" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            }
        </div>
