@model ProcureToPay.Areas.Auth.Models.ChangePasswordViewModel

<div class="modal-header" style="background-color: #092963">
    <h5 class="modal-title text-white" id="changePasswordModalLabel">
        <i class="bi bi-key-fill me-2"></i>Change Password
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <div id="passwordModalContent">
        @* The alert container will be added dynamically by JavaScript *@

        <form asp-area="Auth" asp-controller="Account" asp-action="ChangePassword" method="post" id="changePasswordForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="UserId" type="hidden" />
            <input asp-for="UserName" type="hidden" />
            <input asp-for="ForceChange" type="hidden" />

            <div class="form-group mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" type="password" required **autocomplete="new-password" ** />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" type="password" required **autocomplete="new-password" ** />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" required **autocomplete="new-password" ** />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn" style="background-color: #092963; color: white;">
                    <i class="bi bi-arrow-repeat me-2"></i>Change Password
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Get the modal container and its content area
            const changePasswordModal = document.getElementById('changePasswordModal');
            const modalContent = changePasswordModal.querySelector('.modal-content');

            // Event listener for when the modal is first shown
            changePasswordModal.addEventListener('show.bs.modal', function () {
                // Fetch and load the initial modal content (the empty form)
                const url = document.getElementById('changePasswordLink').getAttribute('data-url');
                fetch(url)
                    .then(response => response.text())
                    .then(html => {
                        modalContent.innerHTML = html;
                    });
            });

            // Event delegation for form submission inside the modal
            modalContent.addEventListener('submit', function (e) {
                // Only act if the submitted form has the ID 'changePasswordForm'
                if (e.target.id === 'changePasswordForm') {
                    e.preventDefault(); // Prevent default form submission
                    const form = e.target;
                    const formData = new FormData(form);

                    fetch(form.action, {
                        method: form.method,
                        body: formData,
                        headers: {
                            'RequestVerificationToken': formData.get('__RequestVerificationToken')
                        }
                    })
                    .then(response => {
                        // Check if the response is a redirect
                        if (response.redirected) {
                            window.location.href = response.url;
                            return;
                        }

                        // Check if the response is JSON or HTML
                        const contentType = response.headers.get("content-type");
                        if (contentType && contentType.indexOf("application/json") !== -1) {
                            return response.json(); // It's a JSON response
                        } else {
                            return response.text(); // It's an HTML response
                        }
                    })
                    .then(data => {
                        // If 'data' is a string, it's HTML. Re-inject it.
                        if (typeof data === 'string') {
                            modalContent.innerHTML = data;
                            // Re-enable client-side validation for the new form content
                            $.validator.unobtrusive.parse(document.getElementById('changePasswordForm'));
                        }
                        // If 'data' is an object, it's JSON.
                        else if (typeof data === 'object') {
                            // This part handles the case where the server returns JSON
                            // (e.g., the 'User not found' error)
                            if (data.success) {
                                // This block won't be hit with your current C# code
                                // because the server redirects on success.
                            } else {
                                // Handle the JSON error
                                const modalBody = modalContent.querySelector('.modal-body');
                                let errorMessages = data.message;
                                if (data.errors && data.errors.length > 0) {
                                    errorMessages += '<ul>' + data.errors.map(err => `<li>${err}</li>`).join('') + '</ul>';
                                }
                                const alertHtml = `<div class="alert alert-danger alert-dismissible fade show" role="alert"><strong>Error:</strong> ${errorMessages}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>`;
                                modalBody.insertAdjacentHTML('afterbegin', alertHtml);
                            }
                        }
                    })
                    .catch(error => {
                        console.error('An unexpected error occurred:', error);
                        const alertHtml = `<div class="alert alert-danger" role="alert">An unexpected error occurred.</div>`;
                        const modalBody = modalContent.querySelector('.modal-body');
                        modalBody.insertAdjacentHTML('afterbegin', alertHtml);
                    });
                }
            });
        });
    </script>
}