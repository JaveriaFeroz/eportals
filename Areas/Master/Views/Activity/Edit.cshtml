@model ProcureToPay.Areas.Master.ViewModels.ActivityViewModel

<form id="activityEditForm" method="post" asp-action="Edit" asp-controller="Activity" asp-area="Master"
      data-area="Master" data-controller="Activity">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ActivityId" />

    <div class="mb-3">
        <label for="ActivityName" class="form-label">Activity Name <span class="text-danger">*</span></label>
        <div class="input-group">
            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-tasks"></i></span>
            <input id="ActivityName" name="ActivityName" class="form-control" value="@Model.ActivityName" required />
        </div>
        <span asp-validation-for="ActivityName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label for="EstHrsReq" class="form-label">Estimated Hours Required <span class="text-danger">*</span></label>
        <div class="input-group">
            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-hourglass-half"></i></span>
            <input id="EstHrsReq" name="EstHrsReq" type="number" class="form-control" value="@Model.EstHrsReq" required min="0" />
        </div>zzz
        <span asp-validation-for="EstHrsReq" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label"><i class="fas fa-power-off me-2"></i> Status</label>
        <div class="form-check form-switch">
            <input id="IsActive" name="IsActive" type="checkbox" class="form-check-input" value="true" @(Model.IsActive ? "checked" : "") />
            <label class="form-check-label" for="IsActive">Active</label>
            <input type="hidden" name="IsActive" value="false" /> @* Hidden field for unchecked checkbox value *@
        </div>
    </div>

    <div class="d-flex justify-content-end mt-4">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn" style="background-color: #092963; color: white;">
            <i class="fas fa-save me-1" style="color: white;"></i> Save Activity
        </button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}