@model ProcureToPay.Areas.UserManagement.ViewModels.UserDetailsViewModel

<div class="modal-body">
    <form method="post" asp-action="Edit" asp-controller="Users" asp-area="UserManagement" asp-route-id="@Model.User?.Id">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="UserName" class="form-label">Username <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;">
                    <i class="fas fa-user"></i>
                </span>
                <input id="UserName" name="UserName" class="form-control" value="@Model.User.UserName" readonly />
            </div>
            <span asp-validation-for="User.UserName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;">
                    <i class="fas fa-user-tag"></i>
                </span>
                <input id="FullName" name="FullName" class="form-control" value="@Model.User.FirstName @Model.User.LastName" readonly />
            </div>
            <span asp-validation-for="User.UserName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label for="Email" class="form-label">Email <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;">
                    <i class="fas fa-envelope"></i>
                </span>
                <input id="Email" name="Email" class="form-control" value="@Model.User.Email" readonly />
            </div>
            <span asp-validation-for="User.Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label for="Branch" class="form-label">Branch</label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;">
                    <i class="fas fa-building"></i>
                </span>
                <input id="Branch" name="Branch" class="form-control" value="@(Model.User.Branch?.BranchName ?? "N/A")" readonly />
            </div>
        </div>

        <div class="mb-3">
            <label for="Department" class="form-label">Department</label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;">
                    <i class="fas fa-users-cog"></i>
                </span>
                <input id="Department" name="Department" class="form-control" value="@(Model.User.Department?.DepartmentName ?? "N/A")" readonly />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label"><i class="fas fa-power-off me-2"></i> Status</label>
            <div class="form-check form-switch">
                <input id="IsActive" name="IsActive" type="checkbox" class="form-check-input" value="true" @(Model.User.IsActive ? "checked" : "") disabled />
                <label class="form-check-label" for="IsActive">Active</label>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
        </div>

    </form>
    @await Html.PartialAsync("UserModals")
</div>
