@* This partial defines the modal structures and JavaScript logic for InsuranceTypes. *@

<div class="modal fade" id="insuranceTypeEditModal" tabindex="-1" aria-labelledby="insuranceTypeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="insuranceTypeEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit InsuranceType
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="insuranceTypeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="insuranceTypeDetailsModal" tabindex="-1" aria-labelledby="insuranceTypeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="insuranceTypeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> InsuranceType Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="insuranceTypeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="insuranceTypeDeleteModal" tabindex="-1" aria-labelledby="insuranceTypeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="insuranceTypeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete InsuranceType: <span id="deleteModalInsuranceTypeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete insuranceType <strong id="deleteModalInsuranceTypeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="insuranceTypeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>



<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the InsuranceType Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachInsuranceTypeEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('skuCategoriesEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleInsuranceTypeEditFormSubmit);
                editForm.addEventListener('submit', handleInsuranceTypeEditFormSubmit);

                // Re-parse insuranceType-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("InsuranceType-side validation re-parsed for #skuCategoriesEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. InsuranceType-side validation may not work for insuranceType form.");
                }
            } else {
                console.warn("#skuCategoriesEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the InsuranceType Edit form submission (AJAX) ---
        async function handleInsuranceTypeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform insuranceType-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("InsuranceType-side validation failed for insuranceType form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const insuranceTypeEditModalBodyElement = document.getElementById('insuranceTypeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const insuranceTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('insuranceTypeEditModal'));
                        if (insuranceTypeEditModalInstance) {
                            insuranceTypeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "InsuranceType updated successfully!");
                        } else {
                            console.log("InsuranceType update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("InsuranceType update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const insuranceTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('insuranceTypeEditModal'));
                        if (insuranceTypeEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                insuranceTypeEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    insuranceTypeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("InsuranceType validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachInsuranceTypeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during insuranceType form submission:', error);
                const insuranceTypeEditModalBodyElement = document.getElementById('insuranceTypeEditModalBody');
                if (insuranceTypeEditModalBodyElement) {
                     insuranceTypeEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for InsuranceType Delete form submission (AJAX) ---
        async function handleInsuranceTypeDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete insuranceType with an error.");
                    } else {
                        console.error("InsuranceType delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "InsuranceType deleted successfully!");
                    } else {
                        console.log("InsuranceType deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete insuranceType.");
                    } else {
                        console.error("InsuranceType delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during insuranceType delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during insuranceType deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during insuranceType deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit InsuranceType Modal Opener
        document.querySelectorAll('.edit-btn[data-page="InsuranceType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Insurance', 'InsuranceType', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('insuranceTypeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('insuranceTypeEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachInsuranceTypeEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details InsuranceType Modal Opener
        document.querySelectorAll('.details-btn[data-page="InsuranceType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Insurance', 'InsuranceType', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('insuranceTypeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('insuranceTypeDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete InsuranceType Modal Opener
        document.querySelectorAll('.delete-btn[data-page="InsuranceType"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const insuranceTypeName = this.getAttribute('data-name');
                const url = getUrl('Insurance', 'InsuranceType', 'Delete', id);

                document.getElementById('deleteModalInsuranceTypeName').textContent = insuranceTypeName;
                document.getElementById('deleteModalInsuranceTypeNameConfirm').textContent = insuranceTypeName;

                const deleteForm = document.getElementById('insuranceTypeDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleInsuranceTypeDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleInsuranceTypeDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('insuranceTypeDeleteModal')).show();
            });
        });

        
    });
</script>