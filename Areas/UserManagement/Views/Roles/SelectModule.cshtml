@model IEnumerable<ProcureToPay.Areas.UserManagement.Models.Module>

@{
    ViewData["Title"] = "Select Module for Role Hierarchy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/scripts.js" asp-append-version="true"></script>

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-cubes me-2"></i> Select Module for Role Hierarchy
            </h5>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <p class="text-muted mb-0 ms-4">Choose a module to manage its role hierarchy and assign roles appropriately.</p>
                <div class="create-user-container">
                    <button class="action-button create-user-text"
                            data-url="@Url.Action("Create", "Modules", new { area = "UserManagement" })"
                            style="background-color: #092963; transition: background-color 0.3s ease;">
                        <i class="fas fa-plus"></i>
                        <span class="button-text"> Create Module</span>
                    </button>
                    <a href="#" class="btn btn-sm create-user-icon">
                        <i class="fas fa-plus"></i>
                    </a>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var module in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <h5 class="card-title fw-bold">@module.DisplayName</h5>
                                <p class="card-text">@module.Description</p>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a href="@Url.Action("ManageModuleHierarchy", "Roles", new { area = "UserManagement", moduleName = module.Name })"
                                   class="btn btn-primary w-100" style="background-color: #092963">
                                    <i class="fas fa-sitemap me-2"></i> Manage Hierarchy
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>
