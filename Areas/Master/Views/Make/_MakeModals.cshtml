@* This partial defines the modal structures and JavaScript logic for Makes. *@

<div class="modal fade" id="makeEditModal" tabindex="-1" aria-labelledby="makeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="makeEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Make
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="makeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="makeDetailsModal" tabindex="-1" aria-labelledby="makeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="makeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Make Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="makeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="makeDeleteModal" tabindex="-1" aria-labelledby="makeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="makeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Make: <span id="deleteModalMakeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete make <strong id="deleteModalMakeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="makeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Make Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachMakeEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('makeEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleMakeEditFormSubmit);
                editForm.addEventListener('submit', handleMakeEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #makeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for make form.");
                }
            } else {
                console.warn("#makeEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Make Edit form submission (AJAX) ---
        async function handleMakeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for make form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const makeEditModalBodyElement = document.getElementById('makeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const makeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('makeEditModal'));
                        if (makeEditModalInstance) {
                            makeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Make updated successfully!");
                        } else {
                            console.log("Make update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Make update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const makeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('makeEditModal'));
                        if (makeEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                makeEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    makeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Make validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachMakeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during make form submission:', error);
                const makeEditModalBodyElement = document.getElementById('makeEditModalBody');
                if (makeEditModalBodyElement) {
                     makeEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Make Delete form submission (AJAX) ---
        async function handleMakeDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete make with an error.");
                    } else {
                        console.error("Make delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Make deleted successfully!");
                    } else {
                        console.log("Make deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete make.");
                    } else {
                        console.error("Make delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during make delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during make deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during make deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Make Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Make"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Make', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('makeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('makeEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachMakeEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Make Modal Opener
        document.querySelectorAll('.details-btn[data-page="Make"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Make', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('makeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('makeDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Make Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Make"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const makeName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Make', 'Delete', id);

                document.getElementById('deleteModalMakeName').textContent = makeName;
                document.getElementById('deleteModalMakeNameConfirm').textContent = makeName;

                const deleteForm = document.getElementById('makeDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleMakeDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleMakeDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('makeDeleteModal')).show();
            });
        });
    });
</script>