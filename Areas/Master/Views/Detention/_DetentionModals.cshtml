@* This partial defines the modal structures and JavaScript logic for Detentions. *@

<div class="modal fade" id="detentionEditModal" tabindex="-1" aria-labelledby="detentionEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="detentionEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Detention
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detentionEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="detentionDetailsModal" tabindex="-1" aria-labelledby="detentionDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="detentionDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Detention Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detentionDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="detentionDeleteModal" tabindex="-1" aria-labelledby="detentionDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="detentionDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Detention: <span id="deleteModalDetentionName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete detention <strong id="deleteModalDetentionNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="detentionDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Detention Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachDetentionEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('detentionEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleDetentionEditFormSubmit);
                editForm.addEventListener('submit', handleDetentionEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #detentionEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for detention form.");
                }
            } else {
                console.warn("#detentionEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Detention Edit form submission (AJAX) ---
        async function handleDetentionEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for detention form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const detentionEditModalBodyElement = document.getElementById('detentionEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const detentionEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('detentionEditModal'));
                        if (detentionEditModalInstance) {
                            detentionEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Detention updated successfully!");
                        } else {
                            console.log("Detention update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Detention update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const detentionEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('detentionEditModal'));
                        if (detentionEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                detentionEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    detentionEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Detention validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachDetentionEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during detention form submission:', error);
                const detentionEditModalBodyElement = document.getElementById('detentionEditModalBody');
                if (detentionEditModalBodyElement) {
                     detentionEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Detention Delete form submission (AJAX) ---
        async function handleDetentionDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete detention with an error.");
                    } else {
                        console.error("Detention delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Detention deleted successfully!");
                    } else {
                        console.log("Detention deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete detention.");
                    } else {
                        console.error("Detention delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during detention delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during detention deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during detention deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Detention Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Detention"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Detention', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('detentionEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('detentionEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachDetentionEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Detention Modal Opener
        document.querySelectorAll('.details-btn[data-page="Detention"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Detention', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('detentionDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('detentionDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Detention Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Detention"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const detentionName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Detention', 'Delete', id);

                document.getElementById('deleteModalDetentionName').textContent = detentionName;
                document.getElementById('deleteModalDetentionNameConfirm').textContent = detentionName;

                const deleteForm = document.getElementById('detentionDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleDetentionDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleDetentionDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('detentionDeleteModal')).show();
            });
        });
    });
</script>