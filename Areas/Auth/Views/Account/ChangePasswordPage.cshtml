@model ProcureToPay.Areas.Auth.Models.ChangePasswordViewModel

@{
    Layout = "_AuthLayout";
}
<div class="login-container">
    <div class="left-section">
        <div class="logo">
            <span class="logo-text">ProcureToPay DSV</span>
        </div>
        <h2 class="whats-new-heading">What's new</h2>
        <div class="updates-container">
            @if (Model.Updates != null && Model.Updates.Any())
            {
                @foreach (var update in Model.Updates)
                {
                    <div class="update-item">
                        <div class="update-date">@update.CreatedDate.ToString("MMMM dd, yyyy h:mm tt")</div>
                        <div class="update-title">@update.Title</div>
                        <div class="update-content">
                            @if (update.Content.Length > 150)
                            {
                                @(update.Content.Substring(0, 150))

                            }
                            else
                            {
                                @update.Content
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="update-item">
                    <div class="update-date">@DateTime.Now.ToString("MMMM dd, yyyy h:mm tt")</div>
                    <div class="update-title">Welcome to ePortal</div>
                    <div class="update-content">No updates available at this time. Check back soon for the latest news and features!</div>
                </div>
            }
        </div>
    </div>
    <div class="right-section">
        <div class="login-area">
            <h1>Change Password</h1>
            <form asp-area="Auth" asp-controller="Account" asp-action="ChangePasswordPage" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="UserId" type="hidden" />
                <input asp-for="UserName" type="hidden" />
                <input asp-for="ForceChange" type="hidden" />

                <div class="form-group mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-control" type="password" required **autocomplete="new-password" ** />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" type="password" required **autocomplete="new-password" ** />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" required **autocomplete="new-password" ** />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn" style="background-color: #092963; color: white;">
                        <i class="bi bi-arrow-repeat me-2"></i>Change Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
