@* This partial defines the modal structures and JavaScript logic for Citys. *@

<div class="modal fade" id="cityEditModal" tabindex="-1" aria-labelledby="cityEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="cityEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit City
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="cityEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cityDetailsModal" tabindex="-1" aria-labelledby="cityDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="cityDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> City Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="cityDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cityDeleteModal" tabindex="-1" aria-labelledby="cityDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="cityDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete City: <span id="deleteModalCityName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete city <strong id="deleteModalCityNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="cityDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the City Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachCityEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('cityEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleCityEditFormSubmit);
                editForm.addEventListener('submit', handleCityEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #cityEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for city form.");
                }
            } else {
                console.warn("#cityEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the City Edit form submission (AJAX) ---
        async function handleCityEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for city form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const cityEditModalBodyElement = document.getElementById('cityEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const cityEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('cityEditModal'));
                        if (cityEditModalInstance) {
                            cityEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "City updated successfully!");
                        } else {
                            console.log("City update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("City update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const cityEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('cityEditModal'));
                        if (cityEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                cityEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    cityEditModalBodyElement.innerHTML = responseHtml;
                    console.log("City validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachCityEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during city form submission:', error);
                const cityEditModalBodyElement = document.getElementById('cityEditModalBody');
                if (cityEditModalBodyElement) {
                     cityEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for City Delete form submission (AJAX) ---
        async function handleCityDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete city with an error.");
                    } else {
                        console.error("City delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "City deleted successfully!");
                    } else {
                        console.log("City deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete city.");
                    } else {
                        console.error("City delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during city delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during city deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during city deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit City Modal Opener
        document.querySelectorAll('.edit-btn[data-page="City"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'City', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('cityEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('cityEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachCityEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details City Modal Opener
        document.querySelectorAll('.details-btn[data-page="City"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'City', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('cityDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('cityDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete City Modal Opener
        document.querySelectorAll('.delete-btn[data-page="City"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const cityName = this.getAttribute('data-name');
                const url = getUrl('Master', 'City', 'Delete', id);

                document.getElementById('deleteModalCityName').textContent = cityName;
                document.getElementById('deleteModalCityNameConfirm').textContent = cityName;

                const deleteForm = document.getElementById('cityDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleCityDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleCityDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('cityDeleteModal')).show();
            });
        });
    });
</script>