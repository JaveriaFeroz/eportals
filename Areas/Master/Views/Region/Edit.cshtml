@model ProcureToPay.Areas.Master.ViewModels.RegionCreateEditViewModel

<div class="modal-body">
    <form id="regionEditForm" method="post" asp-action="Edit" asp-controller="Region" asp-area="Master"
          data-area="Master" data-controller="Region">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Region.RegionId" /> @* Hidden field for the ID *@

        <div class="mb-3">
            <label asp-for="Region.RegionName" class="form-label">Region Name <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-globe-americas"></i></span>
                <input asp-for="Region.RegionName" class="form-control" /> @* Using asp-for for proper binding and validation *@
            </div>
            <span asp-validation-for="Region.RegionName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Region.TaxRate" class="form-label">Tax Rate <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-percent"></i></span>
                <input asp-for="Region.TaxRate" class="form-control" type="number" step="0.01" /> @* type="number" and step for decimal input *@
            </div>
            <span asp-validation-for="Region.TaxRate" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label class="form-label"><i class="fas fa-power-off me-2"></i> Status</label>
            <div class="form-check form-switch">
                <input asp-for="Region.IsActive" class="form-check-input" type="checkbox" />
                <label class="form-check-label" asp-for="Region.IsActive">Active</label>
                <input type="hidden" asp-for="Region.IsActive" value="false" />
            </div>
            <span asp-validation-for="Region.IsActive" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1" style="color: white;"></i> Save Region
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}