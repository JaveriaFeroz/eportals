@* This partial defines the modal structures and JavaScript logic for Consignees. *@

<div class="modal fade" id="consigneeEditModal" tabindex="-1" aria-labelledby="consigneeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="consigneeEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Consignee
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="consigneeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="consigneeDetailsModal" tabindex="-1" aria-labelledby="consigneeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="consigneeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Consignee Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="consigneeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="consigneeDeleteModal" tabindex="-1" aria-labelledby="consigneeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="consigneeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Consignee: <span id="deleteModalConsigneeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete consignee <strong id="deleteModalConsigneeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="consigneeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Consignee Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachConsigneeEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('consigneeEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleConsigneeEditFormSubmit);
                editForm.addEventListener('submit', handleConsigneeEditFormSubmit);

                // Re-parse consignee-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Consignee-side validation re-parsed for #consigneeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Consignee-side validation may not work for consignee form.");
                }
            } else {
                console.warn("#consigneeEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Consignee Edit form submission (AJAX) ---
        async function handleConsigneeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform consignee-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Consignee-side validation failed for consignee form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const consigneeEditModalBodyElement = document.getElementById('consigneeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const consigneeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('consigneeEditModal'));
                        if (consigneeEditModalInstance) {
                            consigneeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Consignee updated successfully!");
                        } else {
                            console.log("Consignee update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Consignee update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const consigneeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('consigneeEditModal'));
                        if (consigneeEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                consigneeEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    consigneeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Consignee validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachConsigneeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during consignee form submission:', error);
                const consigneeEditModalBodyElement = document.getElementById('consigneeEditModalBody');
                if (consigneeEditModalBodyElement) {
                     consigneeEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Consignee Delete form submission (AJAX) ---
        async function handleConsigneeDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete consignee with an error.");
                    } else {
                        console.error("Consignee delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Consignee deleted successfully!");
                    } else {
                        console.log("Consignee deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete consignee.");
                    } else {
                        console.error("Consignee delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during consignee delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during consignee deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during consignee deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Consignee Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Consignee"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Consignee', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('consigneeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('consigneeEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachConsigneeEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Consignee Modal Opener
        document.querySelectorAll('.details-btn[data-page="Consignee"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Consignee', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('consigneeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('consigneeDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Consignee Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Consignee"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const consigneeName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Consignee', 'Delete', id);

                document.getElementById('deleteModalConsigneeName').textContent = consigneeName;
                document.getElementById('deleteModalConsigneeNameConfirm').textContent = consigneeName;

                const deleteForm = document.getElementById('consigneeDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleConsigneeDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleConsigneeDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('consigneeDeleteModal')).show();
            });
        });
    });
</script>