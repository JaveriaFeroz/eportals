@* This partial defines the modal structures and JavaScript logic for PaymentTypes. *@

<div class="modal fade" id="paymentTypeEditModal" tabindex="-1" aria-labelledby="paymentTypeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="paymentTypeEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit PaymentType
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="paymentTypeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentTypeDetailsModal" tabindex="-1" aria-labelledby="paymentTypeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="paymentTypeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> PaymentType Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="paymentTypeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentTypeDeleteModal" tabindex="-1" aria-labelledby="paymentTypeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="paymentTypeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete PaymentType: <span id="deleteModalPaymentTypeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete paymentType <strong id="deleteModalPaymentTypeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="paymentTypeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the PaymentType Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachPaymentTypeEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('paymentTypeEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handlePaymentTypeEditFormSubmit);
                editForm.addEventListener('submit', handlePaymentTypeEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #paymentTypeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for paymentType form.");
                }
            } else {
                console.warn("#paymentTypeEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the PaymentType Edit form submission (AJAX) ---
        async function handlePaymentTypeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for paymentType form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const paymentTypeEditModalBodyElement = document.getElementById('paymentTypeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const paymentTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('paymentTypeEditModal'));
                        if (paymentTypeEditModalInstance) {
                            paymentTypeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "PaymentType updated successfully!");
                        } else {
                            console.log("PaymentType update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("PaymentType update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const paymentTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('paymentTypeEditModal'));
                        if (paymentTypeEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                paymentTypeEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    paymentTypeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("PaymentType validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachPaymentTypeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during paymentType form submission:', error);
                const paymentTypeEditModalBodyElement = document.getElementById('paymentTypeEditModalBody');
                if (paymentTypeEditModalBodyElement) {
                     paymentTypeEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for PaymentType Delete form submission (AJAX) ---
        async function handlePaymentTypeDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete paymentType with an error.");
                    } else {
                        console.error("PaymentType delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "PaymentType deleted successfully!");
                    } else {
                        console.log("PaymentType deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete paymentType.");
                    } else {
                        console.error("PaymentType delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during paymentType delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during paymentType deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during paymentType deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit PaymentType Modal Opener
        document.querySelectorAll('.edit-btn[data-page="PaymentType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'PaymentType', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('paymentTypeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('paymentTypeEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachPaymentTypeEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details PaymentType Modal Opener
        document.querySelectorAll('.details-btn[data-page="PaymentType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'PaymentType', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('paymentTypeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('paymentTypeDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete PaymentType Modal Opener
        document.querySelectorAll('.delete-btn[data-page="PaymentType"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const paymentTypeName = this.getAttribute('data-name');
                const url = getUrl('Master', 'PaymentType', 'Delete', id);

                document.getElementById('deleteModalPaymentTypeName').textContent = paymentTypeName;
                document.getElementById('deleteModalPaymentTypeNameConfirm').textContent = paymentTypeName;

                const deleteForm = document.getElementById('paymentTypeDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handlePaymentTypeDeleteFormSubmit);
                deleteForm.addEventListener('submit', handlePaymentTypeDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('paymentTypeDeleteModal')).show();
            });
        });
    });
</script>