@model ProcureToPay.Areas.Master.ViewModels.CityIndexViewModel

@{
    ViewData["Title"] = "Cities";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/scripts.js" asp-append-version="true"></script>

<div class="container-fluid px-4 py-4">

    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-city me-2"></i> Cities
            </h5>
        </div>
        <div class="card-body">

            @* Success and Error Messages (No changes here) *@
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @* Search and Filter Controls (No changes here) *@
            <div class="search-container mb-3">
                <div class="row g-3 align-items-center">
                    <div class="col-2">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-filter"></i></span>
                            <input type="text" class="form-control form-control-sm underline-input" id="citySearch"
                                   placeholder="City Name" data-filter="cityName">
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-filter"></i></span>
                            <input type="text" class="form-control form-control-sm underline-input" id="cityCodeSearch"
                                   placeholder="City Code" data-filter="cityCode">
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-filter"></i></span>
                            <select class="form-select form-select-sm underline-input" id="regionSearch" data-filter="region">
                                <option value="">All Regions</option>
                                @foreach (var region in Model.Regions)
                                {
                                    <option value="@region.Text">@region.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-2">
                        <select class="form-select form-select-sm underline-input" id="statusSearch" data-filter="status">
                            <option value="">All</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="col-1">
                        <button class="btn btn-outline-secondary clear-button d-flex justify-content-between align-items-center"
                                style="padding: 0.5rem 1rem; font-size: 1rem; width: 100%; min-width: 120px;">
                            <span>Clear</span>
                            <i class="fas fa-times" style="font-size: 1rem;"></i>
                        </button>
                    </div>
                    <div class="col-auto ms-auto">
                        <div class="create-user-container">
                            <button class="action-button create-user-text"
                                    data-url="@Url.Action("Create", "City", new { area = "Master" })"
                                    style="background-color: #092963;">
                                <i class="fas fa-plus"></i>
                                <span class="button-text"> Add New City</span>
                            </button>
                            <a href="#" class="btn btn-sm create-user-icon">
                                <i class="fas fa-plus"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row fw-bold bg-light border-bottom py-3 px-2 text-secondary d-none d-md-flex">
                <div class="col-md-3 d-flex align-items-center"><i class="fas fa-city text-dark me-2"></i>CITY NAME</div>
                <div class="col-md-1 d-flex align-items-center"><i class="fas fa-hashtag text-dark me-2"></i>CODE</div>
                <div class="col-md-2 d-flex align-items-center"><i class="fas fa-map-marker-alt text-dark me-2"></i>REGION</div>
                <div class="col-md-1 d-flex align-items-center justify-content-center"><i class="fas fa-toggle-on text-dark me-2"></i>STATUS</div>
                <div class="col-md-2 d-flex align-items-center"><i class="fas fa-user-clock text-dark me-2"></i>CREATED</div>
                <div class="col-md-2 d-flex align-items-center"><i class="fas fa-history text-dark me-2"></i>UPDATED</div>
                <div class="col-md-1 text-center d-flex align-items-center justify-content-center"><i class="fas fa-cogs text-dark me-2"></i>ACTIONS</div>
            </div>

            @if (Model.Cities.Any())
            {
                @foreach (var city in Model.Cities)
                {
                    <div class="row align-items-center border-bottom py-3 px-2 user-row" tabindex="0">

                        <div class="col-12 col-md-3" data-column="cityName">
                            <strong class="fw-bold">@city.CityName</strong>
                        </div>

                        <div class="col-6 col-md-1" data-column="cityCode">
                            <span class="badge status-badge bg-secondary">@city.CityCode</span>
                        </div>

                        <div class="col-6 col-md-2" data-column="region">
                            @city.RegionName
                        </div>

                        <div class="col-6 col-md-1 text-md-center"
                             data-column="status"
                             data-status="@(city.IsActive ? "active" : "inactive")">
                            @if (city.IsActive)
                            {
                                <span class="badge status-badge">Active</span>
                            }
                            else
                            {
                                <span class="badge status-badge bg-danger">Inactive</span>
                            }
                        </div>
                        <div class="col-6 col-md-2 small">
                            <div title="Created by"><i class="fas fa-user-edit me-1 text-muted"></i> @city.CreatedBy</div>
                            <div title="Created on" class="text-muted"><i class="fas fa-calendar-alt me-1"></i> @city.CreatedOn.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="col-6 col-md-2 small">
                            <div title="Updated by"><i class="fas fa-user-edit me-1 text-muted"></i> @(city.UpdatedBy ?? "N/A")</div>
                            <div title="Updated on" class="text-muted"><i class="fas fa-calendar-alt me-1"></i> @(city.UpdatedOn?.ToString("dd MMM yyyy") ?? "N/A")</div>
                        </div>
                        <div class="col-12 col-md-1 d-flex justify-content-md-center gap-1 mt-2 mt-md-0">

                            <button type="button" class="btn btn-sm text-warning edit-btn action-btn"
                                    title="Edit" data-id="@city.CityId" data-area="Master" data-page="City">
                                <i class="fas fa-edit icon-warning"></i>
                            </button>

                            <button type="button" class="btn btn-sm text-info details-btn action-btn"
                                    title="Details" data-id="@city.CityId" data-area="Master" data-page="City">
                                <i class="fas fa-info-circle icon-info"></i>
                            </button>

                        @*     <button type="button" class="btn btn-sm text-danger delete-btn action-btn"
                                    title="Delete" data-id="@city.CityId" data-area="Master" data-page="City" data-city-name="@city.CityName">
                                <i class="fas fa-trash-alt icon-danger"></i>
                            </button> *@

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="row">
                    <div class="col-12 text-center text-muted py-4">
                        <i class="fas fa-inbox fa-2x mb-2"></i>
                        <br>No cities found.
                    </div>
                </div>
            }
        </div>
        @await Html.PartialAsync("_CityModals")
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}