@* This partial defines the modal structures and JavaScript logic for PaymentNatures. *@

<div class="modal fade" id="paymentNatureEditModal" tabindex="-1" aria-labelledby="paymentNatureEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="paymentNatureEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit PaymentNature
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="paymentNatureEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentNatureDetailsModal" tabindex="-1" aria-labelledby="paymentNatureDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="paymentNatureDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> PaymentNature Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="paymentNatureDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentNatureDeleteModal" tabindex="-1" aria-labelledby="paymentNatureDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="paymentNatureDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete PaymentNature: <span id="deleteModalPaymentNatureName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete paymentNature <strong id="deleteModalPaymentNatureNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="paymentNatureDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the PaymentNature Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachPaymentNatureEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('paymentNatureEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handlePaymentNatureEditFormSubmit);
                editForm.addEventListener('submit', handlePaymentNatureEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #paymentNatureEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for paymentNature form.");
                }
            } else {
                console.warn("#paymentNatureEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the PaymentNature Edit form submission (AJAX) ---
        async function handlePaymentNatureEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for paymentNature form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const paymentNatureEditModalBodyElement = document.getElementById('paymentNatureEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const paymentNatureEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('paymentNatureEditModal'));
                        if (paymentNatureEditModalInstance) {
                            paymentNatureEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "PaymentNature updated successfully!");
                        } else {
                            console.log("PaymentNature update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("PaymentNature update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const paymentNatureEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('paymentNatureEditModal'));
                        if (paymentNatureEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                paymentNatureEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    paymentNatureEditModalBodyElement.innerHTML = responseHtml;
                    console.log("PaymentNature validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachPaymentNatureEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during paymentNature form submission:', error);
                const paymentNatureEditModalBodyElement = document.getElementById('paymentNatureEditModalBody');
                if (paymentNatureEditModalBodyElement) {
                     paymentNatureEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for PaymentNature Delete form submission (AJAX) ---
        async function handlePaymentNatureDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete paymentNature with an error.");
                    } else {
                        console.error("PaymentNature delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "PaymentNature deleted successfully!");
                    } else {
                        console.log("PaymentNature deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete paymentNature.");
                    } else {
                        console.error("PaymentNature delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during paymentNature delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during paymentNature deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during paymentNature deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit PaymentNature Modal Opener
        document.querySelectorAll('.edit-btn[data-page="PaymentNature"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'PaymentNature', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('paymentNatureEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('paymentNatureEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachPaymentNatureEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details PaymentNature Modal Opener
        document.querySelectorAll('.details-btn[data-page="PaymentNature"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'PaymentNature', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('paymentNatureDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('paymentNatureDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete PaymentNature Modal Opener
        document.querySelectorAll('.delete-btn[data-page="PaymentNature"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const paymentNatureName = this.getAttribute('data-name');
                const url = getUrl('Master', 'PaymentNature', 'Delete', id);

                document.getElementById('deleteModalPaymentNatureName').textContent = paymentNatureName;
                document.getElementById('deleteModalPaymentNatureNameConfirm').textContent = paymentNatureName;

                const deleteForm = document.getElementById('paymentNatureDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handlePaymentNatureDeleteFormSubmit);
                deleteForm.addEventListener('submit', handlePaymentNatureDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('paymentNatureDeleteModal')).show();
            });
        });
    });
</script>