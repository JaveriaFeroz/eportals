@* This partial defines the modal structures and JavaScript logic for InsuranceDocumentTypes. *@

<div class="modal fade" id="insuranceDocumentTypeEditModal" tabindex="-1" aria-labelledby="insuranceDocumentTypeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="insuranceDocumentTypeEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Insurance Document Type
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="insuranceDocumentTypeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="insuranceDocumentTypeDetailsModal" tabindex="-1" aria-labelledby="insuranceDocumentTypeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="insuranceDocumentTypeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Insurance Document Type Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="insuranceDocumentTypeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="insuranceDocumentTypeDeleteModal" tabindex="-1" aria-labelledby="insuranceDocumentTypeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="insuranceDocumentTypeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Document Type: <span id="deleteModalInsuranceDocumentTypeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete Document Type <strong id="deleteModalInsuranceDocumentTypeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="insuranceDocumentTypeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the InsuranceDocumentType Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachInsuranceDocumentTypeEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('insuranceDocumentTypeEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleInsuranceDocumentTypeEditFormSubmit);
                editForm.addEventListener('submit', handleInsuranceDocumentTypeEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #insuranceDocumentTypeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for insuranceDocumentType form.");
                }
            } else {
                console.warn("#insuranceDocumentTypeEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the InsuranceDocumentType Edit form submission (AJAX) ---
        async function handleInsuranceDocumentTypeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for insuranceDocumentType form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const insuranceDocumentTypeEditModalBodyElement = document.getElementById('insuranceDocumentTypeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const insuranceDocumentTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('insuranceDocumentTypeEditModal'));
                        if (insuranceDocumentTypeEditModalInstance) {
                            insuranceDocumentTypeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "InsuranceDocumentType updated successfully!");
                        } else {
                            console.log("InsuranceDocumentType update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("InsuranceDocumentType update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const insuranceDocumentTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('insuranceDocumentTypeEditModal'));
                        if (insuranceDocumentTypeEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                insuranceDocumentTypeEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    insuranceDocumentTypeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("InsuranceDocumentType validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachInsuranceDocumentTypeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during insuranceDocumentType form submission:', error);
                const insuranceDocumentTypeEditModalBodyElement = document.getElementById('insuranceDocumentTypeEditModalBody');
                if (insuranceDocumentTypeEditModalBodyElement) {
                     insuranceDocumentTypeEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for InsuranceDocumentType Delete form submission (AJAX) ---
        async function handleInsuranceDocumentTypeDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete insuranceDocumentType with an error.");
                    } else {
                        console.error("InsuranceDocumentType delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "InsuranceDocumentType deleted successfully!");
                    } else {
                        console.log("InsuranceDocumentType deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete insuranceDocumentType.");
                    } else {
                        console.error("InsuranceDocumentType delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during insuranceDocumentType delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during insuranceDocumentType deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during insuranceDocumentType deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit InsuranceDocumentType Modal Opener
        document.querySelectorAll('.edit-btn[data-page="InsuranceDocumentType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'InsuranceDocumentType', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('insuranceDocumentTypeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('insuranceDocumentTypeEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachInsuranceDocumentTypeEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details InsuranceDocumentType Modal Opener
        document.querySelectorAll('.details-btn[data-page="InsuranceDocumentType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'InsuranceDocumentType', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('insuranceDocumentTypeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('insuranceDocumentTypeDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete InsuranceDocumentType Modal Opener
        document.querySelectorAll('.delete-btn[data-page="InsuranceDocumentType"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const insuranceDocumentTypeName = this.getAttribute('data-name');
                const url = getUrl('Master', 'InsuranceDocumentType', 'Delete', id);

                document.getElementById('deleteModalInsuranceDocumentTypeName').textContent = insuranceDocumentTypeName;
                document.getElementById('deleteModalInsuranceDocumentTypeNameConfirm').textContent = insuranceDocumentTypeName;

                const deleteForm = document.getElementById('insuranceDocumentTypeDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleInsuranceDocumentTypeDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleInsuranceDocumentTypeDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('insuranceDocumentTypeDeleteModal')).show();
            });
        });
    });
</script>