@* This partial defines the modal structures and JavaScript logic for Regions. *@

<div class="modal fade" id="regionEditModal" tabindex="-1" aria-labelledby="regionEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="regionEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Region
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="regionEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="regionDetailsModal" tabindex="-1" aria-labelledby="regionDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="regionDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Region Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="regionDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="regionDeleteModal" tabindex="-1" aria-labelledby="regionDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="regionDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Region: <span id="deleteModalRegionName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete region <strong id="deleteModalRegionNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="regionDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Region Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachRegionEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('regionEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleRegionEditFormSubmit);
                editForm.addEventListener('submit', handleRegionEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #regionEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for region form.");
                }
            } else {
                console.warn("#regionEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Region Edit form submission (AJAX) ---
        async function handleRegionEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for region form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const regionEditModalBodyElement = document.getElementById('regionEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const regionEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('regionEditModal'));
                        if (regionEditModalInstance) {
                            regionEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Region updated successfully!");
                        } else {
                            console.log("Region update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Region update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const regionEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('regionEditModal'));
                        if (regionEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                regionEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    regionEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Region validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachRegionEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during region form submission:', error);
                const regionEditModalBodyElement = document.getElementById('regionEditModalBody');
                if (regionEditModalBodyElement) {
                     regionEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Region Delete form submission (AJAX) ---
        async function handleRegionDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete region with an error.");
                    } else {
                        console.error("Region delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Region deleted successfully!");
                    } else {
                        console.log("Region deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete region.");
                    } else {
                        console.error("Region delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during region delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during region deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during region deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Region Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Region"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Region', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('regionEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('regionEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachRegionEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Region Modal Opener
        document.querySelectorAll('.details-btn[data-page="Region"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Region', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('regionDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('regionDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Region Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Region"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const regionName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Region', 'Delete', id);

                document.getElementById('deleteModalRegionName').textContent = regionName;
                document.getElementById('deleteModalRegionNameConfirm').textContent = regionName;

                const deleteForm = document.getElementById('regionDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleRegionDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleRegionDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('regionDeleteModal')).show();
            });
        });
    });
</script>