@* This partial defines the modal structures and JavaScript logic for Assets. *@

<div class="modal fade" id="assetEditModal" tabindex="-1" aria-labelledby="assetEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="assetEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Asset
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="assetEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="assetDetailsModal" tabindex="-1" aria-labelledby="assetDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="assetDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Asset Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="assetDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="assetDeleteModal" tabindex="-1" aria-labelledby="assetDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="assetDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Asset: <span id="deleteModalAssetName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete asset <strong id="deleteModalAssetNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="assetDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Asset Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachAssetEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('assetEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleAssetEditFormSubmit);
                editForm.addEventListener('submit', handleAssetEditFormSubmit);

                // Re-parse asset-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Asset-side validation re-parsed for #assetEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Asset-side validation may not work for asset form.");
                }
            } else {
                console.warn("#assetEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Asset Edit form submission (AJAX) ---
        async function handleAssetEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform asset-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Asset-side validation failed for asset form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const assetEditModalBodyElement = document.getElementById('assetEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const assetEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('assetEditModal'));
                        if (assetEditModalInstance) {
                            assetEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Asset updated successfully!");
                        } else {
                            console.log("Asset update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Asset update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const assetEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('assetEditModal'));
                        if (assetEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                assetEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    assetEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Asset validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachAssetEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during asset form submission:', error);
                const assetEditModalBodyElement = document.getElementById('assetEditModalBody');
                if (assetEditModalBodyElement) {
                     assetEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Asset Delete form submission (AJAX) ---
        async function handleAssetDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete asset with an error.");
                    } else {
                        console.error("Asset delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Asset deleted successfully!");
                    } else {
                        console.log("Asset deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete asset.");
                    } else {
                        console.error("Asset delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during asset delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during asset deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during asset deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Asset Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Asset"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Asset', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('assetEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('assetEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachAssetEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Asset Modal Opener
        document.querySelectorAll('.details-btn[data-page="Asset"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Asset', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('assetDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('assetDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Asset Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Asset"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const assetName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Asset', 'Delete', id);

                document.getElementById('deleteModalAssetName').textContent = assetName;
                document.getElementById('deleteModalAssetNameConfirm').textContent = assetName;

                const deleteForm = document.getElementById('assetDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleAssetDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleAssetDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('assetDeleteModal')).show();
            });
        });
    });
</script>