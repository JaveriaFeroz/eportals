@using ProcureToPay.Areas.Finance.ViewModels;
@using ProcureToPay.Areas.Common.Models;
@model ProcureToPay.Areas.Finance.ViewModels.PaymentRequestDetailsViewModel

@{
    ViewData["Title"] = "Payment Request Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var workflowHistory = ViewBag.WorkflowHistory as List<FormHistory>;
    var currentStateName = ViewBag.CurrentStateName as string;
    var currentUserId = ViewBag.CurrentUserId;
    var currentUserName = ViewBag.CurrentUserName;
    var currentUserRoles = ViewBag.CurrentUserRoles as List<int> ?? new List<int>();
    bool hasAttachments = Model.Attachments != null && Model.Attachments.Any();
    bool canAddPiVNo = (currentUserRoles.Contains(23));
    bool canAddCSNo = (currentUserRoles.Contains(29));
}


<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/scripts.js" asp-append-version="true"></script>

<div class="container-fluid px-4 py-4">
    <div class="row">
        <div class="col-12">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
                </div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    <i class="fas fa-info-circle me-2"></i>@TempData["Info"]
                </div>
            }
            @if (!hasAttachments)
            {
                <div class="alert alert-warning" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i> Add Attachment To Submit!
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header" style="background-color: #092963; display: flex; justify-content: space-between; align-items: center;">
                    <h5 class="card-title text-white mb-0">
                        <i class="fas fa-money-check-alt me-2"></i> Payment Request Details
                    </h5>
                    <div>
                        <span class="badge bg-info fs-6">@Model.StateName</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">PRQ Number:</dt>
                                <dd class="col-sm-8">@Model.PRQNumber</dd>

                                <dt class="col-sm-4">Payee Name:</dt>
                                <dd class="col-sm-8">@Model.PayeeName</dd>

                                <dt class="col-sm-4">Required Date:</dt>
                                <dd class="col-sm-8">@Model.RequiredDate.ToString("dd/MM/yyyy")</dd>

                                <dt class="col-sm-4">Payment Nature:</dt>
                                <dd class="col-sm-8">@Model.PaymentNatureName</dd>

                                <dt class="col-sm-4">Payment Sub-Nature:</dt>
                                <dd class="col-sm-8">@Model.PaymentSubNatureName</dd>

                                <dt class="col-sm-4">Branch:</dt>
                                <dd class="col-sm-8">@Model.BranchName</dd>

                                <dt class="col-sm-4">Department:</dt>
                                <dd class="col-sm-8">@Model.DepartmentName</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">GRN Number:</dt>
                                <dd class="col-sm-8">
                                    @if (!string.IsNullOrEmpty(Model.GRNNumber))
                                    {
                                        <a asp-area="Receiving" asp-controller="GRN" asp-action="Details" asp-route-id="@Model.GRNId" class="text-decoration-none" @* target="_blank" *@>
                                            @Model.GRNNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span>N/A</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Created On:</dt>
                                <dd class="col-sm-8">@Model.CreatedOn.ToString("dd/MM/yyyy HH:mm")</dd>

                                <dt class="col-sm-4">Created By:</dt>
                                <dd class="col-sm-8">@Model.CreatedByUserName</dd>

                                <dt class="col-sm-4">Remarks:</dt>
                                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Remarks) ? "N/A" : Model.Remarks)</dd>



                                @if (!string.IsNullOrEmpty(Model.SupplierName))
                                {
                                    <dt class="col-sm-4">Supplier:</dt>
                                    <dd class="col-sm-8">@Model.SupplierName</dd>
                                }

                                @if (!string.IsNullOrEmpty(Model.PIVNo))
                                {
                                    <dt class="col-sm-4">PIV No:</dt>
                                    <dd class="col-sm-8">@Model.PIVNo</dd>
                                }

                                @if (!string.IsNullOrEmpty(Model.CSNo))
                                {
                                    <dt class="col-sm-4">CS No:</dt>
                                    <dd class="col-sm-8">@Model.CSNo</dd>
                                }
                            </dl>
                        </div>
                    </div>
                    @if (Model.StateId == 1 && Model.CreatedByUserName == currentUserName)
                    {
                        <hr />
                        <div class="card shadow border-0 mt-3">
                            <div class="card-header" style="background-color: #092963;">
                                <h5 class="card-title text-white mb-0">
                                    <i class="fas fa-plus me-2"></i> Add New Attachments
                                </h5>
                            </div>
                            <div class="card-body">
                                <form asp-action="AddAttachments" asp-controller="PaymentRequest" asp-area="Finance" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="paymentRequestId" value="@Model.Id" />
                                    <div class="row">
                                        <div class="col-md-3 mb-3">
                                            <label asp-for="AttachmentTypeId" class="form-label">Attachment Type <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text custom-blue">
                                                    <i class="fas fa-tags"></i>
                                                </span>
                                                <select asp-for="AttachmentTypeId" class="form-select" asp-items="@Model.AttachmentTypes">
                                                    <option value="">-Select Attachment Type-</option>
                                                </select>
                                            </div>
                                            <span asp-validation-for="AttachmentTypeId" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="fileInput" class="form-label">Attachments <span class="text-danger">*</span></label>
                                            <input type="file" id="fileInput" name="Attachments" multiple class="form-control" required>
                                        </div>
                                        
                                        <div class="col-md-3 mb-3 d-flex align-items-end">
                                            <button type="submit" class="btn btn-primary w-100" style="background-color: #092963;">
                                                <i class="fas fa-upload me-2"></i> Upload
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>

           
            <div class="card shadow border-0 mt-3">
                <div class="card-header" style="background-color: #092963;">
                    <h5 class="card-title text-white mb-0">
                        <i class="fas fa-list-alt me-2"></i> Request Details
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Details != null && Model.Details.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>

                                        <th>Invoice No</th>
                                        <th>Invoice Date</th>
                                        <th>Description</th>
                                        <th>Amount (Ex Tax)</th>
                                        <th>ST Rate %</th>
                                        <th>Other Tax</th>
                                        <th>Total Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Details)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(modelItem => item.InvoiceNo)</td>
                                            <td>@(item.InvoiceDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                            <td>@Html.DisplayFor(modelItem => item.Description)</td>
                                            <td>@item.AmountExTax.ToString("C")</td>
                                            <td>@item.STRate.ToString("N2")%</td>
                                            <td>@item.OtherTax.ToString("C")</td>
                                            <td>@item.TotalAmount.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-info text-end">
                                        <th colspan="7">Grand Total: <strong>@Model.TotalAmount.ToString("C")</strong></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No details found for this Payment Request.</p>
                    }
                </div>
            </div>

            @if (string.IsNullOrEmpty(Model.GRNNumber) || Model.GRNNumber == "N/A")
            {
                <div class="card shadow border-0 mt-3">
                    <div class="card-header" style="background-color: #092963;">
                        <h5 class="card-title text-white mb-0">
                            <i class="fas fa-list-alt me-2"></i> CostAllocations
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (Model.CostAllocations != null && Model.CostAllocations.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Department</th>
                                            <th>Rate %</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ca in Model.CostAllocations)
                                        {
                                            <tr>
                                                <td>@Html.DisplayFor(modelItem => ca.DepartmentName)</td>
                                                <td>@Html.DisplayFor(modelItem => ca.Rate)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No details found for this Payment Request.</p>
                        }
                    </div>
                </div>
            }
            @if (Model.Attachments != null && Model.Attachments.Any())
            {
                <div class="card shadow border-0 mt-3">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead style="background-color: #0d47a1;">
                                    <tr style="background-color: #092963;">
                                        <th scope="col" class="py-3 px-4 text-white">Attachment Type</th>
                                        <th scope="col" class="py-3 px-4 text-white">Attachment</th>
                                        <th scope="col" class="py-3 px-4 text-end text-white">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var attachment in Model.Attachments)
                                    {
                                        <tr class="align-middle">
                                            <td class="px-4">
                                                <span class="badge badge-custom-theme">@attachment.AttachmentTypeName</span>
                                            </td>
                                            <td class="px-4">
                                                <i class="fas fa-file me-2 text-custom-theme"></i>
                                                <strong>@attachment.FileName</strong>
                                                <small class="text-muted ms-2">(@(attachment.FileSizeKB) KB)</small>
                                            </td>
                                            <td class="px-4 text-end">
                                                <div class="btn-group" role="group">
                                                    @* View Button *@
                                                    <a href="@Url.Action("ViewAttachment", "PaymentRequest", new { area = "Finance", id = attachment.Id })"
                                                       class="btn btn-sm btn-outline-custom-theme me-1"
                                                       target="_blank"
                                                       title="View">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    @* Download Button *@
                                                    <a href="@Url.Action("DownloadAttachment", "PaymentRequest", new { area = "Finance", id = attachment.Id })"
                                                       class="btn btn-sm btn-outline-custom-theme"
                                                       target="_blank"
                                                       title="Download">
                                                        <i class="fas fa-download"></i>
                                                    </a>

                                                    @* Delete Button with correct styling *@
                                                    @if (Model.StateId == 1 && Model.CreatedByUserName == currentUserName)
                                                    {
                                                        <form asp-action="DeleteAttachment"
                                                              asp-controller="PaymentRequest"
                                                              asp-area="Finance"
                                                              method="post"
                                                              style="display:inline;"
                                                              onsubmit="return confirm('Are you sure you want to delete this attachment?');">

                                                            <input type="hidden" name="id" value="@attachment.Id" />
                                                            <input type="hidden" name="paymentRequestId" value="@Model.Id" />

                                                            <button type="submit"
                                                                    class="btn btn-sm btn-outline-custom-theme ms-1"
                                                                    title="Delete">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            @{
                // The "Actions" card should be shown by default, unless specific conditions are met.
                bool showActionsCard = true;

                // Condition 1: Hide the card if the current user is the requester AND the state is 'Submitted'.
                // This prevents the requester from acting on their own pending request.
                if (Model.StateId == 2 && Model.CreatedByUserName == currentUserName)
                {
                    showActionsCard = false;
                }

                // Condition 2: Hide the card if the state is 'Approved' (3), 'Rejected' (4), or 'Cancelled' (10001).
                // These are final states where no further action is possible.
                else if (Model.StateId == 3 || Model.StateId == 4 || Model.StateId == 10001)
                {
                    showActionsCard = false;
                }

                // Condition 3: Hide the card if the current user is NOT the owner, and the state is 'Submitted' or 'Returned'.
                // This prevents users who are not the current assignee from taking action.
                else if (Model.Owner != currentUserName && (Model.StateId == 2 || Model.StateId == 5))
                {
                    showActionsCard = false;
                }

                else if (Model.StateId == 5 && Model.Owner == currentUserName)
                {
                        showActionsCard = true;
                }

                // Condition 4: You cannot edit or submit if you are not the creator, even in a saved/returned state.
                else if (Model.StateId == 1 || Model.StateId == 5)
                {
                    if (currentUserId != Model.CreatedByUserId)
                    {
                        showActionsCard = false;
                    }
                }
                else if (Model.StateId == 3)
                {
                    showActionsCard = false;
                }
            }

            @if (showActionsCard)
            {
                <div class="card shadow border-0">
                    <div class="card-header" style="background-color: #092963;">
                        <h5 class="card-title text-white mb-0">
                            <i class="fas fa-cogs me-2"></i> Actions
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            @* Edit button *@
                            @if (!string.IsNullOrEmpty(Model.GRNNumber))
                            {
                                @if ((Model.StateId == 1 || Model.StateId == 5) && (currentUserId == Model.CreatedByUserId))
                                {
                                    <button type="button" class="btn action-button-alt"
                                            data-bs-toggle="modal"
                                            data-bs-target="#paymentRequestEditModal"
                                            data-id="@Model.Id"
                                            data-area="Finance"
                                            data-controller="PaymentRequest"
                                            data-action-name="EditGRNBased">
                                        <i class="fas fa-edit me-2"></i> Edit PRQ
                                    </button>
                                }
                            }
                            else
                            {
                                @if ((Model.StateId == 1 || Model.StateId == 5) && (currentUserId == Model.CreatedByUserId))
                                {
                                    <button type="button" class="btn action-button-alt"
                                            data-bs-toggle="modal"
                                            data-bs-target="#paymentRequestEditModal"
                                            data-id="@Model.Id"
                                            data-area="Finance"
                                            data-controller="PaymentRequest"
                                            data-action-name="EditDirect">
                                        <i class="fas fa-edit me-2"></i> Edit PRQ
                                    </button>
                                }
                            }

                            @* Submit button *@
                            @if ((Model.StateId == 1 && currentUserId == Model.CreatedByUserId) || (Model.StateId == 5 && currentUserId == Model.CreatedByUserId))
                            {
                                // User is eligible to submit, now check for attachments
                                @if (hasAttachments)
                                {
                                    <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#submitModal">
                                        <i class="fas fa-paper-plane me-2"></i> <span class="button-text">Submit for Approval</span>
                                    </button>
                                }
                                else
                                {
                                    // The button is shown but disabled, and the modal target is removed
                                    <button type="button" class="btn action-button-alt disabled" disabled aria-disabled="true">
                                        <i class="fas fa-paper-plane me-2"></i> <span class="button-text">Submit for Approval</span>
                                    </button>
                                }
                            }
                            @* Approval actions *@
                            @if (canAddPiVNo && (currentUserName == Model.Owner))
                            {
                                @if (canAddPiVNo) // Add this check for the 'Recording Desk' role.
                                {
                                    if (string.IsNullOrEmpty(Model.PIVNo))
                                    {
                                        <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#pivModal">
                                            <i class="fas fa-check me-2"></i> <span class="button-text">Add PIV Number</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#pivModal" data-pivno="@Model.PIVNo">
                                            <i class="fas fa-edit me-2"></i> <span class="button-text">Edit PIV Number</span>
                                        </button>

                                        // Only show the Approve button after the PIV number is added.
                                        @if (Model.StateId == 2 && (currentUserName == Model.Owner))
                                        {
                                            <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#approveModal">
                                                <i class="fas fa-check me-2"></i> <span class="button-text">Approve</span>
                                            </button>
                                        }
                                    }
                                }
                                else // Existing logic for all other users who are owners
                                {
                                    if (!string.IsNullOrEmpty(Model.PIVNo))
                                    {
                                        <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#pivModal" data-pivno="@Model.PIVNo">
                                            <i class="fas fa-edit me-2"></i> <span class="button-text">Edit PIV Number</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#pivModal">
                                            <i class="fas fa-check me-2"></i> <span class="button-text">Add PIV Number</span>
                                        </button>
                                    }
                                }
                            }

                            @if (canAddCSNo && (currentUserName == Model.Owner))
                            {
                                @if (canAddCSNo)
                                {
                                    if (string.IsNullOrEmpty(Model.CSNo))
                                    {
                                        <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#csModal">
                                            <i class="fas fa-check me-2"></i> <span class="button-text">Add CS Number</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#csModal" data-csno="@Model.CSNo">
                                            <i class="fas fa-edit me-2"></i> <span class="button-text">Edit CS Number</span>
                                        </button>

                                        // Only show the Approve button after the CS number is added.
                                        @if (Model.StateId == 2 && (currentUserName == Model.Owner))
                                        {
                                            <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#approveModal">
                                                <i class="fas fa-check me-2"></i> <span class="button-text">Approve</span>
                                            </button>
                                        }
                                    }
                                }
                                else // Existing logic for all other users who are owners
                                {
                                    if (!string.IsNullOrEmpty(Model.CSNo))
                                    {
                                        <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#csModal" data-csno="@Model.CSNo">
                                            <i class="fas fa-edit me-2"></i> <span class="button-text">Edit CS Number</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#csModal">
                                            <i class="fas fa-check me-2"></i> <span class="button-text">Add CS Number</span>
                                        </button>
                                    }
                                }
                            }
                            @if (((Model.StateId == 5 && currentUserId != Model.CreatedByUserId) || Model.StateId == 2) && (currentUserName == Model.Owner)) // Hide the approve button for Recording Desk here
                            {
                                @if (!canAddPiVNo && !canAddCSNo)
                                {
                                    <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#approveModal">
                                        <i class="fas fa-check me-2"></i> <span class="button-text">Approve</span>
                                    </button>
                                }
                                <button type="button" class="btn action-button-alt"
                                        data-bs-toggle="modal"
                                        data-bs-target="#returnToSpecificUserModal"
                                        data-payment-request-id="@Model.Id"
                                        id="returnButton">
                                    <i class="fas fa-undo me-2"></i> <span class="button-text">Return</span>
                                </button>
                                <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                    <i class="fas fa-times me-2"></i> <span class="button-text">Reject</span>
                                </button>
                            }
                            @* Cancel and Return actions *@
                            @if (Model.StateId == 1 || Model.StateId == 4 || (Model.StateId == 5 && currentUserId == Model.CreatedByUserId))
                            {
                                @if (currentUserId == Model.CreatedByUserId || currentUserName == Model.Owner)
                                {
                                    <button type="button" class="btn action-button-alt" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                        <i class="fas fa-ban me-2"></i> <span class="button-text">Cancel PRQ</span>
                                    </button>
                                }
                                @if (currentUserName == Model.Owner && Model.StateId != 1 && Model.StateId != 5)
                                {
                                    <button type="button" class="btn action-button-alt"
                                            data-bs-toggle="modal" data-bs-target="#returnToSpecificUserModal"
                                            data-purchase-order-id="@Model.Id" id="returnButton">
                                        <i class="fas fa-undo me-2"></i> <span class="button-text">Return</span>
                                    </button>
                                }
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="card shadow border-0">
                <div class="card-header" style="background-color: #092963;">
                    <h5 class="card-title text-white mb-0">
                        <i class="fas fa-history me-2"></i> Workflow History
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.WorkflowHistory != null && Model.WorkflowHistory.Any())
                    {
                        <div class="timeline">
                            @foreach (var history in Model.WorkflowHistory.OrderByDescending(h => h.ActionDate))
                            {
                                <div class="timeline-item mb-3">
                                    <div class="timeline-marker">
                                        @switch (history.ActionName?.ToLower())
                                        {
                                            case "created":
                                                <i class="fas fa-plus text-primary"></i>
                                                break;
                                            case "submit":
                                                <i class="fas fa-paper-plane text-info"></i>
                                                break;
                                            case "approve":
                                                <i class="fas fa-check text-success"></i>
                                                break;
                                            case "reject":
                                                <i class="fas fa-times text-danger"></i>
                                                break;
                                            case "return":
                                                <i class="fas fa-undo text-warning"></i>
                                                break;
                                            case "cancel":
                                                <i class="fas fa-ban text-dark"></i>
                                                break;
                                            default:
                                                <i class="fas fa-circle text-muted"></i>
                                                break;
                                        }
                                    </div>
                                    <div class="timeline-content">
                                        <h6 class="mb-1">@history.ActionName</h6>
                                        <p class="text-muted mb-1">
                                            @history.FromStateName &rarr; @history.ToStateName
                                        </p>
                                        <p class="text-muted mb-1">
                                            From: <strong>@history.ActionByUserName</strong> To: <strong>@(history.ToUserName ?? history.ActionByUserName)</strong>
                                        </p>
                                        <p class="text-muted mb-1">
                                            By: <strong>@history.ActionByUserName</strong> on <strong>@history.ActionDate.ToString("dd/MM/yyyy HH:mm tt")</strong>
                                        </p>
                                        @if (!string.IsNullOrEmpty(history.Comments))
                                        {
                                            <p class="mt-2 text-muted"><em>"@history.Comments"</em></p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No workflow history available for this payment request.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

