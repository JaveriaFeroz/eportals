@* This partial defines the modal structures and JavaScript logic for Relations. *@

<div class="modal fade" id="relationEditModal" tabindex="-1" aria-labelledby="relationEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="relationEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Relation
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="relationEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="relationDetailsModal" tabindex="-1" aria-labelledby="relationDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="relationDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Relation Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="relationDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="relationDeleteModal" tabindex="-1" aria-labelledby="relationDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="relationDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Relation: <span id="deleteModalRelationName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete relation <strong id="deleteModalRelationNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="relationDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Relation Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachRelationEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('relationEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleRelationEditFormSubmit);
                editForm.addEventListener('submit', handleRelationEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #relationEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for relation form.");
                }
            } else {
                console.warn("#relationEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Relation Edit form submission (AJAX) ---
        async function handleRelationEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for relation form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const relationEditModalBodyElement = document.getElementById('relationEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const relationEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('relationEditModal'));
                        if (relationEditModalInstance) {
                            relationEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Relation updated successfully!");
                        } else {
                            console.log("Relation update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Relation update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const relationEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('relationEditModal'));
                        if (relationEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                relationEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    relationEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Relation validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachRelationEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during relation form submission:', error);
                const relationEditModalBodyElement = document.getElementById('relationEditModalBody');
                if (relationEditModalBodyElement) {
                     relationEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Relation Delete form submission (AJAX) ---
        async function handleRelationDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete relation with an error.");
                    } else {
                        console.error("Relation delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Relation deleted successfully!");
                    } else {
                        console.log("Relation deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete relation.");
                    } else {
                        console.error("Relation delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during relation delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during relation deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during relation deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Relation Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Relation"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Relation', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('relationEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('relationEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachRelationEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Relation Modal Opener
        document.querySelectorAll('.details-btn[data-page="Relation"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Relation', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('relationDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('relationDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Relation Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Relation"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const relationName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Relation', 'Delete', id);

                document.getElementById('deleteModalRelationName').textContent = relationName;
                document.getElementById('deleteModalRelationNameConfirm').textContent = relationName;

                const deleteForm = document.getElementById('relationDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleRelationDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleRelationDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('relationDeleteModal')).show();
            });
        });
    });
</script>