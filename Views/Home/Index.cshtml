@{
    ViewData["Title"] = "Home Page";
}

@await Html.PartialAsync("_Greeting")

<div class="dashboard-container">
    <div class="stat-cards">
        <a href="@Url.Action("DetailsList", "Home", new { statusId = 0 })" class="stat-card-link">
            <div class="stat-card">
                <div class="stat-card-header">
                    <h6 class="stat-card-title">Draft's requests</h6>
                </div>
                <div class="stat-card-main">
                    <div class="icon-box bg-blue">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <div class="stat-value">
                            @ViewBag.TotalDraftRequests
                        </div>
                    </div>
                </div>
            </div>
        </a>

        <a href="@Url.Action("DetailsList", "Home", new { statusId = 3 })" class="stat-card-link">
            <div class="stat-card">
                <div class="stat-card-header">
                    <h6 class="stat-card-title">Approved Requests</h6>
                </div>
                <div class="stat-card-main">
                    <div class="icon-box bg-green">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div>
                        <div class="stat-value">
                            @ViewBag.TotalApprovedRequests
                        </div>
                    </div>
                </div>
            </div>
        </a>

        <a href="@Url.Action("DetailsList", "Home", new { statusId = 1 })" class="stat-card-link">
            <div class="stat-card">
                <div class="stat-card-header">
                    <h6 class="stat-card-title">Pending requests</h6>
                </div>
                <div class="stat-card-main">
                    <div class="icon-box bg-orange">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <div class="stat-value">
                            @ViewBag.TotalPendingRequests
                        </div>
                    </div>
                </div>
            </div>
        </a>

        <a href="@Url.Action("DetailsList", "Home", new { statusId = 2 })" class="stat-card-link">
            <div class="stat-card">
                <div class="stat-card-header">
                    <h6 class="stat-card-title">Sent Requests</h6>
                </div>
                <div class="stat-card-main">
                    <div class="icon-box bg-purple">
                        <i class="bi bi-send-fill"></i>
                    </div>
                    <div>
                        <div class="stat-value">
                            @ViewBag.TotalSentRequests
                        </div>
                    </div>
                </div>
            </div>
        </a>

        <a href="@Url.Action("DetailsList", "Home", new { statusId = 4 })" class="stat-card-link">
            <div class="stat-card">
                <div class="stat-card-header">
                    <h6 class="stat-card-title">Rejected requests</h6>
                </div>
                <div class="stat-card-main">
                    <div class="icon-box bg-red">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                    <div>
                        <div class="stat-value">
                            @ViewBag.TotalRejectRequests
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="bottom-section">
        <div class="todo-card">
            <div class="card-header">
                <h5 class="card-title">To do list <span class="badge-counter"></span></h5>
            </div>
        </div>

        <div class="requests-card">
            <div class="card-header">
                <h5 class="card-title">Upcoming approvals</h5>
            </div>
        </div>
    </div>
</div>

<style>
    /* New CSS to remove underlines from the stat card links */
    .stat-card-link,    
    .stat-card-link h6,
    .stat-card-link .stat-value {
        text-decoration: none;
    }

    .stat-card-link {
        display: flex;
        flex-grow: 1;
    }
</style>