@model ProcureToPay.Areas.UserManagement.Models.Permission

<div class="modal-body">
    <form id="permissionEditForm" method="post" asp-action="Edit" asp-controller="Permissions" asp-area="UserManagement"
          data-area="UserManagement" data-controller="Permissions">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Permission Name <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-file-signature"></i></span>
                <input asp-for="Name" class="form-control" required />
            </div>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-align-left"></i></span>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ModuleId" class="form-label">Module <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-cube"></i></span>
                <select asp-for="ModuleId" class="form-select" asp-items="@(new SelectList(ViewBag.Modules, "Id", "DisplayName"))" required>
                    <option value="">-- Select Module --</option>
                </select>
            </div>
            <span asp-validation-for="ModuleId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label"><i class="fas fa-power-off me-2"></i> Status</label>
            <div class="form-check form-switch">
                <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                <label class="form-check-label" for="IsActive">Active</label>
                @* Hidden input to ensure 'false' is sent if checkbox is unchecked *@
                <input type="hidden" name="@Html.NameFor(m => m.IsActive)" value="false" />
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1" style="color: white;"></i> Save Permission
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}