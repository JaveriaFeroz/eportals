@model ProcureToPay.Areas.Insurance.ViewModels.InsuranceTypeCreateEditViewModel

    <div class="modal-body">
        <form id="insuranceTypeEditForm" method="post" asp-action="Edit" asp-controller="InsuranceType" asp-area="Insurance">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        @* Hidden input for the InsuranceTypeId is crucial for the update *@
        <input type="hidden" asp-for="InsuranceType.TypeId" />

        @* ==== Card 1: Basic Information ==== *@
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h6 class="m-0 fw-bold" style="color: #092963;"><i class="fas fa-info-circle me-2"></i> Basic Information</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="InsuranceType.TypeName" class="form-label">Type Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-user-tie"></i></span>
                            <input asp-for="InsuranceType.TypeName" class="form-control" />
                        </div>
                        <span asp-validation-for="InsuranceType.TypeName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="InsuranceType.CompanyId" class="form-label">Company</label>
                        <select asp-for="InsuranceType.CompanyId" asp-items="@Model.Companies" class="form-select">
                            <option value="">-- Select Company --</option>
                        </select>
                        <span asp-validation-for="InsuranceType.CompanyId" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>


        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1" style="color: white;"></i> Save Changes
            </button>
        </div>
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}