@* This partial defines the modal structures and JavaScript logic for Clients. *@

<div class="modal fade" id="clientEditModal" tabindex="-1" aria-labelledby="clientEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="clientEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Client
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="clientEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="clientDetailsModal" tabindex="-1" aria-labelledby="clientDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="clientDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Client Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="clientDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="clientDeleteModal" tabindex="-1" aria-labelledby="clientDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="clientDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Client: <span id="deleteModalClientName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete client <strong id="deleteModalClientNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="clientDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Client Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachClientEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('clientEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleClientEditFormSubmit);
                editForm.addEventListener('submit', handleClientEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #clientEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for client form.");
                }
            } else {
                console.warn("#clientEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Client Edit form submission (AJAX) ---
        async function handleClientEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for client form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const clientEditModalBodyElement = document.getElementById('clientEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const clientEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('clientEditModal'));
                        if (clientEditModalInstance) {
                            clientEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Client updated successfully!");
                        } else {
                            console.log("Client update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Client update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const clientEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('clientEditModal'));
                        if (clientEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                clientEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    clientEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Client validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachClientEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during client form submission:', error);
                const clientEditModalBodyElement = document.getElementById('clientEditModalBody');
                if (clientEditModalBodyElement) {
                     clientEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Client Delete form submission (AJAX) ---
        async function handleClientDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete client with an error.");
                    } else {
                        console.error("Client delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Client deleted successfully!");
                    } else {
                        console.log("Client deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete client.");
                    } else {
                        console.error("Client delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during client delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during client deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during client deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Client Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Client"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Client', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('clientEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('clientEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachClientEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Client Modal Opener
        document.querySelectorAll('.details-btn[data-page="Client"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Client', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('clientDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('clientDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Client Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Client"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const clientName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Client', 'Delete', id);

                document.getElementById('deleteModalClientName').textContent = clientName;
                document.getElementById('deleteModalClientNameConfirm').textContent = clientName;

                const deleteForm = document.getElementById('clientDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleClientDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleClientDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('clientDeleteModal')).show();
            });
        });
    });
</script>