@* This partial defines the modal structures and contains the JavaScript logic for them. *@

<div class="modal fade" id="activityEditModal" tabindex="-1" aria-labelledby="activityEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="activityEditModalLabel">
                    <i class="fas fa-edit me-2"></i> Edit Activity
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="activityEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="activityDetailsModal" tabindex="-1" aria-labelledby="activityDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="activityDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Activity Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="activityDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="activityDeleteModal" tabindex="-1" aria-labelledby="activityDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="activityDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Activity: <span id="deleteModalActivityName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete activity <strong id="deleteModalActivityNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="activityDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- Function to attach/re-attach form submission handler for the Activity Edit modal ---
        function attachActivityEditFormSubmissionHandler() {
            const editForm = document.getElementById('activityEditForm'); // Target the activity edit form
            if (editForm) {
                // Ensure no duplicate listeners by removing any existing ones
                editForm.removeEventListener('submit', handleActivityEditFormSubmit);
                editForm.addEventListener('submit', handleActivityEditFormSubmit);

                // Re-parse client-side validation for dynamically loaded content
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #activityEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for activity form.");
                }
            } else {
                console.warn("#activityEditForm not found when trying to attach handler.");
            }
        }

        // --- Handler for the Activity Edit form submission (AJAX) ---
        async function handleActivityEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for activity form. Not sending AJAX request.");
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type"); // Get content type to distinguish JSON/HTML
                const activityEditModalBodyElement = document.getElementById('activityEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    // This is a JSON response (success or specific error)
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        // Success: close modal, show message, reload page
                        const activityEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('activityEditModal'));
                        if (activityEditModalInstance) {
                            activityEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') { // Check if Toastr is available
                            toastr.success(jsonResponse.message || "Activity updated successfully!");
                        } else {
                            console.log("Activity update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload(); // Reload to reflect changes
                    } else {
                        // JSON error: show message, keep modal open or close based on error type
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Activity update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        // For critical errors (e.g., activity not found), you might want to close the modal
                        const activityEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('activityEditModal'));
                        if (activityEditModalInstance) {
                            activityEditModalInstance.hide(); // Hide for critical errors
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    activityEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Activity validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    setTimeout(attachActivityEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during activity form submission:', error);
                activityEditModalBodyElement.innerHTML = `
                    <div class="alert alert-danger" role="alert">
                        A network or unexpected error occurred. Please check your connection and try again.
                    </div>
                `;
            }
        }

        // --- Handler for Activity Delete form submission (AJAX) ---
        async function handleActivityDeleteFormSubmit(event) {
            event.preventDefault(); // Stop default form submission
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                // Assuming delete always returns JSON from the controller
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    // Success: close modal, show message, reload page
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Activity deleted successfully!");
                    } else {
                        console.log("Activity deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload(); // Reload page to reflect deletion
                } else {
                    // Error: show message
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete activity.");
                    } else {
                        console.error("Activity delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during activity delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during activity deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during activity deletion. Please try again.");
                }
            }
        }


        // --- Activity Modal Openers ---

        // Edit Activity Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Activity"]').forEach(function (button) {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Activity', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('activityEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('activityEditModal')).show();
                    setTimeout(attachActivityEditFormSubmissionHandler, 50);
                } catch (error) {
                    console.error('Error loading activity edit modal:', error);
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Activity Modal Opener
        document.querySelectorAll('.details-btn[data-page="Activity"]').forEach(function (button) {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Activity', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('activityDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('activityDetailsModal')).show();
                } catch (error) {
                    console.error('Error loading activity details modal:', error);
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Activity Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Activity"]').forEach(function (button) {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const activityName = this.getAttribute('data-name'); // Using a generic 'data-name' attribute
                const url = getUrl('Master', 'Activity', 'Delete', id);

                document.getElementById('deleteModalActivityName').textContent = activityName;
                document.getElementById('deleteModalActivityNameConfirm').textContent = activityName;

                const deleteForm = document.getElementById('activityDeleteForm');
                deleteForm.setAttribute('action', url);

                // *** THIS IS THE CRUCIAL FIX ***
                // Attach the AJAX submit handler to the delete form every time the modal is opened.
                deleteForm.removeEventListener('submit', handleActivityDeleteFormSubmit); // Prevent duplicates
                deleteForm.addEventListener('submit', handleActivityDeleteFormSubmit);
                // *******************************

                new bootstrap.Modal(document.getElementById('activityDeleteModal')).show();
            });
        });
    });
</script>