@* This partial defines the modal structures and JavaScript logic for SKUCategories. *@

<div class="modal fade" id="skuCategoryEditModal" tabindex="-1" aria-labelledby="skuCategoryEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="skuCategoryEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit SKU
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="skuCategoryEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="skuCategoryDetailsModal" tabindex="-1" aria-labelledby="skuCategoryDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="skuCategoryDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> SKU Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="skuCategoryDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="skuCategoryDeleteModal" tabindex="-1" aria-labelledby="skuCategoryDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="skuCategoryDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete SKU: <span id="deleteModalSKUName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete skuCategory <strong id="deleteModalSKUNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="skuCategoryDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the SKU Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachSKUEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('skusEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleSKUEditFormSubmit);
                editForm.addEventListener('submit', handleSKUEditFormSubmit);

                // Re-parse skuCategory-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("SKU-side validation re-parsed for #skusEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. SKU-side validation may not work for skuCategory form.");
                }
            } else {
                console.warn("#skusEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the SKU Edit form submission (AJAX) ---
        async function handleSKUEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform skuCategory-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("SKU-side validation failed for skuCategory form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const skuCategoryEditModalBodyElement = document.getElementById('skuCategoryEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const skuCategoryEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('skuCategoryEditModal'));
                        if (skuCategoryEditModalInstance) {
                            skuCategoryEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "SKU updated successfully!");
                        } else {
                            console.log("SKU update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("SKU update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const skuCategoryEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('skuCategoryEditModal'));
                        if (skuCategoryEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                skuCategoryEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    skuCategoryEditModalBodyElement.innerHTML = responseHtml;
                    console.log("SKU validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachSKUEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during skuCategory form submission:', error);
                const skuCategoryEditModalBodyElement = document.getElementById('skuCategoryEditModalBody');
                if (skuCategoryEditModalBodyElement) {
                     skuCategoryEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for SKU Delete form submission (AJAX) ---
        async function handleSKUDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete skuCategory with an error.");
                    } else {
                        console.error("SKU delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "SKU deleted successfully!");
                    } else {
                        console.log("SKU deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete skuCategory.");
                    } else {
                        console.error("SKU delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during skuCategory delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during skuCategory deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during skuCategory deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit SKU Modal Opener
        document.querySelectorAll('.edit-btn[data-page="SKU"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'SKU', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('skuCategoryEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('skuCategoryEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachSKUEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details SKU Modal Opener
        document.querySelectorAll('.details-btn[data-page="SKU"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'SKU', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('skuCategoryDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('skuCategoryDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete SKU Modal Opener
        document.querySelectorAll('.delete-btn[data-page="SKU"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const skuCategoryName = this.getAttribute('data-name');
                const url = getUrl('Master', 'SKU', 'Delete', id);

                document.getElementById('deleteModalSKUName').textContent = skuCategoryName;
                document.getElementById('deleteModalSKUNameConfirm').textContent = skuCategoryName;

                const deleteForm = document.getElementById('skuCategoryDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleSKUDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleSKUDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('skuCategoryDeleteModal')).show();
            });
        });
    });
</script>