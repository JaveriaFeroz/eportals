@model List<ProcureToPay.Areas.UserManagement.ViewModels.RolePermissionSummaryViewModel>
@{
    ViewData["Title"] = "Role Permissions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/scripts.js" asp-append-version="true"></script>

<style>
    .role-name-link {
        text-decoration: underline;
        color: #007bff; /* Blue color for the link */
        font-weight: bold;
    }

        .role-name-link:hover {
            color: #0056b3; /* Darker blue on hover */
        }
</style>

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963; display: flex; justify-content: space-between; align-items: center;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-lock me-2"></i> Role Permissions
            </h5>
        </div>
        <div class="card-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="row fw-bold bg-light border-bottom py-3 px-2 text-secondary">
                <div class="col-4 d-flex align-items-center">
                    <i class="fas fa-user-shield me-1 text-dark"></i> ROLE NAME
                </div>
                <div class="col-4 d-flex align-items-center">
                    <i class="fas fa-align-left me-1 text-dark"></i> DESCRIPTION
                </div>
                <div class="col-4 d-flex align-items-center">
                    <i class="fas fa-tasks me-1 text-dark"></i> PERMISSION COUNT
                </div>
            </div>

            @foreach (var item in Model)
            {
                <div class="row align-items-center border-bottom py-3 px-2 role-row">
                    <div class="col-4">
                        <a href="@Url.Action("Manage", "RolePermissions", new { area = "UserManagement", id = item.Role.Id })" class="role-name-link">
                            @item.Role.Name
                        </a>
                    </div>
                    <div class="col-4 text-start">
                        @item.Role.Description
                    </div>
                    <div class="col-4 text-start">
                        <span class="badge status-badge">@item.PermissionCount Permissions</span>
                    </div>
                    
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-dismiss alerts after 5 seconds
            setTimeout(function() {
                $('.alert').alert('close');
            }, 5000);
        });
    </script>
}