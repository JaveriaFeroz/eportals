@* This partial defines the modal structures and JavaScript logic for Complainants. *@

<div class="modal fade" id="complainantEditModal" tabindex="-1" aria-labelledby="complainantEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="complainantEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Complainant
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="complainantEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="complainantDetailsModal" tabindex="-1" aria-labelledby="complainantDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="complainantDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Complainant Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="complainantDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="complainantDeleteModal" tabindex="-1" aria-labelledby="complainantDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="complainantDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Complainant: <span id="deleteModalComplainantName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete complainant <strong id="deleteModalComplainantNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="complainantDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Complainant Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachComplainantEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('complainantEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleComplainantEditFormSubmit);
                editForm.addEventListener('submit', handleComplainantEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #complainantEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for complainant form.");
                }
            } else {
                console.warn("#complainantEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Complainant Edit form submission (AJAX) ---
        async function handleComplainantEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for complainant form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const complainantEditModalBodyElement = document.getElementById('complainantEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const complainantEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('complainantEditModal'));
                        if (complainantEditModalInstance) {
                            complainantEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Complainant updated successfully!");
                        } else {
                            console.log("Complainant update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Complainant update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const complainantEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('complainantEditModal'));
                        if (complainantEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                complainantEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    complainantEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Complainant validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachComplainantEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during complainant form submission:', error);
                const complainantEditModalBodyElement = document.getElementById('complainantEditModalBody');
                if (complainantEditModalBodyElement) {
                     complainantEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Complainant Delete form submission (AJAX) ---
        async function handleComplainantDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete complainant with an error.");
                    } else {
                        console.error("Complainant delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Complainant deleted successfully!");
                    } else {
                        console.log("Complainant deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete complainant.");
                    } else {
                        console.error("Complainant delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during complainant delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during complainant deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during complainant deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Complainant Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Complainant"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Complainant', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('complainantEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('complainantEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachComplainantEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Complainant Modal Opener
        document.querySelectorAll('.details-btn[data-page="Complainant"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Complainant', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('complainantDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('complainantDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Complainant Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Complainant"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const complainantName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Complainant', 'Delete', id);

                document.getElementById('deleteModalComplainantName').textContent = complainantName;
                document.getElementById('deleteModalComplainantNameConfirm').textContent = complainantName;

                const deleteForm = document.getElementById('complainantDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleComplainantDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleComplainantDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('complainantDeleteModal')).show();
            });
        });
    });
</script>