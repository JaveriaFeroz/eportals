@model ProcureToPay.Areas.Master.ViewModels.RegionCreateEditViewModel

@{
    ViewData["Title"] = (Model.Region?.RegionId > 0 ? "Edit" : "Create") + " Region"; // Dynamically set title
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/scripts.js" asp-append-version="true"></script>

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas @(Model.Region?.RegionId > 0 ? "fa-edit" : "fa-plus") me-2"></i> @ViewData["Title"]
            </h5>
        </div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post" action="@Url.Action(Model.Region?.RegionId > 0 ? "Edit" : "Create", "Region", new { area = "Master" })" id="regionForm">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Region.RegionId) @* Hidden field for Edit scenario *@

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-info-circle me-2"></i> Region Details
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="Region_RegionName" class="form-label">Region Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;">
                                        <i class="fas fa-globe-americas"></i>
                                    </span>
                                    <input asp-for="Region.RegionName"
                                           class="form-control"
                                           placeholder="Enter region name"
                                           maxlength="100"
                                           id="regionNameInput" />
                                </div>
                                <span asp-validation-for="Region.RegionName" class="text-danger"></span>
                                <div id="regionNameError" class="text-danger" style="display: none;"></div>
                                <div class="form-text">Maximum 100 characters</div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="Region_TaxRate" class="form-label">Tax Rate (%)</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;">
                                        <i class="fas fa-percent"></i>
                                    </span>
                                    <input asp-for="Region.TaxRate"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           max="100"
                                           placeholder="0.00"
                                           id="taxRateInput" />
                                </div>
                                <span asp-validation-for="Region.TaxRate" class="text-danger"></span>
                                <div class="form-text">Enter tax rate between 0 and 100</div>
                            </div>
                        </div>
                    </div>
                </div>

                

                <div class="d-flex justify-content-end mt-4">
                    <div>
                        <button type="submit" class="btn" style="background-color: #092963; color: white;" id="saveButton">
                            <i class="fas fa-save me-1"></i> @(Model.Region?.RegionId > 0 ? "Update Region" : "Create Region")
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}