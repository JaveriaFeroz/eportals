@* This partial defines the modal structures and JavaScript logic for Bases. *@

<div class="modal fade" id="baseEditModal" tabindex="-1" aria-labelledby="baseEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="baseEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Base
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="baseEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="baseDetailsModal" tabindex="-1" aria-labelledby="baseDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="baseDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Base Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="baseDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="baseDeleteModal" tabindex="-1" aria-labelledby="baseDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="baseDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Base: <span id="deleteModalBaseName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete base <strong id="deleteModalBaseNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="baseDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Base Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachBaseEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('baseEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleBaseEditFormSubmit);
                editForm.addEventListener('submit', handleBaseEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #baseEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for base form.");
                }
            } else {
                console.warn("#baseEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Base Edit form submission (AJAX) ---
        async function handleBaseEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for base form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const baseEditModalBodyElement = document.getElementById('baseEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const baseEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('baseEditModal'));
                        if (baseEditModalInstance) {
                            baseEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Base updated successfully!");
                        } else {
                            console.log("Base update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Base update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const baseEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('baseEditModal'));
                        if (baseEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                baseEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    baseEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Base validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachBaseEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during base form submission:', error);
                const baseEditModalBodyElement = document.getElementById('baseEditModalBody');
                if (baseEditModalBodyElement) {
                     baseEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Base Delete form submission (AJAX) ---
        async function handleBaseDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete base with an error.");
                    } else {
                        console.error("Base delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Base deleted successfully!");
                    } else {
                        console.log("Base deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete base.");
                    } else {
                        console.error("Base delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during base delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during base deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during base deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Base Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Base"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Base', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('baseEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('baseEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachBaseEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Base Modal Opener
        document.querySelectorAll('.details-btn[data-page="Base"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Base', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('baseDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('baseDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Base Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Base"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const baseName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Base', 'Delete', id);

                document.getElementById('deleteModalBaseName').textContent = baseName;
                document.getElementById('deleteModalBaseNameConfirm').textContent = baseName;

                const deleteForm = document.getElementById('baseDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleBaseDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleBaseDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('baseDeleteModal')).show();
            });
        });
    });
</script>