@{
    ViewData["Title"] = "Account Locked";
    Layout = "_AuthLayout"; 
}

<div class="login-container">
    <div class="right-section d-flex align-items-center justify-content-center">
        <div class="lockout-area text-center p-5 bg-white shadow rounded-lg">
            <i class="bi bi-lock-fill text-danger" style="font-size: 3rem;"></i>
            <h1 class="mt-3 mb-2">Account Locked</h1>

            <p class="text-muted">Your account has been locked out due to too many failed login attempts.</p>

            <div class="alert alert-warning mt-4 mx-auto" style="max-width: 400px;">
                @if (TempData["LockoutMessage"] != null)
                {
                    <p><strong>@TempData["LockoutMessage"]</strong></p>
                    <p class="mb-0">Please wait for the duration to expire or contact your system administrator for immediate assistance.</p>
                }
                else
                {
                    <p>Please wait and try again later, or contact an administrator.</p>
                }
            </div>

            <a asp-controller="Account" asp-action="Login" asp-area="Auth" class="btn btn-secondary mt-4">Return to Login</a>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}