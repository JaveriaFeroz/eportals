@model ProcureToPay.Areas.Reports.Models.WorkflowAnalysisFilter

@{
    ViewData["Title"] = "Workflow Analysis";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-chart-line me-2"></i> Workflow Analysis
            </h5>
        </div>

        <div class="card-body">
            <form id="filterForm">
                <div class="row g-3 align-items-end mb-4">
                    <div class="col-md-3">
                        <label asp-for="FromDate" class="form-label"></label>
                        <input asp-for="FromDate" class="form-control" type="date" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ToDate" class="form-label"></label>
                        <input asp-for="ToDate" class="form-control" type="date" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="WorkFlowTypeId" class="form-label"></label>
                        <select asp-for="WorkFlowTypeId" class="form-select" asp-items="ViewBag.WorkFlowTypes">
                            <option value="">All Types</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="UserId" class="form-label"></label>
                        <select asp-for="UserId" class="form-select" asp-items="ViewBag.Users">
                            <option value="">All Users</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label asp-for="Action" class="form-label"></label>
                        <input asp-for="Action" class="form-control" placeholder="Enter action" />
                    </div>
                    <div class="col-md-3">
                        <div class="form-check pt-4">
                            <input asp-for="IncludeCompleted" class="form-check-input" type="checkbox" />
                            <label asp-for="IncludeCompleted" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex justify-content-end align-items-end">
                        <button type="button" class="btn btn-primary me-2 d-flex align-items-center" onclick="applyFilters()" style="background-color: #092963;">
                            <i class="fas fa-search me-2"></i> Apply
                        </button>
                        <button type="button" class="btn btn-outline-secondary d-flex align-items-center" onclick="clearFilters()">
                            <i class="fas fa-times me-2"></i> Clear
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mt-4" id="metricsContainer">
    </div>

    <div class="row g-3 mt-4">
        <div class="col-md-6">
            <div class="card shadow border-0 h-100">
                <div class="card-header" style="background-color: #092963;">
                    <h5 class="card-title text-white mb-0">
                        <i class="fas fa-chart-pie me-2"></i> State Distribution
                    </h5>
                </div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <canvas id="stateChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow border-0 h-100">
                <div class="card-header" style="background-color: #092963;">
                    <h5 class="card-title text-white mb-0">
                        <i class="fas fa-users me-2"></i> User Productivity
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-sm">
                            <thead class="table-dark">
                                <tr>
                                    <th>User</th>
                                    <th>Actions</th>
                                    <th>Pending</th>
                                    <th>Avg Days</th>
                                </tr>
                            </thead>
                            <tbody id="productivityTableBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow border-0">
                <div class="card-header" style="background-color: #092963;">
                    <h5 class="card-title text-white mb-0">
                        <i class="fas fa-history me-2"></i> Recent Workflow Activities
                    </h5>
                </div>
                <div class="card-body">
                    <div id="timelineContainer" class="timeline">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script>
          // Replace the existing script section in WorkflowAnalysis.cshtml with this:

        let stateChart;

        $(document).ready(function () {
            console.log('Page loaded, initializing workflow analysis...');
            loadWorkflowData();
        });

        function loadWorkflowData() {
            console.log('Loading workflow data...');

            const filterData = {
                fromDate: $('#FromDate').val() || null,
                toDate: $('#ToDate').val() || null,
                workFlowTypeId: $('#WorkFlowTypeId').val() || null,
                userId: $('#UserId').val() || null,
                action: $('#Action').val() || null,
                includeCompleted: $('#IncludeCompleted').is(':checked')
            };

            console.log('Filter data:', filterData);

            $.ajax({
                url: '@Url.Action("WorkflowAnalysis", "Reports")',
                type: 'GET',
                data: filterData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (data) {
                    console.log('Data received:', data);

                    // Check if data exists
                    if (!data) {
                        console.error('No data received from server');
                        showNoDataMessage();
                        return;
                    }

                    // Update each section
                    updateMetrics(data.metrics || []);
                    updateStateChart(data.stateDistribution || []);
                    updateProductivityTable(data.userProductivity || []);
                    updateTimeline(data.timeline || []);
                },
                error: function (xhr, status, error) {
                    console.error('AJAX Error:', {
                        status: status,
                        error: error,
                        response: xhr.responseText
                    });

                    alert('Error loading workflow data: ' + error);
                    showNoDataMessage();
                }
            });
        }

        function showNoDataMessage() {
            $('#metricsContainer').html('<div class="col-12 text-center text-muted py-4"><i class="fas fa-inbox fa-2x mb-2"></i><br>No data available. Try adjusting your filters.</div>');
            $('#productivityTableBody').html('<tr><td colspan="4" class="text-center text-muted">No data available</td></tr>');
            $('#timelineContainer').html('<div class="text-center text-muted py-4"><i class="fas fa-list-alt fa-2x mb-2"></i><br>No activities found.</div>');
        }

        function updateMetrics(metrics) {
            console.log('Updating metrics:', metrics);
            const container = $('#metricsContainer');
            container.empty();

            if (!metrics || metrics.length === 0) {
                container.append('<div class="col-12 text-center text-muted py-4"><i class="fas fa-inbox fa-2x mb-2"></i><br>No metrics found.</div>');
                return;
            }

            metrics.forEach(metric => {
                const colClass = metrics.length <= 4 ? 'col-md-3' : 'col-md-2';
                const card = `
                    <div class="${colClass}">
                        <div class="card shadow border-0 h-100 text-white" style="background-color: ${metric.color}">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h4 class="mb-0 fw-bold">${metric.value}</h4>
                                        <p class="mb-0">${metric.name}</p>
                                    </div>
                                    <i class="fas fa-circle-info fa-2x"></i>
                                </div>
                                <small>${metric.description}</small>
                            </div>
                        </div>
                    </div>
                `;
                container.append(card);
            });
        }

        function updateStateChart(stateDistribution) {
            console.log('Updating state chart:', stateDistribution);
            const ctx = document.getElementById('stateChart');

            if (!ctx) {
                console.error('Canvas element not found');
                return;
            }

            if (stateChart) {
                stateChart.destroy();
            }

            if (!stateDistribution || stateDistribution.length === 0) {
                $(ctx).parent().html('<div class="text-center text-muted py-4"><i class="fas fa-chart-pie fa-2x mb-2"></i><br>No chart data available.</div>');
                return;
            }

            // Recreate canvas if it was replaced
            if ($(ctx).prop('tagName') !== 'CANVAS') {
                $(ctx).parent().html('<canvas id="stateChart"></canvas>');
                const newCtx = document.getElementById('stateChart').getContext('2d');

                stateChart = new Chart(newCtx, {
                    type: 'doughnut',
                    data: {
                        labels: stateDistribution.map(item => item.stateName),
                        datasets: [{
                            data: stateDistribution.map(item => item.count),
                            backgroundColor: stateDistribution.map(item => item.color)
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
            } else {
                const context = ctx.getContext('2d');
                stateChart = new Chart(context, {
                    type: 'doughnut',
                    data: {
                        labels: stateDistribution.map(item => item.stateName),
                        datasets: [{
                            data: stateDistribution.map(item => item.count),
                            backgroundColor: stateDistribution.map(item => item.color)
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
            }
        }

        function updateProductivityTable(userProductivity) {
            console.log('Updating productivity table:', userProductivity);
            const tbody = $('#productivityTableBody');
            tbody.empty();

            if (!userProductivity || userProductivity.length === 0) {
                tbody.append('<tr><td colspan="4" class="text-center text-muted">No productivity data found.</td></tr>');
                return;
            }

            userProductivity.forEach(user => {
                const row = `
                    <tr>
                        <td>${user.userName || 'Unknown'}</td>
                        <td>${user.totalActions || 0}</td>
                        <td>${user.pendingItems || 0}</td>
                        <td>${(user.avgProcessingDays || 0).toFixed(1)}</td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        function updateTimeline(timeline) {
            console.log('Updating timeline:', timeline);
            const container = $('#timelineContainer');
            container.empty();

            if (!timeline || timeline.length === 0) {
                container.append('<div class="text-center text-muted py-4"><i class="fas fa-list-alt fa-2x mb-2"></i><br>No recent activities found.</div>');
                return;
            }

            timeline.forEach((item, index) => {
                const timelineItem = `
                    <div class="timeline-item">
                        <div class="timeline-marker" style="background-color: #092963;"></div>
                        <div class="timeline-content card shadow-sm">
                            <h6 class="mb-1">${item.action || 'Unknown Action'}</h6>
                            <p class="mb-1">
                                <strong>${item.formType || 'Unknown'} #${item.formId || 'N/A'}</strong> by ${item.userName || 'Unknown User'}
                            </p>
                            <p class="mb-1 text-muted">${item.comments || 'No comments'}</p>
                            <small class="text-muted">${new Date(item.actionDate).toLocaleString()}</small>
                        </div>
                    </div>
                `;
                container.append(timelineItem);
            });
        }

        function applyFilters() {
            console.log('Applying filters...');
            loadWorkflowData();
        }

        function clearFilters() {
            console.log('Clearing filters...');
            $('#filterForm')[0].reset();
            loadWorkflowData();
        }
    </script>

    <style>
        .timeline {
            position: relative;
            padding: 20px 0 20px 20px;
        }

            .timeline::before {
                content: '';
                position: absolute;
                top: 0;
                left: 25px;
                width: 2px;
                height: 100%;
                background-color: #dee2e6;
            }

        .timeline-item {
            position: relative;
            padding-left: 40px;
            margin-bottom: 20px;
        }

        .timeline-marker {
            position: absolute;
            left: 20px;
            top: 15px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            z-index: 1;
        }

        .timeline-content {
            padding: 15px;
            border-left: 3px solid #092963;
        }
    </style>
}