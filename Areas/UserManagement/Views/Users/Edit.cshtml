@model ProcureToPay.Areas.UserManagement.ViewModels.AdminEditUserViewModel

<div class="modal-body">
    <form id="userEditForm" method="post" asp-action="Edit" asp-controller="Users" asp-area="UserManagement">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="User.Id" />
        <div class="mb-3">
            <label asp-for="User.FirstName" class="form-label">First Name <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;">
                    <i class="fas fa-user"></i>
                </span>
                <input asp-for="User.FirstName" class="form-control" required />
            </div>
            <span asp-validation-for="User.FirstName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="User.LastName" class="form-label">Last Name <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;">
                    <i class="fas fa-user-tag"></i>
                </span>
                <input asp-for="User.LastName" class="form-control" required />
            </div>
            <span asp-validation-for="User.LastName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="User.UserName" class="form-label">Username <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;">
                    <i class="fas fa-user-circle"></i>
                </span>
                <input asp-for="User.UserName" class="form-control" required />
            </div>
            <span asp-validation-for="User.UserName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="User.Email" class="form-label">Email <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;">
                    <i class="fas fa-envelope"></i>
                </span>
                <input asp-for="User.Email" type="email" class="form-control" required />
            </div>
            <span asp-validation-for="User.Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RoleId" class="form-label">Role <span class="text-danger">*</span></label>
            <select asp-for="RoleId" class="form-select" asp-items="Model.RolesList">
                <option value="">-- Select Role --</option>
            </select>
            <span asp-validation-for="RoleId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="User.BranchId" class="form-label">Branch</label>
            <select asp-for="User.BranchId" class="form-select" asp-items="Model.BranchesList">
                <option value="">-- Select Branch --</option>
            </select>
            <span asp-validation-for="User.BranchId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="User.DepartmentId" class="form-label">Department</label>
            <select asp-for="User.DepartmentId" class="form-select" asp-items="Model.DepartmentsList">
                <option value="">-- Select Department --</option>
            </select>
            <span asp-validation-for="User.DepartmentId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="User.IsActive" class="form-label"><i class="fas fa-power-off me-2"></i> Status</label>
            <div class="form-check form-switch">
                <input asp-for="User.IsActive" type="checkbox" class="form-check-input" />
                <label class="form-check-label" asp-for="User.IsActive">Active</label>
                <input type="hidden" name="IsActive" value="false" />
            </div>
            <span asp-validation-for="User.IsActive" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal" onclick="window.location.href='/UserManagement/Users/Index';">Cancel</button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1" style="color: white;"></i> Save User
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}