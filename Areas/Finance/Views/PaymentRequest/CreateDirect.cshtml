@model ProcureToPay.Areas.Finance.ViewModels.CreateDirectPaymentRequestViewModel

@{
    ViewData["Title"] = "Create Direct Payment Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUserRoles = ViewBag.CurrentUserRoles as List<int> ?? new List<int>();

    bool viewblePiVfield = currentUserRoles.Contains(23);
    bool viewbleCSfield = currentUserRoles.Contains(29);
}

<style>
    .input-group-text.custom-blue {
        background-color: #092963;
        color: white;
    }

    .form-check-input:checked {
        background-color: #092963;
        border-color: #092963;
    }
</style>

<div class="container-fluid px-4 py-4">

    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-hand-holding-usd me-2"></i> Create Direct Payment Request
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="CreateDirect" method="post" id="directPaymentForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CreatedByUserId" />
                <input type="hidden" asp-for="GrnId" />
                <input type="hidden" asp-for="DepartmentId" />
                <input type="hidden" asp-for="BranchId" />
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <div class="card mb-4">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-info-circle me-2"></i> Payment Request
                        </h6>
                        <div class="d-flex align-items-center">
                            <label asp-for="SelfApplicant" class="form-label mb-0 me-2" for="selfApplicantSwitch" style="color: #092963;">Self Payee</label>
                            <div class="form-check form-switch">
                                <input asp-for="SelfApplicant" class="form-check-input" type="checkbox" role="switch" id="selfApplicantSwitch">
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3" id="supplier-field">
                                <label asp-for="SupplierId" class="form-label">Supplier <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-truck"></i>
                                    </span>
                                    <select asp-for="SupplierId" class="form-select" asp-items="@Model.Suppliers">
                                        <option value="">Select Supplier</option>
                                    </select>
                                </div>
                                <span asp-validation-for="SupplierId" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="PayeeName" class="form-label">Payee Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <input asp-for="PayeeName" class="form-control" />
                                </div>
                                <span asp-validation-for="PayeeName" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="RequiredDate" class="form-label">Required Date <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-calendar-alt"></i>
                                    </span>
                                    <input asp-for="RequiredDate" type="date" class="form-control" required />
                                </div>
                                <span asp-validation-for="RequiredDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="CurrencyId" class="form-label">Currency</label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-credit-card"></i>
                                    </span>
                                    <select asp-for="CurrencyId" class="form-select" asp-items="@Model.Currencies">
                                        <option value="">Select Currency</option>
                                    </select>
                                </div>
                                <span asp-validation-for="CurrencyId" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="PaymentModeId" class="form-label">Payment Mode</label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-credit-card"></i>
                                    </span>
                                    <select asp-for="PaymentModeId" class="form-select" asp-items="@Model.PaymentModes">
                                        <option value="">Select Mode</option>
                                    </select>
                                </div>
                                <span asp-validation-for="PaymentModeId" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="PaymentTypeId" class="form-label">Payment Type</label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-tags"></i>
                                    </span>
                                    <select asp-for="PaymentTypeId" class="form-select" asp-items="@Model.PaymentTypes">
                                        <option value="">Select Type</option>
                                    </select>
                                </div>
                                <span asp-validation-for="PaymentTypeId" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="PaymentNatureId" class="form-label">Payment Nature</label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue"><i class="fas fa-leaf"></i></span>
                                    <select asp-for="PaymentNatureId" class="form-select" asp-items="@Model.PaymentNatures">
                                        <option value="">Select Payment Nature</option>
                                    </select>
                                </div>
                                <span asp-validation-for="PaymentNatureId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="PaymentSubNatureId" class="form-label">Sub Nature</label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue"><i class="fas fa-leaf"></i></span>
                                    <select asp-for="PaymentSubNatureId" class="form-select" asp-items="@Model.SubNatures">
                                        <option value="">Select Sub Nature</option>
                                    </select>
                                </div>
                                <span asp-validation-for="PaymentSubNatureId" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="DepartmentCode" class="form-label">Departments</label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-tags"></i>
                                    </span>
                                    <select asp-for="DepartmentCode" class="form-select" asp-items="@Model.Departments"></select>
                                </div>
                                <input type="hidden" asp-for="DepartmentCode" />
                                <span asp-validation-for="DepartmentCode" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="BranchCode" class="form-label">Branch</label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </span>
                                    <select asp-for="BranchCode" class="form-select" asp-items="@Model.Branches"></select>
                                </div>
                                <input type="hidden" asp-for="BranchCode" />
                                <span asp-validation-for="BranchCode" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="CompanyCode" class="form-label">Company</label>
                                <div class="input-group">
                                    <span class="input-group-text custom-blue">
                                        <i class="fas fa-tags"></i>
                                    </span>
                                    <select asp-for="CompanyCode" class="form-select" asp-items="@Model.Companies">
                                        <option value="">Select Company</option>
                                    </select>
                                    <input type="hidden" asp-for="CompanyCode" value="4" />
                                </div>
                                <span asp-validation-for="CompanyCode" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="card shadow border-0 mt-3">
                    <div class="card-header" style="background-color: #092963;">
                        <h5 class="card-title text-white mb-0 d-flex justify-content-between align-items-center w-100">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-boxes me-2"></i> Invoice Details
                            </div>
                            <button type="button" class="btn btn-sm" style="background-color: #f8f9fa; color: #092963;" id="addDetailBtn">
                                <i class="fas fa-plus me-1"></i> Add Invoice
                            </button>
                        </h5>
                    </div>

                    <div class="card-body">
                        <div id="details-container">
                            @* The header for the details area (fixed structure) *@
                            <div class="row fw-bold bg-light py-2 border-bottom d-none d-md-flex text-secondary small">
                                <div class="col-md-2">Invoice No</div>
                                <div class="col-md-2">Invoice Date</div>
                                <div class="col-md-3">Description</div>
                                <div class="col-md-1 text-end">Amount Ex Tax</div>
                                <div class="col-md-1 text-end">ST Rate %</div>
                                <div class="col-md-1 text-end">Other Tax</div>
                                <div class="col-md-1 text-end">Total Amount</div>
                                <div class="col-md-1"></div>
                            </div>

                            @* Existing Items Loop (Rendered by C# on page load) *@
                            @if (Model.Details != null && Model.Details.Any())
                            {
                                var today = DateTime.Today;
                                var sixMonthsAgo = today.AddMonths(-6);
                                var todayFormatted = today.ToString("yyyy-MM-dd");
                                var sixMonthsAgoFormatted = sixMonthsAgo.ToString("yyyy-MM-dd");

                                for (int i = 0; i < Model.Details.Count; i++)
                                {
                                    <div class="row detail-row border-bottom py-2 align-items-center">
                                        <input type="hidden" name="Details[@i].Id" value="@Model.Details[i].Id" />

                                        <div class="col-md-2">
                                            <input name="Details[@i].InvoiceNo" class="form-control form-control-sm" placeholder="Invoice No" required maxlength="20" value="@Model.Details[i].InvoiceNo" />
                                        </div>

                                        <div class="col-md-2">
                                            <input name="Details[@i].InvoiceDate" type="date" class="form-control form-control-sm invoice-date-field"
                                                   required min="@sixMonthsAgoFormatted" max="@todayFormatted" value="@Model.Details[i].InvoiceDate?.ToString("yyyy-MM-dd")" />
                                        </div>

                                        <div class="col-md-3">
                                            <textarea name="Details[@i].Description" class="form-control form-control-sm" placeholder="Description" required rows="1">@Model.Details[i].Description</textarea>
                                        </div>

                                        <div class="col-md-1">
                                            <input name="Details[@i].AmountExTax" type="number" step="0.01" class="form-control form-control-sm amount-field text-end" placeholder="0.00" value="@Model.Details[i].AmountExTax" required />
                                        </div>

                                        <div class="col-md-1">
                                            <input name="Details[@i].STRate" type="number" step="0.01" class="form-control form-control-sm tax-field text-end" placeholder="%" value="@Model.Details[i].STRate" />
                                        </div>

                                        <div class="col-md-1">
                                            <input name="Details[@i].OtherTax" type="number" step="0.01" class="form-control form-control-sm other-tax-field text-end" placeholder="0.00" value="@Model.Details[i].OtherTax" />
                                        </div>

                                        <div class="col-md-1">
                                            <input type="text" class="form-control form-control-sm line-total-display text-end" value="@Model.Details[i].TotalAmount.ToString("N2")" readonly />
                                            <input type="hidden" name="Details[@i].TotalAmount" class="line-total-hidden" value="@Model.Details[i].TotalAmount" />
                                        </div>

                                        <div class="col-md-1 text-center">
                                            <button type="button" class="btn btn-danger btn-sm remove-detail-btn" title="Remove Item">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        @* TOTALS SUMMARY (Below the table) *@
                        <div class="row mt-3 justify-content-end">
                            <div class="col-md-9">
                                @* Empty space for alignment *@
                            </div>
                            <div class="col-md-3">

                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label mb-0 text-secondary">Total Amount Ex Tax</label>
                                    <div class="input-group input-group-sm w-50">
                                        <span class="input-group-text custom-blue"><i class="fas fa-dollar-sign"></i></span>
                                        <input type="text" id="totalAmountExTaxDisplay" class="form-control" readonly />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label mb-0 text-secondary">Total Other Tax</label>
                                    <div class="input-group input-group-sm w-50">
                                        <span class="input-group-text custom-blue"><i class="fas fa-dollar-sign"></i></span>
                                        <input type="text" id="totalOtherTaxDisplay" class="form-control" readonly />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <label class="form-label mb-0 fw-bold">Grand Total</label>
                                    <div class="input-group input-group-sm w-50">
                                        <span class="input-group-text custom-blue"><i class="fas fa-dollar-sign"></i></span>
                                        <input type="text" id="grandTotalDisplay" class="form-control fw-bold" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                        </div>

                </div>

                <div class="card mb-4" id="costAllocationCard">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-chart-pie me-2"></i> Cost Allocation
                        </h6>
                        <button type="button" class="btn btn-sm" style="background-color: #092963; color: white;" id="addCostAllocationBtn">
                            <i class="fas fa-plus me-1"></i> Add Allocation
                        </button>
                    </div>
                    <div class="card-body">
                        <div id="cost-allocation-container" class="mb-3">
                            @if (Model.CostAllocations != null && Model.CostAllocations.Any())
                            {
                                for (int i = 0; i < Model.CostAllocations.Count; i++)
                                {
                                    <div class="card card-body mb-2 allocation-row">
                                        <div class="row">
                                            <div class="col-md-4 mb-3">
                                                <label asp-for="CostAllocations[i].DepartmentCode" class="form-label">Department</label>
                                                <div class="input-group">
                                                    <span class="input-group-text custom-blue"><i class="fas fa-building"></i></span>
                                                    <select asp-for="CostAllocations[i].DepartmentCode" class="form-select department-select" asp-items="@Model.Departments"></select>
                                                </div>
                                            </div>
                                            <div class="col-md-4 mb-3">
                                                <label class="form-label">Branch</label>
                                                <div class="input-group">
                                                    <span class="input-group-text custom-blue"><i class="fas fa-map-marker-alt"></i></span>
                                                    <select name="CostAllocations[i].BranchCode" class="form-select branch-select" asp-items="@Model.Branches"></select>
                                                </div>
                                            </div>
                                            <div class="col-md-2 mb-3">
                                                <label asp-for="CostAllocations[i].Rate" class="form-label">Rate (%) </label>
                                                <div class="input-group">
                                                    <span class="input-group-text custom-blue"><i class="fas fa-percent"></i></span>
                                                    <input asp-for="CostAllocations[i].Rate" type="number" step="0.01" min="0" max="100" class="form-control rate-field" value="@Model.CostAllocations[i].Rate"/>
                                                </div>
                                            </div>
                                            <div class="col-md-2 mb-3 d-flex align-items-end">
                                                <button type="button" class="btn btn-danger remove-allocation-btn w-100">
                                                    <i class="fas fa-trash me-1"></i> Remove
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <div class="row mt-4">
                            <div class="col-md-3">
                                <label class="form-label mb-0">Total Rate</label>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="input-group">
                                <span class="input-group-text custom-blue"><i class="fas fa-percent"></i></span>
                                <input type="text" id="totalRateDisplay" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <div class="btn-group">
                        <button type="submit" class="btn" style="background-color: #092963; color: white;" id="submitBtn">
                            <i class="fas fa-check me-1"></i> Create Payment Request
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/Finance/CreateDirect.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const data = {
                initialPayeeName: '@Model.PayeeName',
                initialDepartmentCode: '@Model.DepartmentCode',
                initialBranchCode: '@Model.BranchCode',
                departments: @Html.Raw(Json.Serialize(Model.Departments)),
                branches: @Html.Raw(Json.Serialize(Model.Branches)),
                // Pass the initial PaymentNatureId
                initialPaymentNatureId: @Model.PaymentNatureId,
                currentUserName: '@Model.PayeeName'
            };
            window.initializePaymentRequestScript(data);
        });
    </script>
}