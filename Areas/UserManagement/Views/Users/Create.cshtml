@model ProcureToPay.Areas.UserManagement.ViewModels.AdminUserFormViewModel
@{
    ViewData["Title"] = "Create User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
        <li class="breadcrumb-item active">Create</li>
    </ol>

    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-user-plus me-2"></i> Create New User
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-user me-2"></i> Personal Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="User.FirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-user"></i></span>
                                    <input asp-for="User.FirstName" class="form-control" placeholder="Enter first name" required />
                                </div>
                                <span asp-validation-for="User.FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="User.LastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-user"></i></span>
                                    <input asp-for="User.LastName" class="form-control" placeholder="Enter last name" required />
                                </div>
                                <span asp-validation-for="User.LastName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-user-circle me-2"></i> Account Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="User.UserName" class="form-label">Username <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-at"></i></span>
                                    <input asp-for="User.UserName" class="form-control" placeholder="Enter username" required />
                                </div>
                                <span asp-validation-for="User.UserName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="User.Email" class="form-label">Email <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-envelope"></i></span>
                                    <input asp-for="User.Email" class="form-control" type="email" placeholder="Enter email address" required />
                                </div>
                                <span asp-validation-for="User.Email" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-building me-2"></i> Organization Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @* Role Dropdown: Added form-group *@
                            <div class="col-md-4 mb-3 form-group">
                                <label asp-for="RoleId" class="form-label">Role <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;">
                                        <i class="fas fa-briefcase"></i>
                                    </span>
                                    <select asp-for="RoleId" asp-items="Model.RolesList" class="form-select">
                                        <option value="">-- Select Role --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="RoleId" class="text-danger"></span>
                            </div>

                            @* Branch Dropdown: Added form-group *@
                            <div class="col-md-4 mb-3 form-group">
                                <label asp-for="User.BranchId" class="form-label">Branch</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </span>
                                    <select asp-for="User.BranchId" asp-items="Model.BranchesList" class="form-select">
                                        <option value="">-- Select Branch --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="User.BranchId" class="text-danger"></span>
                            </div>

                            @* Department Dropdown: Added form-group *@
                            <div class="col-md-4 mb-3 form-group">
                                <label asp-for="User.DepartmentId" class="form-label">Department</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;">
                                        <i class="fas fa-sitemap"></i>
                                    </span>
                                    <select asp-for="User.DepartmentId" asp-items="Model.DepartmentsList" required class="form-select">
                                        <option value="">-- Select Department --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="User.DepartmentId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-power-off me-2"></i> Status
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="User.IsActive" id="statusSwitch" checked>
                            <label class="form-check-label" asp-for="User.IsActive">Active</label>
                        </div>
                        <span asp-validation-for="User.IsActive" class="text-danger"></span>
                    </div>
                </div>

                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    A temporary password will be generated and sent to the user's email.
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="@Url.Action("Index", "Users", new { area = "UserManagement" })" class="btn btn-light text-primary">
                        <i class="fas fa-arrow-left me-1"></i> Back to List
                    </a>
                    <button type="submit" class="btn" style="background-color: #092963; color: white;">
                        <i class="fas fa-save me-1"></i> Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}