@* This partial defines the modal structures and JavaScript logic for Suppliers. *@

<div class="modal fade" id="supplierEditModal" tabindex="-1" aria-labelledby="supplierEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="supplierEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Supplier
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="supplierEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="supplierDetailsModal" tabindex="-1" aria-labelledby="supplierDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="supplierDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Supplier Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="supplierDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="supplierDeleteModal" tabindex="-1" aria-labelledby="supplierDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="supplierDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Supplier: <span id="deleteModalSupplierName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete supplier <strong id="deleteModalSupplierNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="supplierDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Supplier Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachSupplierEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('supplierEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleSupplierEditFormSubmit);
                editForm.addEventListener('submit', handleSupplierEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #supplierEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for supplier form.");
                }
            } else {
                console.warn("#supplierEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Supplier Edit form submission (AJAX) ---
        async function handleSupplierEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for supplier form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const supplierEditModalBodyElement = document.getElementById('supplierEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const supplierEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('supplierEditModal'));
                        if (supplierEditModalInstance) {
                            supplierEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Supplier updated successfully!");
                        } else {
                            console.log("Supplier update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Supplier update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const supplierEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('supplierEditModal'));
                        if (supplierEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                supplierEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    supplierEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Supplier validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachSupplierEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during supplier form submission:', error);
                const supplierEditModalBodyElement = document.getElementById('supplierEditModalBody');
                if (supplierEditModalBodyElement) {
                     supplierEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Supplier Delete form submission (AJAX) ---
        async function handleSupplierDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete supplier with an error.");
                    } else {
                        console.error("Supplier delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Supplier deleted successfully!");
                    } else {
                        console.log("Supplier deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete supplier.");
                    } else {
                        console.error("Supplier delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during supplier delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during supplier deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during supplier deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Supplier Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Supplier"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Supplier', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('supplierEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('supplierEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachSupplierEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Supplier Modal Opener
        document.querySelectorAll('.details-btn[data-page="Supplier"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Supplier', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('supplierDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('supplierDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Supplier Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Supplier"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const supplierName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Supplier', 'Delete', id);

                document.getElementById('deleteModalSupplierName').textContent = supplierName;
                document.getElementById('deleteModalSupplierNameConfirm').textContent = supplierName;

                const deleteForm = document.getElementById('supplierDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleSupplierDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleSupplierDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('supplierDeleteModal')).show();
            });
        });
    });
</script>