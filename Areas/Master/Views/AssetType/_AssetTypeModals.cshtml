@* This partial defines the modal structures and contains the JavaScript logic for them. *@

<div class="modal fade" id="assetTypeEditModal" tabindex="-1" aria-labelledby="assetTypeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="assetTypeEditModalLabel">
                    <i class="fas fa-edit me-2"></i> Edit AssetType
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="assetTypeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="assetTypeDetailsModal" tabindex="-1" aria-labelledby="assetTypeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="assetTypeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> AssetType Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="assetTypeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="assetTypeDeleteModal" tabindex="-1" aria-labelledby="assetTypeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="assetTypeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete AssetType: <span id="deleteModalAssetTypeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete assetType <strong id="deleteModalAssetTypeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="assetTypeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- Function to attach/re-attach form submission handler for the AssetType Edit modal ---
        function attachAssetTypeEditFormSubmissionHandler() {
            const editForm = document.getElementById('assetTypeEditForm'); // Target the assetType edit form
            if (editForm) {
                // Ensure no duplicate listeners by removing any existing ones
                editForm.removeEventListener('submit', handleAssetTypeEditFormSubmit);
                editForm.addEventListener('submit', handleAssetTypeEditFormSubmit);

                // Re-parse client-side validation for dynamically loaded content
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #assetTypeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for assetType form.");
                }
            } else {
                console.warn("#assetTypeEditForm not found when trying to attach handler.");
            }
        }

        // --- Handler for the AssetType Edit form submission (AJAX) ---
        async function handleAssetTypeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for assetType form. Not sending AJAX request.");
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type"); // Get content type to distinguish JSON/HTML
                const assetTypeEditModalBodyElement = document.getElementById('assetTypeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    // This is a JSON response (success or specific error)
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        // Success: close modal, show message, reload page
                        const assetTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('assetTypeEditModal'));
                        if (assetTypeEditModalInstance) {
                            assetTypeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') { // Check if Toastr is available
                            toastr.success(jsonResponse.message || "AssetType updated successfully!");
                        } else {
                            console.log("AssetType update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload(); // Reload to reflect changes
                    } else {
                        // JSON error: show message, keep modal open or close based on error type
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("AssetType update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        // For critical errors (e.g., assetType not found), you might want to close the modal
                        const assetTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('assetTypeEditModal'));
                        if (assetTypeEditModalInstance) {
                            assetTypeEditModalInstance.hide(); // Hide for critical errors
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    assetTypeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("AssetType validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    setTimeout(attachAssetTypeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during assetType form submission:', error);
                assetTypeEditModalBodyElement.innerHTML = `
                    <div class="alert alert-danger" role="alert">
                        A network or unexpected error occurred. Please check your connection and try again.
                    </div>
                `;
            }
        }

        // --- Handler for AssetType Delete form submission (AJAX) ---
        async function handleAssetTypeDeleteFormSubmit(event) {
            event.preventDefault(); // Stop default form submission
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                // Assuming delete always returns JSON from the controller
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    // Success: close modal, show message, reload page
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "AssetType deleted successfully!");
                    } else {
                        console.log("AssetType deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload(); // Reload page to reflect deletion
                } else {
                    // Error: show message
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete assetType.");
                    } else {
                        console.error("AssetType delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during assetType delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during assetType deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during assetType deletion. Please try again.");
                }
            }
        }


        // --- AssetType Modal Openers ---

        // Edit AssetType Modal Opener
        document.querySelectorAll('.edit-btn[data-page="AssetType"]').forEach(function (button) {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'AssetType', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('assetTypeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('assetTypeEditModal')).show();
                    setTimeout(attachAssetTypeEditFormSubmissionHandler, 50);
                } catch (error) {
                    console.error('Error loading assetType edit modal:', error);
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details AssetType Modal Opener
        document.querySelectorAll('.details-btn[data-page="AssetType"]').forEach(function (button) {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'AssetType', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('assetTypeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('assetTypeDetailsModal')).show();
                } catch (error) {
                    console.error('Error loading assetType details modal:', error);
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete AssetType Modal Opener
        document.querySelectorAll('.delete-btn').forEach(function (button) {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const area = this.getAttribute('data-area');
                const page = this.getAttribute('data-page');
                const assetTypeName = this.getAttribute('data-name'); // Corrected data attribute name, matches Razor now

                const url = getUrl(area, page, 'Delete', id);

                // If you want to display the assetType name in the delete confirmation modal
                const deleteModalTypeNameSpan = document.getElementById('deleteModalTypeName');
                if (deleteModalTypeNameSpan) {
                    deleteModalTypeNameSpan.textContent = assetTypeName;
                }
                const deleteModalTypeNameConfirmSpan = document.getElementById('deleteModalTypeNameConfirm');
                if (deleteModalTypeNameConfirmSpan) {
                    deleteModalTypeNameConfirmSpan.textContent = assetTypeName;
                }

                document.getElementById('assetTypeDeleteForm').setAttribute('action', url);
                new bootstrap.Modal(document.getElementById('assetTypeDeleteModal')).show();
            });
        });
    }); // End DOMContentLoaded
</script>