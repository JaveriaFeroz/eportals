@* This partial defines the modal structures and JavaScript logic for SeparationTypes. *@

<div class="modal fade" id="separationTypeEditModal" tabindex="-1" aria-labelledby="separationTypeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="separationTypeEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Separation Type
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="separationTypeEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="separationTypeDetailsModal" tabindex="-1" aria-labelledby="separationTypeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="separationTypeDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Separation Type Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="separationTypeDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="separationTypeDeleteModal" tabindex="-1" aria-labelledby="separationTypeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="separationTypeDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Separation Type: <span id="deleteModalSeparationTypeName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete separationType <strong id="deleteModalSeparationTypeNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="separationTypeDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the SeparationType Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachSeparationTypeEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('separationTypeEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleSeparationTypeEditFormSubmit);
                editForm.addEventListener('submit', handleSeparationTypeEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #separationTypeEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for separationType form.");
                }
            } else {
                console.warn("#separationTypeEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the SeparationType Edit form submission (AJAX) ---
        async function handleSeparationTypeEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for separationType form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const separationTypeEditModalBodyElement = document.getElementById('separationTypeEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const separationTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('separationTypeEditModal'));
                        if (separationTypeEditModalInstance) {
                            separationTypeEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "SeparationType updated successfully!");
                        } else {
                            console.log("SeparationType update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("SeparationType update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const separationTypeEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('separationTypeEditModal'));
                        if (separationTypeEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                separationTypeEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    separationTypeEditModalBodyElement.innerHTML = responseHtml;
                    console.log("SeparationType validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachSeparationTypeEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during separationType form submission:', error);
                const separationTypeEditModalBodyElement = document.getElementById('separationTypeEditModalBody');
                if (separationTypeEditModalBodyElement) {
                     separationTypeEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for SeparationType Delete form submission (AJAX) ---
        async function handleSeparationTypeDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete separationType with an error.");
                    } else {
                        console.error("SeparationType delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "SeparationType deleted successfully!");
                    } else {
                        console.log("SeparationType deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete separationType.");
                    } else {
                        console.error("SeparationType delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during separationType delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during separationType deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during separationType deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit SeparationType Modal Opener
        document.querySelectorAll('.edit-btn[data-page="SeparationType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'SeparationType', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('separationTypeEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('separationTypeEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachSeparationTypeEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details SeparationType Modal Opener
        document.querySelectorAll('.details-btn[data-page="SeparationType"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'SeparationType', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('separationTypeDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('separationTypeDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete SeparationType Modal Opener
        document.querySelectorAll('.delete-btn[data-page="SeparationType"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const separationTypeName = this.getAttribute('data-name');
                const url = getUrl('Master', 'SeparationType', 'Delete', id);

                document.getElementById('deleteModalSeparationTypeName').textContent = separationTypeName;
                document.getElementById('deleteModalSeparationTypeNameConfirm').textContent = separationTypeName;

                const deleteForm = document.getElementById('separationTypeDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleSeparationTypeDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleSeparationTypeDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('separationTypeDeleteModal')).show();
            });
        });
    });
</script>