@model IEnumerable<ProcureToPay.Areas.Procurement.Models.PurchaseRequest>

@{
    ViewData["Title"] = "Purchase Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Retrieve current user info from ViewBag
    var currentUserId = (int)ViewBag.CurrentUserId;
    var currentUserName = (string)ViewBag.CurrentUserName;
}
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/scripts.js" asp-append-version="true"></script>

<style>
    /* Ensure action buttons are always visible */
    .action-btn {
        opacity: 1 !important;
        visibility: visible !important;
    }
</style>

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-file-invoice me-2"></i> Purchase Request Management
            </h5>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="search-container mb-3">
                <div class="row g-3 align-items-center">
                    <div class="col-3">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-filter"></i></span>
                            <input type="text" class="form-control form-control-sm underline-input" id="requestNumberSearch"
                                   placeholder="Request Number">
                        </div>
                    </div>

                    <div class="col-2">
                        <select class="form-select form-select-sm underline-input" id="statusSearch">
                            <option value="">All Statuses</option>
                            <option value="1">Saved</option>
                            <option value="2">Submit For Review</option>
                            <option value="3">Approved</option>
                            <option value="4">Rejected</option>
                            <option value="5">Returned</option>
                            <option value="10001">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-1">
                        <button class="btn btn-outline-secondary clear-button d-flex justify-content-between align-items-center"
                                style="padding: 0.5rem 1rem; font-size: 1rem; width: 100%; min-width: 120px;">
                            <span>Clear</span>
                            <i class="fas fa-times" style="font-size: 1rem;"></i>
                        </button>
                    </div>
                    <div class="col-auto ms-auto">
                        <div class="create-user-container">
                            <button class="action-button create-user-text"
                                    data-url="@Url.Action("Create", "PurchaseRequest", new { area = "Procurement" })"
                                    style="background-color: #092963;" require-permission="Add">
                                <i class="fas fa-plus"></i>
                                <span class="button-text"> Create New Request</span>
                            </button>
                            <a href="#" class="btn btn-sm create-user-icon">
                                <i class="fas fa-plus"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row fw-bold bg-light border-bottom py-3 px-2 text-secondary d-none d-md-flex">
                <div class="col-md-2 d-flex align-items-center"><i class="fas fa-hashtag text-dark me-2"></i>REQUEST NUMBER</div>
                <div class="col-md-2 d-flex align-items-center"><i class="fas fa-calendar-alt text-dark me-2"></i>REQUEST DATE</div>
                <div class="col-md-1 d-flex align-items-center"><i class="fas fa-calendar-alt text-dark me-2"></i>REQUIRED DATE</div>
                <div class="col-md-2 d-flex align-items-center"><i class="fas fa-building text-dark me-2"></i>DEPARTMENT</div>
                <div class="col-md-2 d-flex align-items-center"><i class="fas fa-code-branch text-dark me-2"></i>BRANCH</div>
                <div class="col-md-2 d-flex align-items-center justify-content-center"><i class="fas fa-info-circle text-dark me-2"></i>STATE</div>
                <div class="col-md-1 d-flex align-items-center"><i class="fas fa-user text-dark me-2"></i>CURRENT OWNER</div>
            </div>

            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="row align-items-center border-bottom py-3 px-2 user-row" tabindex="0">
                        <div class="col-12 col-md-2" data-column-value="requestNumber" >
                            <strong class="fw-bold">
                                <a href="@Url.Action("Details", "PurchaseRequest", new { area = "Procurement", id = item.Id })" class="text-decoration-none" @* target="_blank" *@>
                                    @item.RequestNumber
                                </a>
                            </strong>
                        </div>
                        <div class="col-6 col-md-2">@item.RequestDate.ToString("dd MMM yyyy")</div>
                        <div class="col-6 col-md-1">@(item.RequiredDate?.ToString("dd MMM yyyy") ?? "Not specified")</div>
                        <div class="col-6 col-md-2">@item.Department?.DepartmentName</div>
                        <div class="col-6 col-md-2">@item.Branch?.BranchName</div>
                        <div class="col-6 col-md-2 text-md-center" data-column-value="status">
                            @{
                                string statusBadgeClass = "";
                                string statusText = "";
                                switch (item.StateId)
                                {
                                    case 1:
                                        statusBadgeClass = "bg-secondary";
                                        statusText = "Saved";
                                        break;
                                    case 2:
                                        statusBadgeClass = "bg-warning";
                                        statusText = "Submit For Review";
                                        break;
                                    case 3:
                                        statusBadgeClass = "bg-success";
                                        statusText = "Approved";
                                        break;
                                    case 4:
                                        statusBadgeClass = "bg-danger";
                                        statusText = "Rejected";
                                        break;
                                    case 5:
                                        statusBadgeClass = "bg-info";
                                        statusText = "Returned";
                                        break;
                                    case 10001:
                                        statusBadgeClass = "bg-dark";
                                        statusText = "Cancelled";
                                        break;
                                    default:
                                        statusBadgeClass = "bg-light text-dark";
                                        statusText = "Unknown";
                                        break;
                                }
                            }
                            <span class="badge status-badge @statusBadgeClass" data-state-id="@item.StateId">@statusText</span>
                        </div>
                        <div class="col-6 col-md-1">@item.Owner</div>
                    </div>
                }
            }
            else
            {
                <div class="row">
                    <div class="col-12 text-center text-muted py-4">
                        <i class="fas fa-inbox fa-2x mb-2"></i><br>No purchase requests found.
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const requestNumberSearch = document.getElementById('requestNumberSearch');
        const statusSearch = document.getElementById('statusSearch'); // This is your status dropdown
        const clearButton = document.querySelector('.clear-button');
        const allRows = document.querySelectorAll('.user-row');

        function filterRequests() {
            const requestNumberValue = requestNumberSearch.value.trim().toLowerCase();
            const statusValue = statusSearch.value; // Get the selected status value
            let foundMatch = false;

            allRows.forEach(row => {
                const rowRequestNumber = row.querySelector('[data-column-value="requestNumber"]').textContent.trim().toLowerCase();
                const rowStatusId = row.querySelector('.status-badge').getAttribute('data-state-id'); // Read the status ID from the data attribute

                const numberMatch = requestNumberValue === '' || rowRequestNumber.includes(requestNumberValue);
                const statusMatch = statusValue === '' || rowStatusId === statusValue; // Filter based on the status ID

                if (numberMatch && statusMatch) {
                    row.style.display = '';
                    foundMatch = true;
                } else {
                    row.style.display = 'none';
                }
            });

            // Show or hide the "No results" message
            const noResultsRow = document.querySelector('.card-body .row .col-12.text-center');
            if (noResultsRow) {
                noResultsRow.style.display = foundMatch ? 'none' : 'block';
            }
        }

        // Add event listeners for filtering
        requestNumberSearch.addEventListener('input', filterRequests);
        statusSearch.addEventListener('change', filterRequests);

        // Add event listener for the clear button
        clearButton.addEventListener('click', function () {
            requestNumberSearch.value = '';
            statusSearch.value = '';
            filterRequests(); // Re-run the filter to show all rows
        });

        // Initial check on page load to display all records
        filterRequests();
    });
</script>