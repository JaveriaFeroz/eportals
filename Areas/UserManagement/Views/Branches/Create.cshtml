@model ProcureToPay.Areas.UserManagement.Models.Branch
@{
    ViewData["Title"] = "Create Branch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-code-branch me-2"></i> Create New Branch
            </h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Create" asp-controller="Branches" asp-area="UserManagement">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-map-marker-alt me-2"></i> Branch Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="BranchName" class="form-label">Branch Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-building"></i></span>
                                    <input id="BranchName" asp-for="BranchName" class="form-control" placeholder="Enter branch name" required />
                                </div>
                                <span asp-validation-for="BranchName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="BranchCode" class="form-label">Branch Code <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-code"></i></span>
                                    <input id="BranchCode" asp-for="BranchCode" class="form-control" placeholder="Enter branch code" required />
                                </div>
                                <span asp-validation-for="BranchCode" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-power-off me-2"></i> Status
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch">
                            <input id="IsActive" asp-for="IsActive" type="checkbox" class="form-check-input" value="true" checked />
                            <label class="form-check-label" for="IsActive">Active</label>
                            @* The hidden input is for when the checkbox is unchecked, ensuring 'false' is sent to the server *@
                            <input type="hidden" asp-for="IsActive" value="false" />
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn" style="background-color: #092963; color: white;">
                        <i class="fas fa-save me-1"></i> Create Branch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}