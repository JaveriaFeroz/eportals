@{
    // Cast the ViewBag property to your User entity type (assuming 'User' is the class name)
    var user = ViewBag.CurrentUser;

    var currentHour = DateTime.Now.Hour;
    string greetingText = currentHour < 12 ? "Good Morning" :
                         (currentHour < 18 ? "Good Afternoon" : "Good Evening");

    // FIX: Safely access properties of the user object to build the full name.
    string userFullName = (user != null)
        ? $"{(user.FirstName ?? "")} {(user.LastName ?? "")}".Trim()
        : (User.Identity?.Name?.Split('@').FirstOrDefault() ?? "User");
}
<!-- Top Navigation Bar with Greeting -->
<div class="top-nav w-100">
    <div class="greeting-container">
        <div>
            <div class="greeting-name">@greetingText, @userFullName</div>
            <div class="greeting-text">Welcome to your ePortal</div>
            <div class="greeting-subtitle">Progressive Report</div>
        </div>
        <div class="d-flex align-items-center gap-4 flex-wrap">
            <div class="d-flex align-items-center gap-2">
                <a asp-area="Reports" asp-controller="Reports" asp-action="Index" class="btn d-flex align-items-center gap-2"
                   style="background-color: #092963; color: white; border-color: #092963;">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <span>Reports</span>
                </a>
            </div>
            <div class="date-display d-flex align-items-center gap-2">
                <i class="bi bi-calendar3"></i>
                <span>Today, @DateTime.Now.ToString("dd MMM")</span>
            </div>
            <div class="time-display">
                @DateTime.Now.ToString("HH:mm")
            </div>
            @* <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-light d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-arrow-down"></i> <span class="d-none d-sm-inline">Export</span>
                </button>
            </div> *@
        </div>
    </div>
</div>