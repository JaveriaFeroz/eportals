@* This partial defines the modal structures and JavaScript logic for ShipperCategories. *@

<div class="modal fade" id="shipperCategoryEditModal" tabindex="-1" aria-labelledby="shipperCategoryEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="shipperCategoryEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Shipper
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="shipperCategoryEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="shipperCategoryDetailsModal" tabindex="-1" aria-labelledby="shipperCategoryDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="shipperCategoryDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Shipper Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="shipperCategoryDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="shipperCategoryDeleteModal" tabindex="-1" aria-labelledby="shipperCategoryDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="shipperCategoryDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Shipper: <span id="deleteModalShipperName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete shipperCategory <strong id="deleteModalShipperNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="shipperCategoryDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Shipper Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachShipperEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('shippersEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleShipperEditFormSubmit);
                editForm.addEventListener('submit', handleShipperEditFormSubmit);

                // Re-parse shipperCategory-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Shipper-side validation re-parsed for #shippersEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Shipper-side validation may not work for shipperCategory form.");
                }
            } else {
                console.warn("#shippersEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Shipper Edit form submission (AJAX) ---
        async function handleShipperEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform shipperCategory-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Shipper-side validation failed for shipperCategory form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const shipperCategoryEditModalBodyElement = document.getElementById('shipperCategoryEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const shipperCategoryEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('shipperCategoryEditModal'));
                        if (shipperCategoryEditModalInstance) {
                            shipperCategoryEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Shipper updated successfully!");
                        } else {
                            console.log("Shipper update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Shipper update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const shipperCategoryEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('shipperCategoryEditModal'));
                        if (shipperCategoryEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                shipperCategoryEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    shipperCategoryEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Shipper validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachShipperEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during shipperCategory form submission:', error);
                const shipperCategoryEditModalBodyElement = document.getElementById('shipperCategoryEditModalBody');
                if (shipperCategoryEditModalBodyElement) {
                     shipperCategoryEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Shipper Delete form submission (AJAX) ---
        async function handleShipperDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete shipperCategory with an error.");
                    } else {
                        console.error("Shipper delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Shipper deleted successfully!");
                    } else {
                        console.log("Shipper deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete shipperCategory.");
                    } else {
                        console.error("Shipper delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during shipperCategory delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during shipperCategory deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during shipperCategory deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Shipper Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Shipper"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Shipper', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('shipperCategoryEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('shipperCategoryEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachShipperEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Shipper Modal Opener
        document.querySelectorAll('.details-btn[data-page="Shipper"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Shipper', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('shipperCategoryDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('shipperCategoryDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Shipper Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Shipper"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const shipperCategoryName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Shipper', 'Delete', id);

                document.getElementById('deleteModalShipperName').textContent = shipperCategoryName;
                document.getElementById('deleteModalShipperNameConfirm').textContent = shipperCategoryName;

                const deleteForm = document.getElementById('shipperCategoryDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleShipperDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleShipperDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('shipperCategoryDeleteModal')).show();
            });
        });
    });
</script>