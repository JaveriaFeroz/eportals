@* This partial defines the modal structures and JavaScript logic for SubNatures. *@

<div class="modal fade" id="subNatureEditModal" tabindex="-1" aria-labelledby="subNatureEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="subNatureEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit SubNature
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="subNatureEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="subNatureDetailsModal" tabindex="-1" aria-labelledby="subNatureDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="subNatureDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> SubNature Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="subNatureDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="subNatureDeleteModal" tabindex="-1" aria-labelledby="subNatureDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="subNatureDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete SubNature: <span id="deleteModalSubNatureName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete subNature <strong id="deleteModalSubNatureNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="subNatureDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the SubNature Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachSubNatureEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('subNatureEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleSubNatureEditFormSubmit);
                editForm.addEventListener('submit', handleSubNatureEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #subNatureEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for subNature form.");
                }
            } else {
                console.warn("#subNatureEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the SubNature Edit form submission (AJAX) ---
        async function handleSubNatureEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for subNature form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const subNatureEditModalBodyElement = document.getElementById('subNatureEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const subNatureEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('subNatureEditModal'));
                        if (subNatureEditModalInstance) {
                            subNatureEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "SubNature updated successfully!");
                        } else {
                            console.log("SubNature update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("SubNature update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const subNatureEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('subNatureEditModal'));
                        if (subNatureEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                subNatureEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    subNatureEditModalBodyElement.innerHTML = responseHtml;
                    console.log("SubNature validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachSubNatureEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during subNature form submission:', error);
                const subNatureEditModalBodyElement = document.getElementById('subNatureEditModalBody');
                if (subNatureEditModalBodyElement) {
                     subNatureEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for SubNature Delete form submission (AJAX) ---
        async function handleSubNatureDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete subNature with an error.");
                    } else {
                        console.error("SubNature delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "SubNature deleted successfully!");
                    } else {
                        console.log("SubNature deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete subNature.");
                    } else {
                        console.error("SubNature delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during subNature delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during subNature deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during subNature deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit SubNature Modal Opener
        document.querySelectorAll('.edit-btn[data-page="SubNature"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'SubNature', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('subNatureEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('subNatureEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachSubNatureEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details SubNature Modal Opener
        document.querySelectorAll('.details-btn[data-page="SubNature"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'SubNature', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('subNatureDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('subNatureDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete SubNature Modal Opener
        document.querySelectorAll('.delete-btn[data-page="SubNature"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const subNatureName = this.getAttribute('data-name');
                const url = getUrl('Master', 'SubNature', 'Delete', id);

                document.getElementById('deleteModalSubNatureName').textContent = subNatureName;
                document.getElementById('deleteModalSubNatureNameConfirm').textContent = subNatureName;

                const deleteForm = document.getElementById('subNatureDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleSubNatureDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleSubNatureDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('subNatureDeleteModal')).show();
            });
        });
    });
</script>