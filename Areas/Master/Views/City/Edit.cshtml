@model ProcureToPay.Areas.Master.ViewModels.CityCreateEditViewModel

<div class="modal-body">
    <form id="cityEditForm" method="post" asp-action="Edit" asp-controller="City" asp-area="Master"
          data-area="Master" data-controller="City">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="City.CityId" />

        <div class="mb-3">
            <label asp-for="City.CityName" class="form-label">City Name <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-city"></i></span>
                <input asp-for="City.CityName" class="form-control" />
            </div>
            <span asp-validation-for="City.CityName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="City.CityCode" class="form-label">City Code <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-hashtag"></i></span>
                <input asp-for="City.CityCode" class="form-control" />
            </div>
            <span asp-validation-for="City.CityCode" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="City.RegionId" class="form-label">Region <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-globe-americas"></i></span>
                <select asp-for="City.RegionId" asp-items="@Model.Regions" class="form-select">
                    <option value="">-- Select Region --</option>
                </select>
            </div>
            <span asp-validation-for="City.RegionId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label"><i class="fas fa-power-off me-2"></i> Status</label>
            <div class="form-check form-switch">
                <input type="hidden" asp-for="City.IsActive" value="false" />
                <input asp-for="City.IsActive" type="checkbox" class="form-check-input" value="true" />
                <label asp-for="City.IsActive" class="form-check-label">Active</label>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn" style="background-color: #092963; color: white;">
                <i class="fas fa-save me-1" style="color: white;"></i> Save City
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}