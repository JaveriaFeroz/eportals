@model ProcureToPay.Areas.Auth.Models.AuthViewModelBase
@{
    ViewData["Title"] = "Forgot Password Confirmation";
    Layout = "_AuthLayout";
}

<div class="login-container">
    <div class="left-section">
        <div class="logo">
            <span class="logo-text">ePortal</span>
        </div>
        <h2 class="whats-new-heading">What's new</h2>
        <div class="updates-container">
            @if (Model.Updates != null && Model.Updates.Any())
            {
                @foreach (var update in Model.Updates)
                {
                    <div class="update-item">
                        <div class="update-date">@update.CreatedDate.ToString("MMMM dd, yyyy h:mm tt")</div>
                        <div class="update-title">@update.Title</div>
                        <div class="update-content">
                            @if (update.Content.Length > 150)
                            {
                                @(update.Content.Substring(0, 150))

                            }
                            else
                            {
                                @update.Content
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="update-item">
                    <div class="update-date">@DateTime.Now.ToString("MMMM dd, yyyy h:mm tt")</div>
                    <div class="update-title">Welcome to ePortal</div>
                    <div class="update-content">No updates available at this time. Check back soon for the latest news and features!</div>
                </div>
            }
        </div>
    </div>
    <div class="right-section">
        <div class="login-area">
            <h1>@ViewData["Title"]</h1>
            <p>
                If a matching account was found, a password reset email has been sent to your email address.
                Please check your inbox and spam folder.
            </p>

            <a href="@Url.Action("Login", "Account", new { area = "Auth" })" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to Login
            </a>
        </div>
    </div>
</div>