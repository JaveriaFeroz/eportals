@model ProcureToPay.Areas.Master.ViewModels.ProductIndexViewModel

@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/scripts.js" asp-append-version="true"></script>

<div class="container-fluid px-4 py-4">

    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-boxes me-2"></i> Products Management
            </h5>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="search-container mb-3">
                <div class="row g-3 align-items-center">
                    <div class="col-md-2">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-filter"></i></span>
                            <input type="text" class="form-control form-control-sm underline-input" id="productSearch"
                                   placeholder="Product Name" data-filter="productName">
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-filter"></i></span>
                            <select class="form-select form-select-sm underline-input" id="natureSearch" data-filter="nature">
                                <option value="">All Natures</option>
                                @{
                                    var uniqueNatures = Model.Products
                                    .Select(p => p.ProductNatureName)
                                    .Where(n => !string.IsNullOrEmpty(n))
                                    .Distinct()
                                    .OrderBy(n => n)
                                    .ToList();
                                }
                                @foreach (var natureName in uniqueNatures)
                                {
                                    <option value="@natureName">@natureName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-filter"></i></span>
                            <select class="form-select form-select-sm underline-input" id="uomSearch" data-filter="uom">
                                <option value="">All UoM</option>
                                @{
                                    var uniqueUoMs = Model.Products
                                    .Select(p => p.UoMName)
                                    .Where(u => !string.IsNullOrEmpty(u))
                                    .Distinct()
                                    .OrderBy(u => u)
                                    .ToList();
                                }
                                @foreach (var uomName in uniqueUoMs)
                                {
                                    <option value="@uomName">@uomName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-filter"></i></span>
                            <select class="form-select form-select-sm underline-input" id="statusSearch" data-filter="status">
                                <option value="">All</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-secondary clear-button d-flex justify-content-between align-items-center"
                                style="padding: 0.5rem 1rem; font-size: 1rem; width: 100%;">
                            <span>Clear</span>
                            <i class="fas fa-times" style="font-size: 1rem;"></i>
                        </button>
                    </div>

                    <div class="col-auto ms-auto">
                        <div class="create-user-container">
                            <button class="action-button create-user-text"
                                    data-url="@Url.Action("Create", "Product", new { area = "Master" })"
                                    style="background-color: #092963;">
                                <i class="fas fa-plus"></i>
                                <span class="button-text"> Add New Product</span>
                            </button>
                            <a href="#" class="btn btn-sm create-user-icon">
                                <i class="fas fa-plus"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row fw-bold bg-light border-bottom py-3 px-2 text-secondary d-none d-md-flex">
                <div class="col-md-2 d-flex align-items-center"><i class="fas fa-box-open text-dark me-2"></i>PRODUCT NAME</div>
                <div class="col-md-1 d-flex align-items-center justify-content-center"><i class="fas fa-money-bill-wave text-dark me-2"></i>PRICE</div>
                <div class="col-md-2 d-flex align-items-center"><i class="fas fa-leaf text-dark me-2"></i>PRODUCT NATURE</div>
                <div class="col-md-1 d-flex align-items-center justify-content-center"><i class="fas fa-balance-scale text-dark me-2"></i>UoM</div>
                <div class="col-md-2 d-flex align-items-center"><i class="fas fa-user-clock text-dark me-2"></i>CREATED</div>
                <div class="col-md-2 d-flex align-items-center"><i class="fas fa-history text-dark me-2"></i>UPDATED</div>
                <div class="col-md-1 d-flex align-items-center justify-content-center"><i class="fas fa-toggle-on text-dark me-2"></i>STATUS</div>
                <div class="col-md-1 text-center d-flex align-items-center justify-content-center"><i class="fas fa-cogs text-dark me-2"></i>ACTIONS</div>
            </div>

            @if (Model.Products.Any())
            {
                @foreach (var product in Model.Products)
                {
            <div class="row align-items-center border-bottom py-3 px-2 user-row" tabindex="0">
                <div class="col-12 col-md-2" data-column="productName"><strong class="fw-bold">@product.ProductName</strong></div>

                <div class="col-6 col-md-1 text-md-center">@product.UnitPrice.ToString("C")</div>

                <div class="col-6 col-md-2" data-column="nature">@product.ProductNatureName</div>

                <div class="col-6 col-md-1 text-md-center" data-column="uom">@product.UoMName</div>

                <div class="col-6 col-md-2 small">
                    <div title="Created by"><i class="fas fa-user-edit me-1 text-muted"></i> @product.CreatedBy</div>
                    <div title="Created on" class="text-muted"><i class="fas fa-calendar-alt me-1"></i> @product.CreatedOn.ToString("dd MMM yyyy")</div>
                </div>

                <div class="col-6 col-md-2 small">
                    <div title="Updated by"><i class="fas fa-user-edit me-1 text-muted"></i> @(product.UpdatedBy ?? "N/A")</div>
                    <div title="Updated on" class="text-muted"><i class="fas fa-calendar-alt me-1"></i> @(product.UpdatedOn?.ToString("dd MMM yyyy") ?? "N/A")</div>
                </div>

                <div class="col-6 col-md-1 text-md-center" data-column="status">
                    @if (product.IsActive)
                    {
                        <span class="badge status-badge" data-state-name="active">Active</span>
                    }
                    else
                    {
                        <span class="badge status-badge bg-danger" data-state-name="inactive">Inactive</span>
                    }
                </div>

                <div class="col-12 col-md-1 d-flex justify-content-md-center gap-1 mt-2 mt-md-0">
                    <button type="button" class="btn btn-sm text-warning edit-btn action-btn" title="Edit" data-id="@product.ProductId" data-area="Master" data-page="Product"><i class="fas fa-edit icon-warning"></i></button>
                    <button type="button" class="btn btn-sm text-info details-btn action-btn" title="Details" data-id="@product.ProductId" data-area="Master" data-page="Product"><i class="fas fa-info-circle icon-info"></i></button>
                </div>
            </div>
                        }
                        }
                        else
            {
                <div class="row"><div class="col-12 text-center text-muted py-4"><i class="fas fa-inbox fa-2x mb-2"></i><br>No products found.</div></div>
            }
        </div>
        @await Html.PartialAsync("_ProductModals")
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // 1. Get all search/filter elements
        const productSearch = document.getElementById('productSearch');
        const natureSearch = document.getElementById('natureSearch');
        const uomSearch = document.getElementById('uomSearch');
        const statusSearch = document.getElementById('statusSearch');
        const clearButton = document.querySelector('.clear-button');
        const rows = document.querySelectorAll('.product-row'); // Select all product rows

        // 2. Define the filtering function
        function filterRows() {
            // Get values from input/select fields and convert to lowercase for case-insensitive comparison
            const productNameValue = productSearch.value.toLowerCase().trim();
            const natureValue = natureSearch.value.toLowerCase().trim();
            const uomValue = uomSearch.value.toLowerCase().trim();
            const statusValue = statusSearch.value.toLowerCase().trim();

            rows.forEach(row => {
                // Get text content from corresponding data columns/attributes
                const productNameText = row.querySelector('[data-column-value="productName"]').textContent.trim().toLowerCase();
                const natureText = row.querySelector('[data-column-value="nature"]').textContent.trim().toLowerCase();
                const uomText = row.querySelector('[data-column-value="uom"]').textContent.trim().toLowerCase();
                const rowStatusName = row.querySelector('.status-badge').getAttribute('data-state-name');

                // Check for matches
                const productNameMatch = productNameValue === '' || productNameText.includes(productNameValue);
                const natureMatch = natureValue === '' || natureText.includes(natureValue);
                const uomMatch = uomValue === '' || uomText.includes(uomValue);
                const statusMatch = statusValue === '' || rowStatusName === statusValue;

                // Show/hide the row based on all matches
                if (productNameMatch && natureMatch && uomMatch && statusMatch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // 3. Attach event listeners
        productSearch.addEventListener('input', filterRows);
        natureSearch.addEventListener('change', filterRows);
        uomSearch.addEventListener('change', filterRows);
        statusSearch.addEventListener('change', filterRows);

        // 4. Clear button functionality
        clearButton.addEventListener('click', function () {
            productSearch.value = '';
            natureSearch.value = '';
            uomSearch.value = '';
            statusSearch.value = '';
            filterRows(); // Re-filter to show all rows
        });

        // 5. Initial filter (important if the model data changes or for consistency)
        filterRows();
    });
</script>