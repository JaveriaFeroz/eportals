@model ProcureToPay.Areas.Master.ViewModels.CityCreateEditViewModel
@{
    ViewData["Title"] = "Create City";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header" style="background-color: #092963;">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-plus me-2"></i> Create New City
            </h5>
        </div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post" action="@Url.Action("Create", "City", new { area = "Master" })">
                @Html.AntiForgeryToken()

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold" style="color: #092963;">
                            <i class="fas fa-info-circle me-2"></i> City Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="City.CityName" class="form-label">City Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;">
                                        <i class="fas fa-city"></i>
                                    </span>
                                    <input type="text"
                                           id="cityNameInput"
                                           name="City.CityName"
                                           class="form-control"
                                           placeholder="Enter city name"
                                           value="@Model?.City.CityName"
                                           required />
                                </div>
                                <span asp-validation-for="City.CityName" class="text-danger"></span>
                                <div id="cityNameError" class="text-danger" style="display: none;"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="City.CityCode" class="form-label">City Code <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;">
                                        <i class="fas fa-hashtag"></i>
                                    </span>
                                    <input type="text"
                                           id="cityCodeInput"
                                           name="City.CityCode"
                                           class="form-control"
                                           placeholder="Enter city code"
                                           value="@Model?.City.CityCode"
                                           required />
                                </div>
                                <span asp-validation-for="City.CityCode" class="text-danger"></span>
                                <div id="cityCodeError" class="text-danger" style="display: none;"></div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="City.RegionId" class="form-label">Region <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background-color: #092963; color: white;"><i class="fas fa-map-marker-alt"></i></span>
                                    <select asp-for="City.RegionId" asp-items="@Model.Regions" class="form-select">
                                        <option value="">-- Select Region --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="City.RegionId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn" style="background-color: #092963; color: white;" id="submitBtn">
                        <i class="fas fa-save me-1"></i> Create City
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}