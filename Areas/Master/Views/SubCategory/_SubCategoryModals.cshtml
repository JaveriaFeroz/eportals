@* This partial defines the modal structures and JavaScript logic for SubCategorys. *@

<div class="modal fade" id="subCategoryEditModal" tabindex="-1" aria-labelledby="subCategoryEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="subCategoryEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit SubCategory
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="subCategoryEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="subCategoryDetailsModal" tabindex="-1" aria-labelledby="subCategoryDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="subCategoryDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> SubCategory Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="subCategoryDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="subCategoryDeleteModal" tabindex="-1" aria-labelledby="subCategoryDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="subCategoryDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete SubCategory: <span id="deleteModalSubCategoryName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete subCategory <strong id="deleteModalSubCategoryNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="subCategoryDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the SubCategory Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachSubCategoryEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('subCategoryEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleSubCategoryEditFormSubmit);
                editForm.addEventListener('submit', handleSubCategoryEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #subCategoryEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for subCategory form.");
                }
            } else {
                console.warn("#subCategoryEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the SubCategory Edit form submission (AJAX) ---
        async function handleSubCategoryEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for subCategory form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const subCategoryEditModalBodyElement = document.getElementById('subCategoryEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const subCategoryEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('subCategoryEditModal'));
                        if (subCategoryEditModalInstance) {
                            subCategoryEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "SubCategory updated successfully!");
                        } else {
                            console.log("SubCategory update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("SubCategory update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const subCategoryEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('subCategoryEditModal'));
                        if (subCategoryEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                subCategoryEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    subCategoryEditModalBodyElement.innerHTML = responseHtml;
                    console.log("SubCategory validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachSubCategoryEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during subCategory form submission:', error);
                const subCategoryEditModalBodyElement = document.getElementById('subCategoryEditModalBody');
                if (subCategoryEditModalBodyElement) {
                     subCategoryEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for SubCategory Delete form submission (AJAX) ---
        async function handleSubCategoryDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete subCategory with an error.");
                    } else {
                        console.error("SubCategory delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "SubCategory deleted successfully!");
                    } else {
                        console.log("SubCategory deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete subCategory.");
                    } else {
                        console.error("SubCategory delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during subCategory delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during subCategory deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during subCategory deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit SubCategory Modal Opener
        document.querySelectorAll('.edit-btn[data-page="SubCategory"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'SubCategory', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('subCategoryEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('subCategoryEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachSubCategoryEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details SubCategory Modal Opener
        document.querySelectorAll('.details-btn[data-page="SubCategory"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'SubCategory', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('subCategoryDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('subCategoryDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete SubCategory Modal Opener
        document.querySelectorAll('.delete-btn[data-page="SubCategory"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const subCategoryName = this.getAttribute('data-name');
                const url = getUrl('Master', 'SubCategory', 'Delete', id);

                document.getElementById('deleteModalSubCategoryName').textContent = subCategoryName;
                document.getElementById('deleteModalSubCategoryNameConfirm').textContent = subCategoryName;

                const deleteForm = document.getElementById('subCategoryDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleSubCategoryDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleSubCategoryDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('subCategoryDeleteModal')).show();
            });
        });
    });
</script>