@* This partial defines the modal structures and JavaScript logic for Trailers. *@

<div class="modal fade" id="TrailerEditModal" tabindex="-1" aria-labelledby="TrailerEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="TrailerEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Trailer
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="TrailerEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="TrailerDetailsModal" tabindex="-1" aria-labelledby="TrailerDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="TrailerDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Trailer Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="TrailerDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="TrailerDeleteModal" tabindex="-1" aria-labelledby="TrailerDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="TrailerDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Trailer: <span id="deleteModalTrailerName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete Trailer <strong id="deleteModalTrailerNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="TrailerDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            if (id) {
                return `/${area}/${page}/${action}/${id}`;
            }
            return `/${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Trailer Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachTrailerEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('TrailerEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleTrailerEditFormSubmit);
                editForm.addEventListener('submit', handleTrailerEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #TrailerEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for Trailer form.");
                }
            } else {
                console.warn("#TrailerEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Trailer Edit form submission (AJAX) ---
        async function handleTrailerEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for Trailer form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const TrailerEditModalBodyElement = document.getElementById('TrailerEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const TrailerEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('TrailerEditModal'));
                        if (TrailerEditModalInstance) {
                            TrailerEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Trailer updated successfully!");
                        } else {
                            console.log("Trailer update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Trailer update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const TrailerEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('TrailerEditModal'));
                        if (TrailerEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                TrailerEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    TrailerEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Trailer validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachTrailerEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during Trailer form submission:', error);
                const TrailerEditModalBodyElement = document.getElementById('TrailerEditModalBody');
                if (TrailerEditModalBodyElement) {
                     TrailerEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Trailer Delete form submission (AJAX) ---
        async function handleTrailerDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete Trailer with an error.");
                    } else {
                        console.error("Trailer delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Trailer deleted successfully!");
                    } else {
                        console.log("Trailer deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete Trailer.");
                    } else {
                        console.error("Trailer delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during Trailer delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during Trailer deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during Trailer deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Trailer Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Trailer"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Trailer', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('TrailerEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('TrailerEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachTrailerEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Trailer Modal Opener
        document.querySelectorAll('.details-btn[data-page="Trailer"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Trailer', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('TrailerDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('TrailerDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Trailer Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Trailer"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const TrailerName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Trailer', 'Delete', id);

                document.getElementById('deleteModalTrailerName').textContent = TrailerName;
                document.getElementById('deleteModalTrailerNameConfirm').textContent = TrailerName;

                const deleteForm = document.getElementById('TrailerDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleTrailerDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleTrailerDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('TrailerDeleteModal')).show();
            });
        });
    });
</script>