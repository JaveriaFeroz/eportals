@using ProcureToPay.Areas.UserManagement.Models
@model Update
@{
    ViewData["Title"] = "Create Update";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary py-3">
            <h5 class="card-title text-white mb-0">
                <i class="fas fa-bullhorn me-2"></i> Create New Update
            </h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Create" asp-controller="Updates" asp-area="UserManagement">
                @Html.AntiForgeryToken()

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="fas fa-info-circle me-2"></i> Update Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="Title" class="form-label">Title <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-primary text-white"><i class="fas fa-heading"></i></span>
                                <input id="Title" name="Title" asp-for="Title" class="form-control" placeholder="Enter update title" required />
                            </div>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label for="Content" class="form-label">Content</label>
                            <textarea id="Content" name="Content" asp-for="Content" class="form-control" rows="5" placeholder="Enter update content"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="Priority" class="form-label">Priority</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white"><i class="fas fa-sort-numeric-down"></i></span>
                                    <input id="Priority" name="Priority" asp-for="Priority" type="number" class="form-control" value="1" min="1" max="10" />
                                </div>
                                <small class="form-text text-muted">Higher numbers appear first (1-10)</small>
                                <span asp-validation-for="Priority" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="VisibleToRoles" class="form-label">Visible to Roles (optional)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white"><i class="fas fa-users"></i></span>
                                    <input id="VisibleToRoles" name="VisibleToRoles" asp-for="VisibleToRoles" class="form-control" placeholder="e.g., Admin,Manager" />
                                </div>
                                <small class="form-text text-muted">Comma-separated list of roles. Leave empty for all users.</small>
                                <span asp-validation-for="VisibleToRoles" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="fas fa-power-off me-2"></i> Status
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch">
                            <input id="IsActive" name="IsActive" asp-for="IsActive" type="checkbox" class="form-check-input" value="true" checked />
                            <label class="form-check-label" for="IsActive">Active (visible to users)</label>
                            <input type="hidden" name="IsActive" value="false" />
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="@Url.Action("Index", "Updates", new { area = "UserManagement" })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Create Update
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>