@* This partial defines the modal structures and JavaScript logic for Capacitys. *@

<div class="modal fade" id="capacityEditModal" tabindex="-1" aria-labelledby="capacityEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="capacityEditModalLabel">
                    <i class="fas fa-map-marker-alt me-2"></i> Edit Capacity
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="capacityEditModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="capacityDetailsModal" tabindex="-1" aria-labelledby="capacityDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963">
                <h5 class="modal-title text-white" id="capacityDetailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Capacity Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="capacityDetailsModalBody">
                @* Content will be loaded via AJAX here *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="capacityDeleteModal" tabindex="-1" aria-labelledby="capacityDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #092963;">
                <h5 class="modal-title text-white" id="capacityDeleteModalLabel">
                    <i class="fas fa-trash-alt me-2"></i> Delete Capacity: <span id="deleteModalCapacityName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete capacity <strong id="deleteModalCapacityNameConfirm"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="capacityDeleteForm" method="post" action="" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Helper function to build URLs
        function getUrl(area, page, action, id) {
            let baseUrl = '@Url.Content("~/")';

            if (id) {
                return `${baseUrl}${area}/${page}/${action}/${id}`;
            }
            return `${baseUrl}${area}/${page}/${action}`;
        }

        // --- GLOBALIZED FUNCTION: to attach/re-attach form submission handler for the Capacity Edit modal ---
        // This function should be accessible globally or from where it's needed after AJAX content loads.
        // It's crucial it's not redefined every time it's called.
        window.attachCapacityEditFormSubmissionHandler = function() { // Made global by attaching to window
            const editForm = document.getElementById('capacityEditForm');
            if (editForm) {
                editForm.removeEventListener('submit', handleCapacityEditFormSubmit);
                editForm.addEventListener('submit', handleCapacityEditFormSubmit);

                // Re-parse client-side validation
                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    jQuery(editForm).removeData("validator");
                    jQuery(editForm).removeData("unobtrusiveValidation");
                    jQuery.validator.unobtrusive.parse(editForm);
                    console.log("Client-side validation re-parsed for #capacityEditForm.");
                } else {
                    console.warn("jQuery or Unobtrusive Validation not fully loaded. Client-side validation may not work for capacity form.");
                }
            } else {
                console.warn("#capacityEditForm not found when trying to attach handler.");
            }
        };


        // --- Handler for the Capacity Edit form submission (AJAX) ---
        async function handleCapacityEditFormSubmit(event) {
            event.preventDefault(); // Stop default browser navigation

            const form = event.target;

            // Perform client-side validation
            if (window.jQuery && window.jQuery.validator && !jQuery(form).valid()) {
                console.log("Client-side validation failed for capacity form. Not sending AJAX request.");
                // Display validation errors on the form if not already visible
                return;
            }

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                });

                const contentType = response.headers.get("content-type");
                const capacityEditModalBodyElement = document.getElementById('capacityEditModalBody');

                if (contentType && contentType.includes("application/json")) {
                    const jsonResponse = await response.json();
                    if (jsonResponse.success) {
                        const capacityEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('capacityEditModal'));
                        if (capacityEditModalInstance) {
                            capacityEditModalInstance.hide();
                        }
                        if (typeof toastr !== 'undefined') {
                            toastr.success(jsonResponse.message || "Capacity updated successfully!");
                        } else {
                            console.log("Capacity update successful: " + (jsonResponse.message || "Operation completed."));
                        }
                        window.location.reload();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(jsonResponse.message || "An error occurred.");
                        } else {
                            console.error("Capacity update failed: " + (jsonResponse.message || "An error occurred."));
                        }
                        const capacityEditModalInstance = bootstrap.Modal.getInstance(document.getElementById('capacityEditModal'));
                        if (capacityEditModalInstance) {
                            // Only hide for critical (non-validation) errors
                            // For validation errors, we'll re-inject HTML, so don't hide
                            if (response.status >= 500) { // If it's a server error
                                capacityEditModalInstance.hide();
                            }
                        }
                    }
                } else {
                    // HTML response: likely validation errors, inject back into modal
                    const responseHtml = await response.text();
                    capacityEditModalBodyElement.innerHTML = responseHtml;
                    console.log("Capacity validation errors received. Injecting form HTML into modal body.");
                    // Re-attach handler for the new form content, after a small delay
                    // IMPORTANT: Call the globalized function
                    setTimeout(window.attachCapacityEditFormSubmissionHandler, 50);
                }

            } catch (error) {
                console.error('Network or unexpected error during capacity form submission:', error);
                const capacityEditModalBodyElement = document.getElementById('capacityEditModalBody');
                if (capacityEditModalBodyElement) {
                     capacityEditModalBodyElement.innerHTML = `
                         <div class="alert alert-danger" role="alert">
                             A network or unexpected error occurred. Please check your connection and try again.
                         </div>
                     `;
                }
                if (typeof toastr !== 'undefined') {
                    toastr.error("A network or unexpected error occurred.");
                }
            }
        }

        // --- Handler for Capacity Delete form submission (AJAX) ---
        async function handleCapacityDeleteFormSubmit(event) {
            event.preventDefault();
            const currentForm = event.target;
            const formData = new FormData(currentForm);

            try {
                const response = await fetch(currentForm.action, {
                    method: currentForm.method,
                    body: formData,
                });

                if (!response.ok) { // Handles 4xx, 5xx status codes
                    const errorJson = await response.json();
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorJson.message || "Failed to delete capacity with an error.");
                    } else {
                        console.error("Capacity delete failed: " + (errorJson.message || "An error occurred."));
                    }
                    return; // Stop here if there's a non-2xx response
                }

                const jsonResponse = await response.json();

                if (jsonResponse.success) {
                    const modalId = currentForm.closest('.modal').id;
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(jsonResponse.message || "Capacity deleted successfully!");
                    } else {
                        console.log("Capacity deleted: " + (jsonResponse.message || "Operation completed."));
                    }
                    window.location.reload();
                } else {
                    // This else block is less likely to be hit if !response.ok handles most errors.
                    // It would only be for 200 OK responses where 'success' is explicitly false in JSON.
                    if (typeof toastr !== 'undefined') {
                        toastr.error(jsonResponse.message || "Failed to delete capacity.");
                    } else {
                        console.error("Capacity delete failed: " + (jsonResponse.message || "An error occurred."));
                    }
                }
            } catch (error) {
                console.error("Network or unexpected error during capacity delete submission:", error);
                if (typeof toastr !== 'undefined') {
                    toastr.error("An unexpected error occurred during capacity deletion. Please try again.");
                } else {
                    console.error("An unexpected error occurred during capacity deletion. Please try again.");
                }
            }
        }


        // --- Modal Openers (using data-page attribute for specificity) ---

        // Edit Capacity Modal Opener
        document.querySelectorAll('.edit-btn[data-page="Capacity"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Capacity', 'Edit', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('capacityEditModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('capacityEditModal')).show();
                    // Call the globalized function to attach handler
                    setTimeout(window.attachCapacityEditFormSubmissionHandler, 50);
                } catch (error) {
                    toastr.error("Failed to load edit form.");
                }
            });
        });

        // Details Capacity Modal Opener
        document.querySelectorAll('.details-btn[data-page="Capacity"]').forEach(button => {
            button.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const url = getUrl('Master', 'Capacity', 'Details', id);
                try {
                    const response = await fetch(url);
                    document.getElementById('capacityDetailsModalBody').innerHTML = await response.text();
                    new bootstrap.Modal(document.getElementById('capacityDetailsModal')).show();
                } catch (error) {
                    toastr.error("Failed to load details.");
                }
            });
        });

        // Delete Capacity Modal Opener
        document.querySelectorAll('.delete-btn[data-page="Capacity"]').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const capacityName = this.getAttribute('data-name');
                const url = getUrl('Master', 'Capacity', 'Delete', id);

                document.getElementById('deleteModalCapacityName').textContent = capacityName;
                document.getElementById('deleteModalCapacityNameConfirm').textContent = capacityName;

                const deleteForm = document.getElementById('capacityDeleteForm');
                deleteForm.setAttribute('action', url);

                deleteForm.removeEventListener('submit', handleCapacityDeleteFormSubmit);
                deleteForm.addEventListener('submit', handleCapacityDeleteFormSubmit);

                new bootstrap.Modal(document.getElementById('capacityDeleteModal')).show();
            });
        });
    });
</script>